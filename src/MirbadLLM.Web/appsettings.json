{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MirbadLLM": {
    "//": "Defaults for the DGX Spark host. ASPNETCORE_HTTP_PORTS=8080 is set by the container, not here.",
    "VllmImage": "local/qwen38-vllm-dflash2:66e5414c6d75",
    "//MtpArchitectures": "MTP architectures registered by that image (vLLM ModelRegistry, read 2026-10-03); the tuning gate only tries MTP for checkpoints whose architecture has one. Update when the image changes.",
    "MtpArchitectures": ["BailingMoeV25MTPModel", "BailingMoeV3MTPModel", "DeepSeekMTPModel", "DeepSeekV4MTPModel", "Dots3NoteMTPModel", "EagleDeepSeekMTPModel", "ErnieMTPModel", "Exaone4_5_MTP", "ExaoneMoeMTP", "Gemma4MTPModel", "Glm4MoeLiteMTPModel", "Glm4MoeMTPModel", "GlmOcrMTPModel", "HYV3MTPModel", "InklingMTPModel", "InternS2MobiusMTP", "KimiK3MTPModel", "LongCatFlashMTPModel", "MiMoMTPModel", "MiMoV2MTPModel", "MiMoV2OmniMTPModel", "MiniMaxM3MTP", "NemotronHMTPModel", "OpenPanguMTPModel", "Qwen3NextMTP", "Qwen3_5MTP", "Qwen3_5MoeMTP", "Step3p5MTP"],
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "ModelsHostPath": "/srv/mirbadllm/models",
    "CacheHostPath": "/srv/mirbadllm/cache",
    "DataPath": "/data",
    "DockerNetwork": "mirbadllm",
    "UseContainerNetwork": true,
    "UpstreamHost": "127.0.0.1",
    "PortRangeStart": 8101,
    "MemoryReserveGiB": 8,
    "ApiKey": null,
    "AutoStartOnRequest": false,
    "StartupTimeout": "00:10:00",
    "HealthPollInterval": "00:00:05"
  }
}
