    /// <summary>
    /// A service name as a PowerShell argument for the installer line: single-quoted, since real Windows service names
    /// hold spaces and parentheses ("Intel(R) Capability Licensing Service"), and a name the operator must not paste
    /// unquoted into an administrator shell (MN-230). A name with control characters is shown as plain text.
    /// </summary>
    private static string AllowServiceArgument(string unit)
    {
        try
        {
            return MirbadLLM.Web.Api.WindowsInstallerLine.Quoted(unit);
        }
        catch (ArgumentException)
        {
            return unit;
        }
    }

