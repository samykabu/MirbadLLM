    private static bool IsUp(HostServiceStatus s) => s.State is HostServiceState.Running or HostServiceState.Starting;

    /// <summary>The selected, unprotected services an action applies to: Restart and Stop take the running
    /// ones, Start the stopped ones.</summary>
    private List<HostServiceStatus> BulkTargets(HostServiceAction action) =>
        _snapshot.Services
            .Where(x => _selected.Contains(x.Name) && !x.Protected)
            .Where(x => action == HostServiceAction.Start ? !IsUp(x) : IsUp(x))
            .ToList();

    private void AskBulk(HostServiceAction action)
    {
        _bulkAction = action;
        _bulkTargets = BulkTargets(action);
        _bulkSkipped = _snapshot.Services
            .Where(x => _selected.Contains(x.Name) && !x.Protected && !_bulkTargets.Contains(x))
            .ToList();
        _notice = null;
        _bulkOpen = _bulkTargets.Count > 0;
    }

    private string BulkNoun => _bulkTargets.Count == 1 ? "service" : "services";

    private string BulkTitle => $"{VerbTitle(_bulkAction)} {_bulkTargets.Count} {BulkNoun}?";

    private string BulkConfirmLabel => $"{VerbTitle(_bulkAction)} {_bulkTargets.Count} {BulkNoun}";

    /// <summary>The combined memory effect, in the same words as the single-service dialog.</summary>
    internal static string BulkEffect(HostServiceAction action, IReadOnlyList<HostServiceStatus> targets, double availableGiB)
    {
        if (action == HostServiceAction.Start)
        {
            return $"Starting them takes memory from the <strong class=\"num\">{Encode(FormatGiB(availableGiB))}</strong> free now. How much depends on what each one loads.";
        }

        var measured = targets.Where(x => x.TotalMemoryBytes is not null).ToList();
        var unknown = targets.Where(x => x.TotalMemoryBytes is null).Select(x => Encode(x.DisplayName)).ToList();
        long ram = measured.Sum(x => x.MemoryBytes ?? 0);
        long gpu = measured.Sum(x => x.GpuMemoryBytes ?? 0);
        long total = measured.Sum(x => x.TotalMemoryBytes ?? 0);
        string parts = gpu > 0 ? $" ({Encode(FormatBytes(ram))} RAM + {Encode(FormatBytes(gpu))} GPU)" : " of RAM";
        string amount = $"<strong class=\"num\">{Encode(FormatBytes(total))}</strong>{parts}";
        string unknownNote = unknown.Count == 0 ? "" : $" No reading for {string.Join(", ", unknown)}, so the real total is higher.";
        if (measured.Count == 0)
        {
            return action == HostServiceAction.Stop
                ? "Stopping them frees memory, but MirbadLLM has no reading of how much they use, so the amount is unknown."
                : "Restarting them stops each one and starts it again. They are unavailable for a moment while they start.";
        }

        return action == HostServiceAction.Stop
            ? $"Stopping them frees about {amount} in total.{unknownNote}"
            : $"Restarting them briefly frees about {amount} in total; they take it back as they start and load again.{unknownNote}";
    }

    private string BulkEffectHtml => BulkEffect(_bulkAction, _bulkTargets, _memory.AvailableGiB);

    private async Task ConfirmBulkAsync()
    {
        var targets = _bulkTargets.ToList();
        var action = _bulkAction;
        var ct = _cts?.Token ?? CancellationToken.None;
        var failures = new List<string>();
        _bulkRunning = true;
        _error = null;
        foreach (var target in targets)
        {
            _busy.Add(target.Name);
        }

        try
        {
            foreach (var target in targets)
            {
                try
                {
                    await ServiceManager.RunAsync(target.Name, action, null, ct);
                }
                catch (HostServiceException ex)
                {
                    failures.Add($"{target.DisplayName}: {ex.Message}");
                }
                finally
                {
                    _busy.Remove(target.Name);
                }
            }
        }
        finally
        {
            _bulkRunning = false;
        }

        int ok = targets.Count - failures.Count;
        _notice = ok == 0 ? null : $"{VerbTitle(action)} requested for {ok} {(ok == 1 ? "service" : "services")}. Their states update below as it happens.";
        _error = failures.Count == 0 ? null : $"Couldn't {VerbTitle(action).ToLowerInvariant()} {string.Join("; ", failures)}";
        _selected.Clear();
        _bulkTargets = [];
        _bulkSkipped = [];
        await LoadAsync(ct);
    }

