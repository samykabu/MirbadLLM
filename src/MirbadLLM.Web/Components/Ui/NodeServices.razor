    private async Task ProtectAsync(HostServiceStatus service)
    {
        _notice = null;
        await RunGuardedAsync(service,
            () => ServiceManager.UpdateWhitelistAsync(service.Name, new HostServiceWhitelistUpdate(null, true, null, null, _clientKey), _cts?.Token ?? CancellationToken.None),
            $"{service.DisplayName} is now protected.");
    }

    private async Task ConfirmWhitelistAsync()
    {
        if (!WhitelistReady)
        {
            return;
        }

        var ct = _cts?.Token ?? CancellationToken.None;
        var caller = await AdminCallers.ResolveAsync(ServiceProvider);
        _wlError = null;
        try
        {
            switch (_wlMode)
            {
                case WhitelistMode.Add when _wlAdd is not null:
                    var added = await ServiceManager.AddToWhitelistAsync(
                        new HostServiceWhitelistAdd(_wlAdd.Kind, _wlAdd.Unit, _wlDisplayName, _wlProtected, _wlTyped.Trim(), null, _clientKey) { User = caller.User }, ct);
                    _notice = $"{added.DisplayName} is now managed.";
                    break;
                case WhitelistMode.Unprotect when _wlTarget is not null:
                    await ServiceManager.UpdateWhitelistAsync(_wlTarget.Name,
                        new HostServiceWhitelistUpdate(null, false, _wlTyped.Trim(), null, _clientKey) { User = caller.User }, ct);
                    _notice = $"{_wlTarget.DisplayName} is no longer protected.";
                    break;
                case WhitelistMode.Remove when _wlTarget is not null:
                    await ServiceManager.RemoveFromWhitelistAsync(_wlTarget.Name, ct);
                    _notice = $"{_wlTarget.DisplayName} is no longer managed here.";
                    break;
                default:
                    return;
            }
        }
        catch (HostServiceException ex)
        {
            // Keep the refusal visible so the operator can correct the name or sign in again.
            _wlError = ex.Message;

            return;
        }

        _wlOpen = false;
        ResetWhitelist();
        await LoadAsync(ct);
        if (_topTab == "discovered")
        {
            await LoadDiscoveryAsync(ct, render: false);
        }
    }

    private void ResetWhitelist()
    {
        _wlTyped = "";

        _wlError = null;
        _wlProtected = false;
    }

    private async Task ToggleAutostartAsync(HostServiceStatus service)
    {
        bool enable = service.Autostart != true;
        _notice = null;
        if (!enable && service.Protected)
        {
            _target = service;
            _pendingAutostart = false;
            _typed = "";
            _dialogOpen = true;
            return;
        }

        await RunGuardedAsync(service, () => ServiceManager.SetAutostartAsync(service.Name, enable, null, _cts?.Token ?? CancellationToken.None),
            $"Autostart for {service.DisplayName} is now {(enable ? "on" : "off")}.");
    }

    private async Task ConfirmAsync()
    {
        var target = _target;
        if (target is null || !TypedConfirmationOk)
        {
            return;
        }

        string? confirm = NeedsTypedConfirmation ? _typed.Trim() : null;
        var ct = _cts?.Token ?? CancellationToken.None;
        if (_pendingAutostart is bool enabled)
        {
            await RunGuardedAsync(target, () => ServiceManager.SetAutostartAsync(target.Name, enabled, confirm, ct),
                $"Autostart for {target.DisplayName} is now off.");
        }
        else
        {
            var action = _pendingAction;
            await RunGuardedAsync(target, () => ServiceManager.RunAsync(target.Name, action, confirm, ct),
                $"{VerbTitle(action)} of {target.DisplayName} requested. Its state updates below as it happens.");
        }

        ResetDialog();
    }

    private async Task RunGuardedAsync(HostServiceStatus service, Func<Task<HostServiceStatus>> run, string success)
    {
        _busy.Add(service.Name);
        _error = null;
        try
        {
            await run();
            _notice = success;
        }
        catch (HostServiceException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy.Remove(service.Name);
        }

        await LoadAsync(_cts?.Token ?? CancellationToken.None);
    }

    private void ResetDialog()
    {
        _typed = "";
        _pendingAutostart = null;
    }

