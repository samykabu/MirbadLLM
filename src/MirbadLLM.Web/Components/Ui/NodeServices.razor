    private async Task LoadDiscoveryAsync(CancellationToken ct, bool render = true)
    {
        if (_discovering)
        {
            return;
        }

        _discovering = true;
        if (render)
        {
            StateHasChanged();
        }

        string forNode = _nodeId;
        try
        {
            var discovery = await ServiceManager.DiscoverAsync(ct);
            if (string.Equals(forNode, _nodeId, StringComparison.Ordinal))
            {
                _discovery = discovery;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _discovery = new HostServicesDiscovery([], false, ex.Message, [$"Could not discover services: {ex.Message}"]);
        }
        finally
        {
            _discovering = false;
        }
    }

    private IEnumerable<DiscoveredService> Filtered(HostServiceKind? kind)
    {
        var items = (_discovery?.Services ?? []).Where(d => kind is null || d.Kind == kind);
        string f = _filter.Trim();
        return f.Length == 0
            ? items
            : items.Where(d => d.Name.Contains(f, StringComparison.OrdinalIgnoreCase)
                || d.Unit.Contains(f, StringComparison.OrdinalIgnoreCase)
                || d.Description.Contains(f, StringComparison.OrdinalIgnoreCase));
    }

    private static string DiscoveredTitle(DiscoveredService d) =>
        string.IsNullOrWhiteSpace(d.Description) || d.Kind == HostServiceKind.Container || string.Equals(d.Description, d.Unit, StringComparison.Ordinal)
            ? d.Name
            : d.Description;

    /// <summary>Budgets of the running models; with <paramref name="onNode"/>, only those placed on the selected node.</summary>
    private static double ModelsGiB(LiveSnapshot live, IReadOnlySet<string>? onNode)
    {
        var running = (live.Statuses?.Values ?? [])
            .Where(s => s.State is ModelState.Starting or ModelState.Ready or ModelState.Stopping)
            .Select(s => s.Id)
            .ToHashSet(StringComparer.Ordinal);
        return (live.Models ?? []).Where(d => running.Contains(d.Id) && (onNode is null || onNode.Contains(d.Id))).Sum(d => d.MemoryBudgetGiB);
    }

