    /// <summary>"1.6 GiB" at or above 1 GiB, "170 MiB" below it, "—" when not measured.</summary>
    internal static string FormatBytes(long? bytes)
    {
        if (bytes is not long b)
        {
            return UiFormat.Missing;
        }

        const double GiB = 1024d * 1024 * 1024;
        const double MiB = 1024d * 1024;
        return b >= GiB
            ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{b / GiB:0.0} GiB")
            : string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{b / MiB:0} MiB");
    }

    private static string FormatGiB(double gib) => UiFormat.GiB(gib);

    /// <summary>"3d 04h" past a day, else the shared elapsed format ("2h 05m", "4m 10s").</summary>
    internal static string Uptime(DateTimeOffset since, DateTimeOffset now)
    {
        var elapsed = now - since;
        return elapsed.TotalDays >= 1
            ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{(int)elapsed.TotalDays}d {elapsed.Hours:00}h")
            : UiFormat.Elapsed(since, now);
    }

    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        if (_cts is not null)
        {
            await _cts.CancelAsync();
        }

        if (_ownsLive && _live is not null)
        {
            await _live.DisposeAsync();
        }

        _cts?.Dispose();
    }
