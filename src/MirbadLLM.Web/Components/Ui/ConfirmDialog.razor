@namespace MirbadLLM.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@* Accessible confirmation for consequential actions: a modal <dialog> (focus contained, Esc cancels,
   background inert), a title that names the action, a body that states the exact consequence, and a
   confirm button that repeats the action's name. Cancel has initial focus. *@
<dialog @ref="_dialog" class="ss-dialog" aria-labelledby="@TitleId" aria-describedby="@BodyId"
        @oncancel="OnNativeCancelAsync" data-testid="@TestId" data-open="@(Open ? "true" : "false")">
    <div class="ss-dialog-inner">
        <h2 id="@TitleId">@TidyTitle(Title)</h2>
        <div class="ss-dialog-body" id="@BodyId">@ChildContent</div>
        <div class="ss-dialog-actions">
            <button type="button" class="btn btn-outline-secondary" autofocus data-testid="@($"{TestId}-cancel")" @onclick="CancelAsync">@CancelLabel</button>
            <button type="button" class="btn @(Destructive ? (DangerFill ? "btn-danger-fill" : "btn-danger") : "btn-primary")" data-testid="@(ConfirmTestId ?? $"{TestId}-confirm")"
                    disabled="@(_confirming || ConfirmDisabled)" @onclick="ConfirmAsync">
                @ConfirmLabel
            </button>
        </div>
    </div>
</dialog>

@code {
    private static int _nextId;

    private readonly int _id = Interlocked.Increment(ref _nextId);
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _shown;
    private bool _confirming;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public string ConfirmLabel { get; set; } = "";

    [Parameter]
    public string CancelLabel { get; set; } = "Cancel";

    /// <summary>Red confirm button for irreversible or risky actions.</summary>
    [Parameter]
    public bool Destructive { get; set; }

    [Parameter]
    public bool DangerFill { get; set; }

    /// <summary>Keeps the confirm button disabled, e.g. until a typed confirmation matches.</summary>
    [Parameter]
    public bool ConfirmDisabled { get; set; }

    /// <summary>
    /// False: confirming does not close the dialog; the parent closes it (sets <see cref="Open"/> false) once the
    /// action succeeded, so a server-side refusal (e.g. a wrong password) can be shown in place.
    /// </summary>
    [Parameter]
    public bool CloseOnConfirm { get; set; } = true;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string TestId { get; set; } = "confirm-dialog";

    [Parameter]
    public string? ConfirmTestId { get; set; }

    private string TitleId => $"dialog-{_id}-title";

    /// <summary>Titles are built from names that can be empty or carry stray spaces ("Stop  ComfyUI ?"): one
    /// space between words, none before the closing punctuation.</summary>
    public static string TidyTitle(string title)
    {
        string collapsed = System.Text.RegularExpressions.Regex.Replace(title ?? "", @"\s+", " ").Trim();
        return System.Text.RegularExpressions.Regex.Replace(collapsed, @"\s+([?!.,:;])", "$1");
    }

    private string BodyId => $"dialog-{_id}-body";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _shown = Open;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop.js");
            await _module.InvokeVoidAsync(Open ? "showDialog" : "closeDialog", _dialog);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone; nothing to show.
        }
    }

    private async Task ConfirmAsync()
    {
        _confirming = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _confirming = false;
        }

        if (CloseOnConfirm)
        {
            await SetOpenAsync(false);
        }
    }

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
        await SetOpenAsync(false);
    }

    // Esc: the browser closes the dialog itself; keep the parameter in step.
    private async Task OnNativeCancelAsync()
    {
        _shown = false;
        await OnCancel.InvokeAsync();
        await SetOpenAsync(false);
    }

    private async Task SetOpenAsync(bool open)
    {
        Open = open;
        await OpenChanged.InvokeAsync(open);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected when the circuit is already gone.
            }
        }
    }
}
