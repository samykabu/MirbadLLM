@namespace MirbadLLM.Web.Components.Ui
@implements IAsyncDisposable
@using MirbadLLM.Orchestration
@using MirbadLLM.Orchestration.Nodes
@using MirbadLLM.Orchestration.Benchmarking
@using Microsoft.Extensions.Options
@inject IServiceProvider ServiceProvider
@* The persistent header of every page of one model (Overview, Settings, Logs, Benchmark, Tune): the way back to Models,
   the served name with the model id beside it, the live state (with the elapsed timer while Starting or Stopping), the
   node / runtime / budget chips, Start or Stop and Chat in place, and the line tabs between the model's pages.
   Start goes through the same admission as a Dashboard card: Runtime.StartAsync refuses what does not fit, and the
   "Start anyway?" dialog shows the agent's own numbers (AdmissionNumbers) before a forced start. Data follows the
   circuit's shared LiveDataService refresh, so the state here and in the status bar always agree. *@
<header class="model-header" data-testid="model-header">
    <a class="page-header-back" href="models" data-testid="model-header-back"><Icon Name="back" /> Models</a>

    <div class="model-header-main">
        <div class="model-header-title">
            <h1 tabindex="-1" data-testid="page-title">@ServedName</h1>
            <span class="model-header-id num" data-testid="model-header-id">@ModelId</span>
            @if (_status is { } status)
            {
                <StateBadge State="status.State" Since="status.Since" Now="_now" TestId="model-header-state" />
            }
        </div>

        <div class="model-header-actions" role="group" aria-label="@($"Actions for {ServedName}")" data-tour="model-actions">
            @if (_status is null || _model is null)
            {
                <button type="button" class="btn btn-primary" disabled><Icon Name="play" /> Start</button>
            }
            else if (_status.State is ModelState.Stopped or ModelState.Failed)
            {
                <button type="button" class="btn btn-primary" disabled="@(_busy || _starts?.IsPending(ModelId) == true || ActiveJob is not null || Unplaced)" data-testid="header-start"
                        aria-label="@($"Start {ServedName}")" @onclick="StartAsync">
                    <Icon Name="play" /> @(_starts?.IsQueued(ModelId) == true ? "Queued" : _busy ? "Starting…" : "Start")
                </button>
                @if (_starts?.IsQueued(ModelId) == true)
                {
                    <button type="button" class="btn btn-ghost" data-testid="header-cancel-start" @onclick="() => _starts.Cancel(ModelId)">Cancel queued start</button>
                }
            }
            else if (_status.State is ModelState.Ready or ModelState.Starting)
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@(_busy || ActiveJob is not null)" data-testid="header-stop"
                        aria-label="@($"Stop {ServedName}")" @onclick="StopAsync">
                    <Icon Name="stop" /> @(_busy ? "Stopping…" : "Stop")
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" disabled data-testid="header-stopping"><Icon Name="stop" /> Stopping…</button>
            }

            @if (_status?.State == ModelState.Ready && _model is not null)
            {
                <a class="btn btn-outline-secondary" data-testid="header-chat" href="@($"chat?model={Uri.EscapeDataString(_model.ServedName)}")"
                   aria-label="@($"Chat with {ServedName}")"><Icon Name="chat" /> Chat</a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" disabled data-testid="header-chat-disabled"
                        aria-describedby="model-header-chat-why"><Icon Name="chat" /> Chat</button>
                <span class="visually-hidden" id="model-header-chat-why">Chat opens once the model is Ready.</span>
            }
        </div>
    </div>

    @if (_model is not null)
    {
        <ul class="model-header-chips" aria-label="Placement and budget">
            <li>
                @if (NodeId is { } node)
                {
                    <a class="chip model-chip" href="@($"nodes/{Uri.EscapeDataString(node)}")" data-testid="model-header-node"
                       aria-label="@($"Node {node}")"><Icon Name="server" /> @node</a>
                }
                else
                {
                    <span class="chip model-chip model-chip--muted" data-testid="model-header-node">Unplaced</span>
                }
            </li>
            <li><span class="chip model-chip" data-testid="model-header-runtime"><span class="model-chip-key">runtime</span> @RuntimeLabel(_model.Runtime)</span></li>
            <li><span class="chip model-chip" data-testid="model-header-budget"><span class="model-chip-key">budget</span> @UiFormat.GiB(_model.MemoryBudgetGiB)</span></li>
            @if (ActiveJob is { } job)
            {
                <li>
                    <a class="chip chip--busy" href="@($"models/{ModelId}/{(job == JobKind.Tuning ? "tune" : "benchmark")}")" data-testid="model-header-job">
                        <Icon Name="gauge" /> @(job == JobKind.Tuning ? "Tuning" : "Benchmarking") · API paused
                    </a>
                </li>
            }
            else if (_status is { RestartPending: true, State: ModelState.Ready or ModelState.Starting })
            {
                <li class="model-header-pending">
                    <span class="chip chip--busy" data-testid="model-header-restart-pending"><Icon Name="refresh" /> Restart pending</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="model-header-apply" @onclick="ApplyAsync"
                            aria-label="@($"Apply saved settings to {ServedName}")">Apply</button>
                </li>
            }
        </ul>
    }

    <nav class="model-tabs" aria-label="@($"{ServedName} pages")" data-tour="model-tabs" data-testid="model-tabs">
        @foreach (var (key, label, icon, href) in Tabs)
        {
            <a href="@href" aria-current="@(Current == key ? "page" : null)" data-testid="@($"model-tab-{key}")"><Icon Name="@icon" /> @label</a>
        }
    </nav>
</header>

@if (_error is not null)
{
    <div class="callout callout--failed page-alert" role="alert" data-testid="model-header-error">
        <Icon Name="state-failed" />
        <div class="callout-body">@_error</div>
    </div>
}

@* Mounted only once Apply is asked for: the Settings page has its own Apply dialog, and two idle copies would share ids. *@
@if (_applyMounted)
{
    <ApplyChangesDialog @ref="_apply" OnFinished="AfterApplyAsync" />
}

<ConfirmDialog @bind-Open="_forceOpen" Title="@($"Start {ServedName} anyway?")" ConfirmLabel="Start anyway" Destructive="true"
               OnConfirm="ForceStartAsync" TestId="header-force-start-dialog">
    <p data-testid="header-force-start-numbers">
        @ServedName needs <strong class="num">@UiFormat.GiB(_forceNeed)</strong>@(_forceWhere is null ? "" : $" on {_forceWhere}"), but only
        <strong class="num">@UiFormat.GiB(_forceFreeAfterReserve)</strong> is free after the
        <span class="num">@UiFormat.GiB(_forceReserve)</span> reserve (<span class="num">@UiFormat.GiB(_forceFree)</span> free in total@(_forceHeldByOthers > 0 ? $", {UiFormat.GiB(_forceHeldByOthers)} held by other starts" : "")).
    </p>
    <p class="muted">
        Starting anyway can push ComfyUI, Ollama or other models on this node out of memory, or leave this model failing while it loads.
    </p>
</ConfirmDialog>

@code {
    /// <summary>The model's id.</summary>
    [Parameter, EditorRequired]
    public string ModelId { get; set; } = "";

    /// <summary>The page being shown: overview, settings, logs, benchmark or tune.</summary>
    [Parameter, EditorRequired]
    public string Current { get; set; } = "";

    /// <summary>Raised whenever the model's state is (re)read, so the page can follow it (e.g. Delete needs Stopped).</summary>
    [Parameter]
    public EventCallback<ModelStatus> StatusChanged { get; set; }

    private const LiveNeeds Needs = LiveNeeds.Models | LiveNeeds.Statuses;

    private ModelDefinition? _model;
    private ModelStatus? _status;
    private ModelState? _lastState;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private bool _busy;
    private string? _error;
    private ApplyChangesDialog? _apply;

    private LiveDataService? _live;
    private bool _ownsLive;
    private IDisposable? _subscription;
    private CancellationTokenSource? _cts;

    private IModelRuntime? _runtime;
    private ModelStartService? _starts;
    private IOwnershipStore? _ownership;
    private INodeRegistry? _nodeRegistry;
    private INodeStatusCache? _nodeCache;
    private ModelJobService? _jobs;
    private double _reserveGiB = 8;

    private bool _forceOpen;
    private double _forceNeed;
    private double _forceFree;
    private double _forceFreeAfterReserve;
    private double _forceReserve = 8;
    private double _forceHeldByOthers;
    private string? _forceWhere;

    private string ServedName => _model?.ServedName ?? ModelId;

    /// <summary>The node the model is placed on; with no placement on a fleet of one, that node.</summary>
    private string? NodeId => _model?.Placement?.NodeId ?? _singleNodeId;

    private string? _singleNodeId;

    /// <summary>True when the fleet has several nodes and the model is on none of them: it cannot start.</summary>
    private bool Unplaced => NodeId is null && _multiNode;

    private bool _multiNode;

    /// <summary>The benchmark or tuning job measuring this model right now, if any.</summary>
    private JobKind? ActiveJob => _jobs?.Running.FirstOrDefault(j => string.Equals(j.ModelId, ModelId, StringComparison.Ordinal))?.Kind;

    private IEnumerable<(string Key, string Label, string Icon, string Href)> Tabs =>
    [
        ("overview", "Overview", "dashboard", $"models/{ModelId}/overview"),
        ("settings", "Settings", "edit", $"models/{ModelId}"),
        ("logs", "Logs", "logs", $"models/{ModelId}/logs"),
        ("benchmark", "Benchmark", "gauge", $"models/{ModelId}/benchmark"),
        ("tune", "Tune", "sliders", $"models/{ModelId}/tune"),
    ];

    /// <summary>The runtime as operators name it.</summary>
    public static string RuntimeLabel(RuntimeKind runtime) => LlamaCppEditing.RuntimeName(runtime);

    protected override async Task OnInitializedAsync()
    {
        _runtime = ServiceProvider.GetService<IModelRuntime>();
        _starts = ServiceProvider.GetService<ModelStartService>();
        _ownership = ServiceProvider.GetService<IOwnershipStore>();
        _nodeRegistry = ServiceProvider.GetService<INodeRegistry>();
        _nodeCache = ServiceProvider.GetService<INodeStatusCache>();
        _jobs = ServiceProvider.GetService<ModelJobService>();
        _reserveGiB = ServiceProvider.GetService<IOptions<MirbadLLMOptions>>()?.Value.MemoryReserveGiB ?? new MirbadLLMOptions().MemoryReserveGiB;
        _forceReserve = _reserveGiB;
        await ReadFleetAsync();

        _cts = new CancellationTokenSource();
        _live = LiveDataService.Resolve(ServiceProvider, out _ownsLive);
        await ApplyAsync(await _live.GetAsync(Needs, _cts.Token));

        // The shared 5 s refresh carries the data; its 1 s clock only re-renders the elapsed timer during a transition.
        _subscription = _live.Subscribe(Needs,
            snapshot => InvokeAsync(async () =>
            {
                await ApplyAsync(snapshot);
                StateHasChanged();
            }),
            now => _status?.State is ModelState.Starting or ModelState.Stopping
                ? InvokeAsync(() =>
                {
                    _now = now;
                    StateHasChanged();
                })
                : Task.CompletedTask);
    }

    private async Task ReadFleetAsync()
    {
        if (_nodeRegistry is null)
        {
            return;
        }

        try
        {
            var all = await _nodeRegistry.ListAsync();
            _multiNode = PlacementEditing.IsMultiNode(all);
            _singleNodeId = _multiNode ? null : (NodeFleet.Members(all).FirstOrDefault() ?? all.FirstOrDefault(n => !n.Revoked))?.Id;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _multiNode = false;
        }
    }

    private async Task ApplyAsync(LiveSnapshot snapshot)
    {
        _now = DateTimeOffset.UtcNow;
        if (snapshot.Models?.FirstOrDefault(m => string.Equals(m.Id, ModelId, StringComparison.Ordinal)) is { } model)
        {
            _model = model;
        }

        if (snapshot.Statuses is { } statuses)
        {
            _status = statuses.TryGetValue(ModelId, out var s) ? s : new ModelStatus(ModelId, ModelState.Stopped);
        }
        else if (_status is null && _runtime is not null)
        {
            try
            {
                _status = await _runtime.GetStatusAsync(ModelId);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _status = null;
            }
        }

        if (_status is { } current && current.State != _lastState)
        {
            _lastState = current.State;
            await StatusChanged.InvokeAsync(current);
        }
    }

    private async Task RefreshAsync()
    {
        if (_live is not null)
        {
            await ApplyAsync(await _live.RefreshAsync(_cts?.Token ?? CancellationToken.None));
        }
    }

    private async Task StartAsync()
    {
        if (_runtime is null)
        {
            return;
        }

        _error = null;
        _busy = true;
        try
        {
            await MirbadLLM.Orchestration.Multinode.HeldModelGuard.EnsureNotHeldAsync(_ownership, ModelId); // design §6.7
            await (_starts?.StartAsync(ModelId, force: false) ?? _runtime.StartAsync(ModelId, force: false));
        }
        catch (ModelMemoryAdmissionException ex)
        {
            await PrepareForceStartAsync(ex);
        }
        catch (ModelBusyException ex)
        {
            _error = EditorRefusals.Runtime(ex, ServedName, "start");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Couldn't start {ServedName}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    /// <summary>The same numbers the Dashboard card's "Start anyway?" shows: the agent's refusal when it sent them, else
    /// the model's own node's live memory and reserve (or this box's probe on a fleet of one).</summary>
    private async Task PrepareForceStartAsync(ModelMemoryAdmissionException refusal)
    {
        string? placedOn = _model?.Placement?.NodeId;
        Pages.Nodes.NodeRow? node = null;
        if (_multiNode && placedOn is { } nodeId)
        {
            NodeRecord? record = null;
            try
            {
                record = _nodeRegistry is null ? null : (await _nodeRegistry.ListAsync()).LastOrDefault(r => r.Id == nodeId);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                record = null;
            }

            var live = _nodeCache?.GetNode(nodeId);
            if (record is not null || live is not null)
            {
                node = Pages.Nodes.Merge(record, live, _model is null ? [] : [_model]);
            }
        }

        _forceHeldByOthers = 0;
        _forceWhere = null;
        if (AdmissionNumbers.FromRefusal(refusal, placedOn, node?.Capabilities?.Gpus) is { } numbers)
        {
            _forceNeed = numbers.NeedGiB;
            _forceFree = numbers.AvailableGiB;
            _forceReserve = numbers.ReserveGiB;
            _forceFreeAfterReserve = numbers.FreeAfterReserveGiB;
            _forceHeldByOthers = numbers.HeldByOthersGiB;
            _forceWhere = numbers.Where is { } where && (_multiNode || !string.Equals(where, placedOn, StringComparison.Ordinal)) ? where : null;
            _forceOpen = true;
            return;
        }

        double free;
        double reserve;
        if (node?.Memory is { } nodeMemory)
        {
            free = nodeMemory.HostAvailableGiB;
            reserve = node.ReserveGiB;
        }
        else if (ServiceProvider.GetService<IMemoryProbe>() is { } probe)
        {
            free = (await probe.GetAsync()).AvailableGiB;
            reserve = _reserveGiB;
        }
        else
        {
            free = 0;
            reserve = _reserveGiB;
        }

        _forceNeed = _model?.MemoryBudgetGiB ?? 0;
        _forceFree = free;
        _forceReserve = reserve;
        _forceFreeAfterReserve = Math.Max(0, free - reserve);
        _forceOpen = true;
    }

    private async Task ForceStartAsync()
    {
        if (_runtime is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await MirbadLLM.Orchestration.Multinode.HeldModelGuard.EnsureNotHeldAsync(_ownership, ModelId); // design §6.7
            await (_starts?.StartAsync(ModelId, force: true) ?? _runtime.StartAsync(ModelId, force: true));
        }
        catch (ModelBusyException ex)
        {
            _error = EditorRefusals.Runtime(ex, ServedName, "start");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Couldn't start {ServedName}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    private async Task StopAsync()
    {
        if (_runtime is null)
        {
            return;
        }

        _error = null;
        _busy = true;
        try
        {
            await MirbadLLM.Orchestration.Multinode.HeldModelGuard.EnsureNotHeldAsync(_ownership, ModelId); // design §6.7
            _starts?.Cancel(ModelId);
            await _runtime.StopAsync(ModelId);
        }
        catch (ModelBusyException ex)
        {
            _error = EditorRefusals.Runtime(ex, ServedName, "stop");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Couldn't stop {ServedName}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    private bool _applyMounted;
    private bool _applyRequested;

    private async Task ApplyAsync()
    {
        if (_model is null)
        {
            return;
        }

        if (_apply is not null)
        {
            await _apply.OpenForPendingAsync(_model);
            return;
        }

        // First use: mount the dialog, then open it once it has rendered (OnAfterRenderAsync).
        _applyMounted = true;
        _applyRequested = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_applyRequested && _apply is not null && _model is not null)
        {
            _applyRequested = false;
            await _apply.OpenForPendingAsync(_model);
        }
    }

    private Task AfterApplyAsync(bool restarted) => restarted ? RefreshAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        _cts?.Cancel();
        if (_ownsLive && _live is not null)
        {
            await _live.DisposeAsync();
        }

        _cts?.Dispose();
    }
}
