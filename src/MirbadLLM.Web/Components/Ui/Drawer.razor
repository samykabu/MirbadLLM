@namespace MirbadLLM.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@* A non-modal side panel over the right of the page (Monitoring's model readout): the page behind stays live and
   usable. Opening moves focus to its close button; Esc, the button or a press anywhere outside it closes it, and the
   caller returns focus to whatever opened it (OnClose). Elements marked data-drawer-keep (rows that switch the panel
   to another item) don't count as outside. *@
<aside @ref="_panel" class="side-panel @(Open ? "side-panel--open" : null)" aria-labelledby="@(Open ? TitleId : null)"
       aria-hidden="@(Open ? null : "true")" data-testid="@TestId" @onkeydown="OnKeyDown">
    @if (Open)
    {
        <div class="side-panel-head">
            <div class="side-panel-title">@Header</div>
            <button type="button" class="icon-btn" aria-label="Close details" title="Close (Esc)" @ref="_close"
                    data-testid="@($"{TestId}-close")" @onclick="CloseAsync">
                <Icon Name="chevron-right" />
            </button>
        </div>
        <div class="side-panel-body">@ChildContent</div>
    }
</aside>

@code {
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Id of the heading inside <see cref="Header"/> that names the panel.</summary>
    [Parameter]
    public string? TitleId { get; set; }

    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised by Esc and the close button.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public string TestId { get; set; } = "drawer";

    private ElementReference _close;
    private ElementReference _panel;
    private bool _wasOpen;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Drawer>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool opened = Open && !_wasOpen;
        bool closed = !Open && _wasOpen;
        _wasOpen = Open;
        if (opened)
        {
            await _close.FocusAsync(preventScroll: true);
        }

        if (opened || closed)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interop.js");
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync(opened ? "closeOnPressOutside" : "stopClosingOnPressOutside", _panel, _self);
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone; nothing to watch.
            }
        }
    }

    /// <summary>Called by interop.js for a press outside the open panel.</summary>
    [JSInvokable]
    public Task PressedOutside() => Open ? CloseAsync() : Task.CompletedTask;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Open && e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopClosingOnPressOutside", _panel, null);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected when the circuit is already gone.
            }
        }

        _self?.Dispose();
    }
}
