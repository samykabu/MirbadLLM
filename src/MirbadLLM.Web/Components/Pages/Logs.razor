@page "/models/{Id}/logs"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IModelRegistry Registry
@inject IModelRuntime Runtime
@inject IJSRuntime JS

<PageTitle>@(_servedName ?? Id) · Logs · MirbadLLM</PageTitle>

@if (_notFound)
{
    <PageHeader Title="Logs" BackHref="models" BackLabel="Models" />
    <EmptyState Title="@($"No model called \"{Id}\"")" TestId="logs-not-found">
        <ChildContent><p>It may have been deleted. Pick a model from the list to see its container log.</p></ChildContent>
        <Actions><a class="btn btn-outline-secondary" href="models">Go to Models</a></Actions>
    </EmptyState>
}
else
{
    <ModelHeader ModelId="@(Id ?? "")" Current="logs" />

    <div class="toolbar logs-toolbar">
        <div class="form-check form-switch switch-row">
            <input class="form-check-input" type="checkbox" role="switch" id="autoscroll" checked="@_autoScroll" @onchange="OnAutoScrollChanged" />
            <label class="form-check-label" for="autoscroll">Follow new lines</label>
        </div>
        <span class="muted logs-source">The last 200 lines of <span class="num">ss-@Id</span>, then live output.</span>
        <span class="spacer"></span>
        <span class="muted num" data-testid="log-count">@_lines.Count.ToString("#,0", System.Globalization.CultureInfo.InvariantCulture) lines@(_lines.Count >= MaxLines ? $" (oldest dropped past {MaxLines:#,0})" : "")</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="log-download" disabled="@(_lines.Count == 0)"
                aria-label="@($"Download the {_lines.Count} lines shown as a text file")" @onclick="DownloadAsync">
            <Icon Name="download" /> Download
        </button>
    </div>

    <pre id="log-container" class="log-pane @(_lines.Count == 0 ? "log-pane--empty" : null)" role="log" aria-label="@($"Container log for {Id}")" tabindex="0"
         data-testid="log-container">@(_lines.Count == 0 ? "Waiting for output…" : string.Join('\n', _lines))</pre>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private const int MaxLines = 2000;

    // Lines arrive on the stream task and are rendered in batches (at most every 100 ms), so a chatty
    // container costs one render per batch instead of one per line.
    private readonly List<string> _lines = [];
    private readonly List<string> _pending = [];
    private readonly Lock _pendingLock = new();

    private bool _autoScroll = true;
    private bool _notFound;
    private string? _servedName;
    private CancellationTokenSource? _cts;
    private Task? _streamTask;
    private Task? _flushTask;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        var definition = Id is null ? null : await Registry.GetAsync(Id);
        if (definition is null)
        {
            _notFound = true;
            return;
        }

        _servedName = definition.ServedName;
        _cts = new CancellationTokenSource();
        _streamTask = StreamAsync(Id!, _cts.Token);
        _flushTask = FlushLoopAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_notFound)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./interop.js");
        }
    }

    private async Task StreamAsync(string id, CancellationToken ct)
    {
        try
        {
            await foreach (var line in Runtime.StreamLogsAsync(id, tail: 200, follow: true, ct))
            {
                lock (_pendingLock)
                {
                    _pending.Add(line);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on navigate-away/dispose.
        }
    }

    private async Task FlushLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                string[] batch;
                lock (_pendingLock)
                {
                    if (_pending.Count == 0)
                    {
                        continue;
                    }

                    batch = [.. _pending];
                    _pending.Clear();
                }

                await InvokeAsync(() =>
                {
                    _lines.AddRange(batch);
                    if (_lines.Count > MaxLines)
                    {
                        _lines.RemoveRange(0, _lines.Count - MaxLines);
                    }

                    StateHasChanged();
                });

                if (_autoScroll && _module is not null)
                {
                    try
                    {
                        await _module.InvokeVoidAsync("scrollToBottom", "log-container");
                    }
                    catch (JSDisconnectedException)
                    {
                        return;
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose.
        }
    }

    private void OnAutoScrollChanged(ChangeEventArgs e) => _autoScroll = e.Value is true;

    /// <summary>Saves the lines on screen (at most <see cref="MaxLines"/>) as <c>{id}.log</c>, without leaving the page.</summary>
    private async Task DownloadAsync()
    {
        if (_module is null || _lines.Count == 0)
        {
            return;
        }

        string text = string.Join('\n', _lines) + "\n";
        string url = "data:text/plain;charset=utf-8," + Uri.EscapeDataString(text);
        try
        {
            await _module.InvokeVoidAsync("downloadUrl", url, $"{Id}.log");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to download into.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        foreach (var task in new[] { _streamTask, _flushTask })
        {
            if (task is null)
            {
                continue;
            }

            try
            {
                await task;
            }
            catch (OperationCanceledException)
            {
                // Expected.
            }
        }

        _cts?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected when the circuit is already gone.
            }
        }
    }
}
