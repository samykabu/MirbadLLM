    private IEnumerable<string> MambaCacheModeOptions =>
        string.IsNullOrEmpty(_model.MambaCacheMode) || MambaCacheModes.Contains(_model.MambaCacheMode, StringComparer.Ordinal)
            ? MambaCacheModes
            : MambaCacheModes.Append(_model.MambaCacheMode);

