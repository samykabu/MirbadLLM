    /// <summary>The nodes (several = the Placement section), and the placement the form starts from.</summary>
    private async Task LoadNodesAsync()
    {
        IReadOnlyList<NodeRecord> all = _nodeRegistry is { } registry ? await registry.ListAsync() : [];
        // The fleet's single member (a node waiting for approval is not one, W9 review MN-132), else the one registered.
        _singleNodeId = (NodeFleet.Members(all).FirstOrDefault() ?? all.FirstOrDefault(n => !n.Revoked))?.Id;
        _multiNode = PlacementEditing.IsMultiNode(all);
        if (!_multiNode)
        {
            // The Placement section stays hidden, but the Runtime option is the node's, not the fleet's (MN-239 item 3,
            // D131): a fleet of one Windows PC must be able to create a llama.cpp model.
            var single = _nodeCache;
            _singleNode = _singleNodeId is null
                ? null
                : PlacementEditing.Offered(all, id => single?.GetNode(id), _original?.Placement?.NodeId)
                    .FirstOrDefault(n => string.Equals(n.Id, _singleNodeId, StringComparison.Ordinal));
            return;
        }

        var cache = _nodeCache;
        _nodes = PlacementEditing.Offered(all, id => cache?.GetNode(id), _original?.Placement?.NodeId);
        if (IsNew)
        {
            _nodeId = _nodes.FirstOrDefault(n => string.Equals(n.Id, NodeQuery, StringComparison.Ordinal)) is { } preselected &&
                PlacementEditing.PlacementRefusal(preselected, needsServing: false) is null
                ? preselected.Id
                : null;
            _gpus = [];
            _keepServing = false;
        }
        else if (_original is not null)
        {
            ResetPlacementFrom(_original);
            _keepServing = _original.KeepServingDuringJobs;
        }
    }

    /// <summary>The node states (the live view), keeping the selection.</summary>
    private async Task RefreshNodesAsync()
    {
        if (!_multiNode || _nodeRegistry is not { } registry)
        {
            return;
        }

        var cache = _nodeCache;
        _nodes = PlacementEditing.Offered(await registry.ListAsync(), id => cache?.GetNode(id), _original?.Placement?.NodeId);
    }

    /// <summary>
    /// The Placement section shows <paramref name="stored"/>'s node and GPUs (after load, a refused save or a move); the
    /// keep-serving flag is a setting like the others and keeps its edit.
    /// </summary>
    private void ResetPlacementFrom(ModelDefinition stored)
    {
        _nodeId = stored.Placement?.NodeId;
        _gpus = [.. stored.Placement?.GpuUuids ?? []];
    }

    private async Task OnNodeChangedAsync(string? nodeId)
    {
        _nodeId = nodeId;
        _gpus = [];
        _nodeMissing = false;
        _selectedFolder = "";
        _inspection = null;
        _folderError = null;
        if (IsLlamaCpp)
        {
            ResetGguf();
            _llama.GpuBudgets = [];
            if (LlamaCppEditing.Runtime(SelectedNode) is null)
            {
                _runtime = RuntimeKind.Vllm; // the new node runs no llama.cpp: the option is gone
            }
        }
        else if (IsMlx && MlxEditing.Runtime(SelectedNode) is null)
        {
            _runtime = RuntimeKind.Vllm; // the new node runs no MLX: the option is gone
            RecomputeMlx();
        }

        _catalog = await ModelSourcing.GetCatalogAsync(Services, SourceNodeId, _model.Image);
        await LoadFoldersAsync();
        if (IsNew)
        {
            await StopPollingAsync(); // a download followed on the node just left keeps running there
            await AttachToNodeDownloadAsync();
        }

        await RefreshFitAsync();
    }

    private async Task OnGpusChangedAsync(IReadOnlyList<string> gpus)
    {
        _gpus = gpus;
        if (IsLlamaCpp)
        {
            // Budgets belong to a GPU set and order: another set starts from the capacity split, the stored set gets its own back.
            _llama.GpuBudgets = _original?.Placement?.GpuUuids is { } stored && stored.SequenceEqual(gpus, StringComparer.Ordinal) &&
                _original.LlamaCpp?.GpuBudgetsGiB is { } budgets
                    ? [.. budgets.Select(b => (double?)b)]
                    : [];
            RecomputeLlama();
        }

        await RefreshFitAsync();
    }

    /// <summary>
    /// The live fit preview (design §6.2, MN-108's <see cref="PlacementFit"/>): per node without a GPU selection (every GPU
    /// a single-GPU option on discrete nodes), and for the ticked GPUs on the selected node. Never refuses: the agent decides.
    /// </summary>
    private async Task RefreshFitAsync()
    {
        if (!_multiNode || _fitPreview is not { } fit)
        {
            return;
        }

        var draft = Draft(IsNew ? _model.Id : Id!, _original) with { Placement = null };
        var fits = new Dictionary<string, NodeFitResult?>(StringComparer.Ordinal);
        foreach (var node in _nodes)
        {
            fits[node.Id] = await TryFitAsync(fit, node.Id, new NodeFitRequest { Definition = draft });
        }

        _nodeFits = fits;
        _fit = SelectedNode is not { } selected
            ? null
            : selected.Discrete && _gpus.Count > 0
                ? await TryFitAsync(fit, selected.Id, new NodeFitRequest
                {
                    Definition = draft with { Placement = PlacementEditing.Build(selected.Id, _gpus, selected.Gpus, 0) },
                    GpuUuids = _gpus,
                })
                : fits.GetValueOrDefault(selected.Id);
    }

    private static async Task<NodeFitResult?> TryFitAsync(PlacementFit fit, string nodeId, NodeFitRequest request)
    {
        try
        {
            return await fit.CheckAsync(nodeId, request);
        }
        catch (Exception ex) when (ex is ArgumentException or KeyNotFoundException or NotSupportedException)
        {
            return null; // no positive budget typed yet, or a node registry that cannot answer: no hint
        }
    }

    private async Task RefreshMoveAsync()
    {
        _move = !IsNew && _moves is { } moves ? await moves.GetAsync(Id!) : null;
    }

    private async Task OpenMoveAsync(bool progress)
    {
        if (_moveDialog is not null)
        {
            await _moveDialog.OpenAsync(progress);
        }
    }

    private void OpenUnplace() => _unplace?.Open();

    /// <summary>
    /// A move started or ended, or the model was unplaced or started: re-read the stored model (its placement and
    /// generation, which the next save must carry) and its state. The form's unsaved edits are kept.
    /// </summary>
    private async Task AfterMoveChangedAsync()
    {
        if (IsNew || await Registry.GetAsync(Id!) is not { } current)
        {
            return;
        }

        _original = current;
        ResetPlacementFrom(current);
        var status = await Runtime.GetStatusAsync(Id!);
        _runningState = status.State;
        _deleteDisabled = status.State is ModelState.Starting or ModelState.Ready or ModelState.Stopping;
        _ownBudgetInUseGiB = _deleteDisabled ? current.MemoryBudgetGiB : 0;
        await RefreshNodesAsync();
        await RefreshFitAsync();
        await RefreshMoveAsync();
        StateHasChanged();
    }

    private void StartLiveRefresh()
    {
        _liveCts = new CancellationTokenSource();
        _liveLoop = LiveRefreshAsync(_liveCts.Token);
    }

    private async Task LiveRefreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(LiveRefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    if (ct.IsCancellationRequested)
                    {
                        return;
                    }

                    bool wasMoving = _move is { Active: true };
                    await RefreshNodesAsync();
                    await RefreshFitAsync();
                    await RefreshMoveAsync();
                    if (wasMoving && _move is not { Active: true })
                    {
                        await AfterMoveChangedAsync(); // the move ended while its dialog was closed
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The page went away.
        }
        catch (ObjectDisposedException)
        {
            // The host is shutting down.
        }
    }

    /// <summary>
    /// The placement edits on top of <paramref name="definition"/> (several nodes only): a new model's node and GPUs; an
    /// existing model's GPUs on its node when they changed (sent with the stored generation, D75), else the placement as
    /// re-read; and the keep-serving flag.
    /// </summary>
    private ModelDefinition WithPlacementEdits(ModelDefinition definition)
    {
        if (!_multiNode)
        {
            return definition;
        }

        definition = definition with { KeepServingDuringJobs = _keepServing };
        if (IsNew)
        {
            return SelectedNode is { } node
                ? definition with { Placement = PlacementEditing.Build(node.Id, node.Discrete ? _gpus : [], node.Gpus, 0) }
                : definition;
        }

        if (_original?.Placement is { } stored && PlacementEditing.GpusChanged(stored, _gpus))
        {
            var gpus = SelectedNode?.Gpus ?? [];
            return definition with { Placement = PlacementEditing.Build(stored.NodeId, _gpus, gpus, stored.Generation) };
        }

        return definition;
    }

    private void OnImageChanged()
    {
        // The stored digest belongs to the stored image (D85): picking another image drops it unless one is typed.
        if (_original is not null && !string.Equals(_model.Image, _original.Image, StringComparison.Ordinal) &&
            string.Equals(_model.ImageDigest, _original.ImageDigest ?? "", StringComparison.Ordinal))
        {
            _model.ImageDigest = "";
        }
    }

    /// <summary>
    /// The downloader of the node the new model goes to: the injected one (the bootstrap node's), or one for the chosen
    /// node when the master composes agent clients (design §12.2: "Download from Hugging Face" acts on the selected node).
    /// </summary>
    private IHuggingFaceDownloader NodeDownloader()
    {
        if (!_multiNode || _nodeId is not { } node)
        {
            return Downloader;
        }

        if (Downloader is RemoteHuggingFaceDownloader own ? own.NodeId == node : node == BootstrapNodeId)
        {
            return Downloader;
        }

        return Services.GetService<MirbadLLM.Agent.Contracts.IAgentClientFactory>() is { } clients &&
            Services.GetService<MirbadLLM.Orchestration.Agents.AgentOperationRunner>() is { } runner
                ? new RemoteHuggingFaceDownloader(node, clients, runner)
                : Downloader;
    }

    private double _ownBudgetInUseGiB;

    // --- Tags ---

    /// <summary>The tags as chosen; on a new model they only take over from the suggestions once touched.</summary>
    private List<string> _tags = [];
    private bool _tagsTouched;
    private string _tagInput = "";
    private string? _tagError;

    /// <summary>Folder the editor's own download went into, so its recorded source is dropped if another folder is picked.</summary>
    private string? _autoSourceFolder;

    /// <summary>Folders of the node's other running downloads while one found on load is followed.</summary>
    private IReadOnlyList<string> _otherDownloads = [];

    private IReadOnlyList<string> SuggestedTags =>
        IsLlamaCpp
            ? LlamaCppEditing.SuggestTags(_llama)
            : IsMlx
            ? MlxEditing.SuggestTags(MemoryInspection)
            : ModelTags.Suggest(_model.ToDefinition(_model.Id), MemoryInspection?.Architecture, MemoryInspection?.HasVisionConfig ?? false);

    /// <summary>A new model whose tags were not touched shows (and saves) the suggestions; otherwise the chosen tags.</summary>
    private IReadOnlyList<string> EffectiveTags => IsNew && !_tagsTouched ? SuggestedTags : _tags;

    private List<string> CustomTags => EffectiveTags.Where(t => !ModelTags.IsBuiltIn(t)).ToList();

    private List<string> UnappliedSuggestions => SuggestedTags.Where(t => !EffectiveTags.Contains(t)).ToList();

    private void TouchTags()
    {
        if (!_tagsTouched)
        {
            _tags = [.. EffectiveTags];
            _tagsTouched = true;
        }
    }

    private void ToggleTag(string tag)
    {
        TouchTags();
        _tagError = null;
        if (!_tags.Remove(tag))
        {
            AddTag(tag);
        }
    }

    private void AddTag(string tag)
    {
        if (_tags.Contains(tag))
        {
            return;
        }

        if (_tags.Count >= ModelTags.MaxTags)
        {
            _tagError = $"A model can have at most {ModelTags.MaxTags} tags. Remove one first.";
            return;
        }

        _tags.Add(tag);
    }

    private void AddCustomTag()
    {
        _tagError = null;
        if (string.IsNullOrWhiteSpace(_tagInput))
        {
            return;
        }

        string? tag = ModelTags.Normalize(_tagInput);
        if (tag is null)
        {
            _tagError = $"\"{_tagInput.Trim()}\" can't be a tag: use 1–{ModelTags.MaxLength} letters, digits or hyphens.";
            return;
        }

        TouchTags();
        AddTag(tag);
        if (_tagError is null)
        {
            _tagInput = "";
        }
    }

    private void AddSuggestedTags()
    {
        TouchTags();
        _tagError = null;
        foreach (string tag in UnappliedSuggestions)
        {
            AddTag(tag);
        }
    }

    private void RemoveTag(string tag)
    {
        TouchTags();
        _tagError = null;
        _tags.Remove(tag);
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCustomTag();
        }
    }

