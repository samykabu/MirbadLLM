    /// <summary>What saving would lift out of the raw extra args (live, as the operator types).</summary>
    private NormalizedDefinition ExtraArgsPreview =>
        VllmArgsNormalizer.Normalize(WithPlacementEdits(_model.ToDefinition(string.IsNullOrEmpty(_model.Id) ? "preview" : _model.Id, IsNew ? null : _original)));

