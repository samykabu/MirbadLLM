    /// <summary>The node's checkpoint folders; an unreachable node empties the list and says why (W4 review MN-096).</summary>
    private async Task LoadFoldersAsync()
    {
        if (NeedsNode)
        {
            _folders = [];
            _entries = [];
            _folderError = null;
            return;
        }

        try
        {
            if (IsLlamaCpp)
            {
                // A GGUF folder has no config.json, so llama.cpp lists every finished folder.
                _entries = await ModelSourcing.ListFolderEntriesAsync(Services, SourceNodeId);
            }
            else
            {
                _folders = await ModelSourcing.ListFoldersAsync(Services, SourceNodeId);
            }

            _folderError = null;
        }
        catch (NodeUnavailableException ex)
        {
            _folders = [];
            _entries = [];
            _folderError = ex.Message;
        }
    }

    private async Task ApplyFolderAsync(string folder)
    {
        if (IsLlamaCpp)
        {
            await ApplyGgufFolderAsync(folder, _pendingGgufFile);
            return;
        }

        _inspection = null;
        _suggestionFormula = null;
        if (string.IsNullOrEmpty(folder))
        {
            return;
        }

        try
        {
            _inspection = await ModelSourcing.InspectAsync(Services, SourceNodeId, folder);
        }
        catch (NodeUnavailableException ex)
        {
            _inspection = null;
            _folderError = ex.Message;
            return;
        }

        if (_inspection is null)
        {
            return;
        }

        if (_autoSourceFolder is not null && !string.Equals(_autoSourceFolder, folder, StringComparison.Ordinal))
        {
            // The download's repo describes a different folder than the one picked now.
            _model.SourceRepoId = "";
            _model.SourceRevision = "";
            _model.SourcePatternsText = "";
            _autoSourceFolder = null;
        }

        _model.ModelPath = folder;
        _model.Id = string.IsNullOrWhiteSpace(_model.Id) ? Slugify(folder) : _model.Id;
        _model.ServedName = string.IsNullOrWhiteSpace(_model.ServedName) ? _inspection.Suggestion.ServedName : _model.ServedName;
        _model.ToolCallParser = _inspection.Suggestion.ToolCallParser;
        _model.ReasoningParser = _inspection.Suggestion.ReasoningParser;
        _model.Quantization = _inspection.Suggestion.Quantization;
        _model.MemoryBudgetGiB = _inspection.Suggestion.MemoryBudgetGiB;
        _suggestionFormula = _inspection.Suggestion.MemoryBudgetFormula;
        _maxModelLenPresets = VllmOptionsCatalog.MaxModelLenPresetsFor(_inspection.MaxPositionEmbeddings);
        if (_inspection.MaxPositionEmbeddings is { } cap)
        {
            _model.MaxModelLen = Math.Min(_model.MaxModelLen, cap);
        }

        _maxModelLenCustom = !_maxModelLenPresets.Contains(_model.MaxModelLen);
        if (IsMlx)
        {
            // The vLLM suggestions mean nothing to mlx_lm.server: no parsers, and the budget is MLX's own estimate.
            _model.ToolCallParser = null;
            _model.ReasoningParser = null;
            _model.Quantization = null;
            _suggestionFormula = null;
            RecomputeMlx();
        }

        await Task.CompletedTask;
    }

