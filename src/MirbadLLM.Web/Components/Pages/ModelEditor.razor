@page "/models/new"
@page "/models/{Id}"
@page "/models/{Id}/settings"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using MirbadLLM.Orchestration
@using MirbadLLM.Orchestration.Multinode
@using MirbadLLM.Orchestration.Nodes
@using MirbadLLM.Web.Components.ModelEditor
@inject IModelRegistry Registry
@inject IModelRuntime Runtime
@inject IMemoryProbe MemoryProbe
@inject Microsoft.Extensions.Options.IOptions<MirbadLLMOptions> SparkOptions
@inject IHuggingFaceDownloader Downloader
@inject IHuggingFaceRepoInspector RepoInspector
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>@(IsNew ? "Add model" : $"{_model.ServedName} · Settings") · MirbadLLM</PageTitle>

@if (_notFound)
{
    <PageHeader Title="Model settings" BackHref="models" BackLabel="Models" />
    <EmptyState Title="@($"No model called \"{Id}\"")" TestId="editor-not-found">
        <ChildContent><p>It may have been deleted. Add it again, or pick another model from the list.</p></ChildContent>
        <Actions>
            <a class="btn btn-primary" href="models/new"><Icon Name="plus" /> Add model</a>
            <a class="btn btn-outline-secondary" href="models">Go to Models</a>
        </Actions>
    </EmptyState>
}
else
{
    @if (IsNew)
    {
        <PageHeader Title="Add model" BackHref="models" BackLabel="Models">
            <Subtitle>
                @if (IsLlamaCpp)
                {
                    <span>Register a GGUF as a llama.cpp model. Fields fill in from its header; every setting has an info button.</span>
                }
                else if (IsMlx)
                {
                    <span>Register an MLX checkpoint folder as an MLX model. The estimate fills in from the folder; every setting has an info button.</span>
                }
                else
                {
                    <span>Register a checkpoint as a vLLM model. Fields fill in from the checkpoint; every setting has an info button.</span>
                }
            </Subtitle>
        </PageHeader>
    }
    else
    {
        <ModelHeader ModelId="@(Id ?? "")" Current="settings" StatusChanged="OnHeaderStatusAsync" />
        <p class="editor-lede" data-testid="editor-lede">
            Every setting is @(IsLlamaCpp ? "a llama-server" : IsMlx ? "an mlx_lm.server" : "a vLLM") launch argument: a running model picks changes up when it restarts. Saving asks whether to restart now.
        </p>
    }

    @if (_saveError is not null)
    {
        <div class="callout callout--failed page-alert" role="alert" data-testid="save-error">
            <Icon Name="state-failed" />
            <div class="callout-body">
                <span>@_saveError</span>
                @if (_saveErrorDetails.Count > 0)
                {
                    <ul class="plain-list" data-testid="save-error-details">
                        @foreach (string detail in _saveErrorDetails)
                        {
                            <li>@detail</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    @if (_saveNotice is not null)
    {
        <div class="callout callout--busy page-alert" role="status" data-testid="save-notice">
            <Icon Name="warning" />
            <div class="callout-body">@_saveNotice</div>
        </div>
    }

    @if (IsNew)
    {
        @* Add model is a wizard: every step's sections stay rendered (state, validation and the live fit keep working),
           and only the current step is shown. The stepper lets an expert jump to any step. *@
        <nav class="wizard-nav" aria-label="Add model steps" data-testid="wizard-steps">
            <ol class="wizard-steps" style="--wizard-count: @WizardSteps.Count">
                @for (int i = 0; i < WizardSteps.Count; i++)
                {
                    var step = WizardSteps[i];
                    bool locked = i > MaxOpenIndex;
                    string state = i == WizardIndex ? "current" : locked ? "locked" : StepComplete(step) && (i < WizardIndex || _visited.Contains(step)) ? "done" : "todo";
                    <li class="wizard-step wizard-step--@state">
                        <button type="button" class="wizard-step-btn" aria-current="@(state == "current" ? "step" : null)" disabled="@locked"
                                title="@(locked ? "Finish the steps before this one first" : null)"
                                data-testid="@($"wizard-step-{StepKey(step)}")" @ref="_stepButtons[step]" @onclick="() => GoToStepAsync(step)">
                            <span class="wizard-step-num" aria-hidden="true">
                                @if (state == "done")
                                {
                                    <Icon Name="check" />
                                }
                                else
                                {
                                    @(i + 1)
                                }
                            </span>
                            <span class="wizard-step-text">
                                <span class="wizard-step-label">@StepLabel(step)</span>
                                <span class="wizard-step-hint">@StepHint(step)</span>
                            </span>
                            @if (state == "done")
                            {
                                <span class="visually-hidden">, done</span>
                            }
                            else if (locked)
                            {
                                <span class="visually-hidden">, not available yet</span>
                            }
                        </button>
                    </li>
                }
            </ol>
            <div class="wizard-meter" aria-hidden="true"><span style="width: @WizardPercent%"></span></div>
        </nav>
    }

    <div class="form-sections@(IsNew ? " wizard" : null)">
        @if (_multiNode)
        {
            RenderFragment placement = @<PlacementSection Nodes="_nodes" IsNew="IsNew" NodeId="@_nodeId" NodeIdChanged="OnNodeChangedAsync" NodeMissing="_nodeMissing"
                              GpuUuids="_gpus" GpuUuidsChanged="OnGpusChangedAsync" StoredGpus="_original?.Placement?.GpuUuids"
                              NodeFits="_nodeFits" Fit="_fit" KeepServing="_keepServing" KeepServingChanged="v => _keepServing = v"
                              Move="_move" MovesAvailable="@(_moves is not null)"
                              OnMove="() => OpenMoveAsync(progress: false)" OnUnplace="OpenUnplace" OnViewMove="() => OpenMoveAsync(progress: true)"
                              Runtime="_runtime" RuntimeChanged="OnRuntimeChangedAsync" GpuBudgets="_llama.GpuBudgets" GpuBudgetsChanged="OnGpuBudgetsChangedAsync"
                              MemoryBudgetGiB="_model.MemoryBudgetGiB" TensorSplit="@LlamaTensorSplit" BudgetTooSmall="BudgetTooSmall" />;
            @if (IsNew)
            {
                <div class="wizard-wrap" data-wizard-step="where" hidden="@StepHidden(WizardStep.Where)">@placement</div>
            }
            else
            {
                @placement
            }
        }
        else if (IsNew && RuntimePicker.Offers(_singleNode, _runtime))
        {
            @* A fleet of one that offers a runtime choice: the runtime decides what a checkpoint is (a folder or a GGUF), so it comes first. *@
            <section class="panel form-section" aria-labelledby="sec-runtime" data-wizard-step="where" hidden="@StepHidden(WizardStep.Where)" data-testid="runtime-step">
                <div class="form-section-intro">
                    <h2 id="sec-runtime">Runtime</h2>
                    <p>@SingleNodeText serves models with more than one runtime. The runtime decides what a checkpoint is: @RuntimeCheckpointText.</p>
                </div>
                <div class="field-grid">
                    <RuntimePicker Node="_singleNode" IsNew="true" Runtime="_runtime" RuntimeChanged="OnRuntimeChangedAsync" />
                </div>
            </section>
        }

        @if (IsNew)
        {
            <section class="panel form-section" aria-labelledby="sec-source" data-wizard-step="checkpoint" hidden="@StepHidden(WizardStep.Checkpoint)">
                <div class="form-section-intro">
                    <h2 id="sec-source">Checkpoint</h2>
                    @if (IsLlamaCpp)
                    {
                        <p>llama-server serves one GGUF file from a folder under the node's models root.</p>
                    }
                    else if (IsMlx)
                    {
                        <p data-testid="mlx-checkpoint-hint">mlx_lm.server serves an MLX checkpoint folder under the node's models root: a <code>config.json</code> with <code>*.safetensors</code> and the tokenizer, e.g. a download of <code>mlx-community/Qwen3-0.6B-4bit</code>.</p>
                    }
                    else if (IsSharedContainer)
                    {
                        <p>@LlamaCppEditing.RuntimeName(_runtime) uses a checkpoint folder under the node's models root.</p>
                    }
                    else
                    {
                        <p>vLLM serves a checkpoint folder under the @(_multiNode ? "node's " : "")models root, mounted at <code>/models</code> in every container.</p>
                    }
                </div>
                <div class="field-grid">
                    <div class="field field--wide">
                        <FieldHelp Label="Checkpoint source" For="source-mode" ShowLabel="false" Help="@ModelFieldHelp.SourceMode">
                            <Leading><span class="field-label" id="source-mode-label">Checkpoint source</span></Leading>
                        </FieldHelp>
                        <div class="source-picker" role="radiogroup" aria-labelledby="source-mode-label">
                            <label class="source-option" data-testid="source-folder-tab">
                                <input type="radio" name="sourceMode" id="source-folder" checked="@(_source == SourceMode.Folder)" @onchange="() => SetSource(SourceMode.Folder)" />
                                <Icon Name="folder" Class="icon--lg" />
                                <span class="source-option-text">
                                    <span class="source-option-title">@FolderOptionTitle</span>
                                    <span class="source-option-note">Pick a checkpoint under the models root.</span>
                                </span>
                            </label>
                            <label class="source-option" data-testid="source-download-tab">
                                <input type="radio" name="sourceMode" id="source-download" checked="@(_source == SourceMode.Download)" @onchange="() => SetSource(SourceMode.Download)" />
                                <Icon Name="download" Class="icon--lg" />
                                <span class="source-option-text">
                                    <span class="source-option-title">Download from Hugging Face</span>
                                    <span class="source-option-note">Fetch a repo first, then configure it.</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    @if (_source == SourceMode.Folder && IsLlamaCpp)
                    {
                        <div class="field field--wide">
                            <FieldHelp Label="Folder" For="field-source-folder" Help="@ModelFieldHelp.ModelPath" />
                            <select class="form-select" id="field-source-folder" data-testid="field-source-folder"
                                    @bind="_selectedFolder" @bind:after="() => ApplyFolderAsync(_selectedFolder)">
                                <option value="">@(_folderError is not null ? "Folders unavailable" : NeedsNode ? "Choose the node under Placement first" : _entries.Count == 0 ? "No folders found under the models root" : "Choose a folder")</option>
                                @foreach (var entry in _entries)
                                {
                                    <option value="@entry.Folder">@entry.Folder · @UiFormat.Bytes(entry.SizeBytes)</option>
                                }
                            </select>
                            @if (_folderError is not null)
                            {
                                <div class="callout callout--failed" role="alert" data-testid="folder-error">
                                    <Icon Name="state-failed" /><div class="callout-body">@_folderError</div>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_selectedFolder))
                        {
                            <div class="field field--wide">
                                <GgufPicker Folder="@_selectedFolder" Candidates="_ggufCandidates" File="@_llama.File" FileChanged="f => _llama.File = f"
                                            OnRead="ReadGgufAsync" Summary="_gguf" Error="@_ggufError" Estimate="_estimate" Rooms="GgufRooms" />
                            </div>
                        }
                    }
                    else if (_source == SourceMode.Folder)
                    {
                        <div class="field field--wide">
                            <FieldHelp Label="Folder" For="field-source-folder" Help="@ModelFieldHelp.ModelPath" />
                            <select class="form-select" id="field-source-folder" data-testid="field-source-folder"
                                    aria-describedby="@(_inspection is null ? null : "folder-inspection")"
                                    @bind="_selectedFolder" @bind:after="() => ApplyFolderAsync(_selectedFolder)">
                                <option value="">@(_folderError is not null ? "Folders unavailable" : NeedsNode ? "Choose the node under Placement first" : _folders.Count == 0 ? "No checkpoint folders found under the models root" : "Choose a folder")</option>
                                @foreach (var folder in _folders)
                                {
                                    <option value="@folder.Folder">@folder.Folder · @folder.WeightsGiB.ToString("F1", CultureInfo.InvariantCulture) GiB · @folder.DetectedFormat</option>
                                }
                            </select>
                            @if (_folderError is not null)
                            {
                                <div class="callout callout--failed" role="alert" data-testid="folder-error">
                                    <Icon Name="state-failed" /><div class="callout-body">@_folderError</div>
                                </div>
                            }
                            @if (_inspection is not null)
                            {
                                <div class="field-hint" id="folder-inspection" data-testid="folder-inspection">
                                    Detected: @(_inspection.Architecture ?? "unknown architecture"), @_inspection.DetectedFormat,
                                    <span class="num">@_inspection.WeightsGiB.ToString("F1", CultureInfo.InvariantCulture) GiB</span> weights@(_inspection.MaxPositionEmbeddings is { } cap ? $", max context {cap:N0} tokens" : "")@(_inspection.MaySupportMtp ? ", may support MTP" : "").
                                    The fields below were filled in from it.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <FieldHelp Label="Repo id" For="field-repo-id" Help="@ModelFieldHelp.RepoId" />
                            <input class="form-control" id="field-repo-id" data-testid="field-repo-id" @bind="_download.RepoId" placeholder="owner/name" autocomplete="off" spellcheck="false" />
                        </div>
                        <div class="field">
                            <FieldHelp Label="Revision" For="field-revision" Help="@ModelFieldHelp.Revision" />
                            <input class="form-control" id="field-revision" data-testid="field-revision" @bind="_download.Revision" placeholder="Default branch" autocomplete="off" spellcheck="false" />
                        </div>
                        <div class="field">
                            <FieldHelp Label="Folder" For="field-download-folder" Help="@ModelFieldHelp.Folder" />
                            <input class="form-control" id="field-download-folder" data-testid="field-download-folder" @bind="_download.Folder" placeholder="From the repo name" autocomplete="off" spellcheck="false" />
                        </div>
                        <div class="field">
                            <FieldHelp Label="Access token (optional)" For="field-token" Help="@ModelFieldHelp.Token" />
                            <TokenPicker Id="field-token" TestId="field-token" @bind-Value="_download.TokenId" />
                        </div>
                        <div class="field field--wide">
                            <FieldHelp Label="Allow patterns" For="field-allow-patterns" Help="@ModelFieldHelp.AllowPatterns" />
                            <input class="form-control num" id="field-allow-patterns" data-testid="field-allow-patterns" @bind="_download.AllowPatternsText" spellcheck="false" />
                        </div>

                        <div class="field field--wide" aria-live="polite">
                            <div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="inspect-repo-button" @onclick="InspectRepoAsync">
                                    Inspect repo
                                </button>
                            </div>
                            @if (_inspectError is not null)
                            {
                                <div class="callout callout--failed" role="alert" data-testid="inspect-error">
                                    <Icon Name="state-failed" /><div class="callout-body">@_inspectError</div>
                                </div>
                            }
                            @if (_repoInspection is not null)
                            {
                                <div class="field-hint" data-testid="repo-format">Detected format: @FormatLabel(_repoInspection.Format)</div>

                                @if (IsLlamaCpp && _repoInspection.Variants.Count > 0)
                                {
                                    <div class="field field--wide">
                                        <FieldHelp Label="Variant" For="gguf-variants" ShowLabel="false" Help="@ModelFieldHelp.GgufVariant">
                                            <Leading><span class="field-label">Variant</span></Leading>
                                        </FieldHelp>
                                        <GgufPicker Variants="_repoInspection.Variants" Projectors="RepoProjectors" SelectedVariant="@_selectedVariant"
                                                    SelectedVariantChanged="SelectLlamaVariant" SelectedProjector="@_selectedProjector"
                                                    SelectedProjectorChanged="SelectProjector" Rooms="GgufRooms" />
                                    </div>
                                }
                                else if (IsLlamaCpp)
                                {
                                    <div class="field field--wide">
                                        <div class="callout callout--busy" data-testid="gguf-none">
                                            <Icon Name="warning" />
                                            <div class="callout-body">This repo has no GGUF files. llama.cpp serves a GGUF: pick a GGUF repo, or switch the runtime to vLLM.</div>
                                        </div>
                                    </div>
                                }
                                else if (IsMlx)
                                {
                                    @if (_repoInspection.Format == RepoFormat.Gguf)
                                    {
                                        <div class="field field--wide">
                                            <div class="callout callout--busy" data-testid="mlx-gguf-repo">
                                                <Icon Name="warning" />
                                                <div class="callout-body">This repo holds GGUF files only. MLX serves a folder of safetensors: pick an MLX repo (e.g. from mlx-community), or switch the runtime to llama.cpp.</div>
                                            </div>
                                        </div>
                                    }
                                }
                                else if (_repoInspection.Format is RepoFormat.Gguf or RepoFormat.Mixed && _repoInspection.Variants.Count > 0)
                                {
                                    <div class="field">
                                        <FieldHelp Label="Variant" For="field-gguf-variant" Help="@ModelFieldHelp.GgufVariant" />
                                        <select class="form-select num" id="field-gguf-variant" data-testid="field-gguf-variant"
                                                aria-describedby="@(SelectedVariant is null ? null : "gguf-variant-size")"
                                                @bind="_selectedVariant" @bind:after="() => SelectVariant(_selectedVariant)">
                                            @foreach (var variant in _repoInspection.Variants)
                                            {
                                                <option value="@variant.Name">@variant.Name — @variant.FileCount file@(variant.FileCount == 1 ? "" : "s"), @UiFormat.Bytes(variant.TotalBytes)</option>
                                            }
                                        </select>
                                        @if (SelectedVariant is { } sv)
                                        {
                                            <div class="field-hint" id="gguf-variant-size" data-testid="gguf-variant-size">
                                                <span class="num">@UiFormat.Bytes(sv.TotalBytes)</span> vs <span class="num">@UiFormat.GiB(_memory.AvailableGiB)</span> available on @(_multiNode ? "the bootstrap node" : "this box") right now
                                            </div>
                                        }
                                    </div>

                                    <div class="field field--wide">
                                        <div class="callout callout--busy" data-testid="gguf-runtime-note">
                                            <Icon Name="warning" />
                                            <div class="callout-body">
                                                MirbadLLM runs models with vLLM. vLLM's GGUF support is experimental, needs a single-file GGUF
                                                (split files must be merged first), and does not cover every architecture — this model may not start.
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="field field--wide" aria-live="polite">
                            @if (_downloadError is not null)
                            {
                                <div class="callout callout--failed" role="alert" data-testid="download-error">
                                    <Icon Name="state-failed" /><div class="callout-body">@_downloadError</div>
                                </div>
                            }

                            @if (_downloadStatus is null)
                            {
                                <div>
                                    <button type="button" class="btn btn-primary" data-testid="start-download-button" disabled="@NeedsNode" @onclick="StartDownloadAsync">
                                        <Icon Name="download" /> Start download
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="download" data-testid="download-progress">
                                    <div class="download-head">
                                        <span>State: <strong data-testid="download-state">@_downloadStatus.State</strong></span>
                                        @if (_downloadStatus.State is DownloadState.Downloading or DownloadState.Queued)
                                        {
                                            <span class="num muted">
                                                @UiFormat.Bytes(_downloadStatus.BytesDownloaded) of @(_downloadStatus.TotalBytes > 0 ? UiFormat.Bytes(_downloadStatus.TotalBytes) : "unknown size")@(_downloadStatus.BytesPerSecond is { } rate ? $" · {UiFormat.Bytes((long)rate)}/s" : "")
                                            </span>
                                        }
                                    </div>
                                    @if (_downloadStatus.State is DownloadState.Downloading or DownloadState.Queued)
                                    {
                                        var pct = DownloadPercent(_downloadStatus);
                                        <div class="progress-track" role="progressbar" aria-label="Download progress"
                                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct.ToString("F0", CultureInfo.InvariantCulture)"
                                             aria-valuetext="@($"{pct:F0}%, {UiFormat.Bytes(_downloadStatus.BytesDownloaded)} downloaded")">
                                            <div class="progress-fill" style="width:@(pct.ToString("F1", CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <div class="download-foot">
                                            <span class="num" data-testid="download-percent">@pct.ToString("F0", CultureInfo.InvariantCulture)%</span>
                                            <span class="muted">@(_downloadStatus.State == DownloadState.Queued ? "Waiting for the download container to start." : "Progress counts files as they finish, so it moves in steps.")@(_otherDownloads.Count > 0 ? $" Also downloading on this node: {string.Join(", ", _otherDownloads)}." : "")</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-testid="cancel-download-button" @onclick="CancelDownloadAsync">
                                                Cancel download
                                            </button>
                                        </div>
                                    }
                                    else if (_downloadStatus.State == DownloadState.Failed)
                                    {
                                        <div class="failure" data-testid="download-failed">
                                            <span><strong>Download failed:</strong> <span class="failure-cause">@UiFormat.FailureSummary(_downloadStatus.Error)</span></span>
                                            @if (!string.IsNullOrWhiteSpace(_downloadStatus.Error))
                                            {
                                                <details><summary>Full output</summary><pre>@_downloadStatus.Error</pre></details>
                                            }
                                        </div>
                                        <div>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="retry-download-button" @onclick="StartDownloadAsync">Retry download</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="dismiss-download-button" @onclick="CancelDownloadAsync">Dismiss</button>
                                        </div>
                                    }
                                    else if (_downloadStatus.State == DownloadState.Completed)
                                    {
                                        <div class="callout callout--ready" data-testid="download-complete">
                                            <Icon Name="state-ready" /><div class="callout-body">Download complete. The fields below were filled in from the checkpoint.</div>
                                        </div>
                                        <div><button type="button" class="btn btn-sm btn-outline-secondary" data-testid="dismiss-download-button" @onclick="CancelDownloadAsync">Dismiss</button></div>
                                    }
                                </div>
                            }
                        </div>

                        @if (IsLlamaCpp && _downloadStatus?.State == DownloadState.Completed && !string.IsNullOrEmpty(_selectedFolder))
                        {
                            <div class="field field--wide">
                                <GgufPicker Folder="@_selectedFolder" Candidates="_ggufCandidates" File="@_llama.File" FileChanged="f => _llama.File = f"
                                            OnRead="ReadGgufAsync" Summary="_gguf" Error="@_ggufError" Estimate="_estimate" Rooms="GgufRooms" />
                            </div>
                        }
                    }
                </div>
            </section>
        }

        <EditForm @ref="_form" Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSubmitAsync" data-testid="model-form" class="form-sections">
            <DataAnnotationsValidator />
            @if (IsNew && CurrentStep != WizardStep.Review)
            {
                @* The form's first submit button is its default one: disabled, it makes Enter in a field do nothing until the
                   review step, so a half-filled wizard is never added by accident. *@
                <button type="submit" class="wizard-enter-guard" disabled tabindex="-1" aria-hidden="true"></button>
            }

            <section class="panel form-section" aria-labelledby="sec-identity" data-wizard-step="@WizardAttr(WizardStep.Identity)" hidden="@StepHidden(WizardStep.Identity)">
                <div class="form-section-intro">
                    <h2 id="sec-identity">Identity</h2>
                    <p>How the controller and API clients refer to this model.</p>
                </div>
                <div class="field-grid">
                    <div class="field">
                        <FieldHelp Label="Id" For="field-id" Help="@ModelFieldHelp.Id" />
                        <InputText class="form-control num" id="field-id" @bind-Value="_model.Id" disabled="@(!IsNew)" data-testid="field-id" autocomplete="off" spellcheck="false"
                                   aria-describedby="field-id-error" />
                        <div id="field-id-error"><ValidationMessage For="() => _model.Id" /></div>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Served name" For="field-served-name" Help="@ModelFieldHelp.ServedName" />
                        <InputText class="form-control" id="field-served-name" @bind-Value="_model.ServedName" data-testid="field-served-name" autocomplete="off" spellcheck="false"
                                   aria-describedby="field-served-name-error" />
                        <div id="field-served-name-error"><ValidationMessage For="() => _model.ServedName" /></div>
                    </div>
                    @if (!_multiNode)
                    {
                        <div class="field">
                            <span class="field-label" id="field-node-label">Node</span>
                            <div class="field-static num" aria-labelledby="field-node-label" data-testid="field-node-readonly">@SingleNodeText</div>
                        </div>
                        @* The runtime is the node's property, not the fleet's (MN-239 item 3, D131): a fleet of one
                           Windows PC offers llama.cpp here. A node that reports none (the DGX) shows nothing new. *@
                        @if (!IsNew && RuntimePicker.Offers(_singleNode, _runtime))
                        {
                            <RuntimePicker Node="_singleNode" IsNew="IsNew" Runtime="_runtime" RuntimeChanged="OnRuntimeChangedAsync" />
                        }
                    }
                    <div class="field field--wide">
                        <FieldHelp Label="Model path" For="field-model-path" Help="@ModelFieldHelp.ModelPath" />
                        <InputText class="form-control num" id="field-model-path" @bind-Value="_model.ModelPath" data-testid="field-model-path" autocomplete="off" spellcheck="false"
                                   aria-describedby="field-model-path-error" />
                        <div id="field-model-path-error"><ValidationMessage For="() => _model.ModelPath" /></div>
                    </div>
                    <div class="field field--wide">
                        <FieldHelp Label="Tags" For="field-tag-input" ShowLabel="false" Help="@ModelFieldHelp.Tags">
                            <Leading><span class="field-label" id="tags-label">Tags</span></Leading>
                        </FieldHelp>
                        <div class="tag-editor" role="group" aria-labelledby="tags-label" aria-describedby="tags-hint" data-testid="tag-editor">
                            <div class="tag-editor-row">
                                @foreach (var info in ModelTags.BuiltIn)
                                {
                                    bool on = EffectiveTags.Contains(info.Id);
                                    bool suggested = SuggestedTags.Contains(info.Id);
                                    <button type="button" class="tag-toggle @(suggested ? "tag-toggle--suggested" : null)" aria-pressed="@(on ? "true" : "false")"
                                            title="@info.Description" data-testid="@($"tag-toggle-{info.Id}")" @onclick="() => ToggleTag(info.Id)">
                                        @if (on)
                                        {
                                            <Icon Name="check" />
                                        }
                                        <span>@info.Label</span>
                                        @if (suggested)
                                        {
                                            <span class="tag-suggested">· suggested</span>
                                        }
                                    </button>
                                }
                            </div>
                            @if (CustomTags.Count > 0)
                            {
                                <ul class="tag-list" aria-label="Custom tags" data-testid="tag-custom-list">
                                    @foreach (string tag in CustomTags)
                                    {
                                        <li class="tag-chip tag-chip--removable" data-testid="@($"tag-custom-{tag}")">
                                            @tag
                                            <button type="button" class="tag-remove" aria-label="@($"Remove tag {tag}")" data-testid="@($"tag-remove-{tag}")"
                                                    @onclick="() => RemoveTag(tag)">
                                                <Icon Name="close" />
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="tag-editor-add">
                                @* form="…" names no form, so Enter here adds the tag instead of submitting the editor. *@
                                <input class="form-control" id="field-tag-input" form="tag-input-detached" data-testid="field-tag-input" aria-label="Add a custom tag"
                                       placeholder="Add your own, e.g. long-context" autocomplete="off" spellcheck="false" maxlength="40"
                                       aria-describedby="@Described("tags-hint", _tagError is null ? null : "tag-error")" aria-invalid="@(_tagError is null ? null : "true")"
                                       @bind="_tagInput" @bind:event="oninput" @onkeydown="OnTagKeyDown" />
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="tag-add" @onclick="AddCustomTag">
                                    <Icon Name="plus" /> Add tag
                                </button>
                                @if (UnappliedSuggestions.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-ghost" data-testid="tag-add-suggested" @onclick="AddSuggestedTags">
                                        Add suggested (@UnappliedSuggestions.Count)
                                    </button>
                                }
                            </div>
                            @if (_tagError is not null)
                            {
                                <div class="validation-message" id="tag-error" role="alert" data-testid="tag-error">@_tagError</div>
                            }
                            <div class="field-hint" id="tags-hint" data-testid="tags-hint">
                                <span class="num">@EffectiveTags.Count</span> of <span class="num">@ModelTags.MaxTags</span>.
                                @(IsNew && !_tagsTouched ? "Prefilled with the suggested tags until you change them." : "Changing tags never needs a restart.")
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel form-section" aria-labelledby="sec-download-source" data-wizard-step="@WizardAttr(WizardStep.Identity)" hidden="@StepHidden(WizardStep.Identity)">
                <div class="form-section-intro">
                    <h2 id="sec-download-source">Source</h2>
                    <p>Where the checkpoint comes from, so a restore from a backup can download it again.</p>
                </div>
                <div class="field-grid">
                    @if (string.IsNullOrWhiteSpace(_model.SourceRepoId) && _model.ExtraSources.Count == 0)
                    {
                        <div class="field field--wide">
                            <div class="callout callout--busy" data-testid="no-source-hint">
                                <Icon Name="warning" />
                                <div class="callout-body">No download source — this model can't be re-downloaded after a restore. Add the Hugging Face repo it came from.</div>
                            </div>
                        </div>
                    }
                    <div class="field">
                        <FieldHelp Label="Repo id" For="field-source-repo" Help="@ModelFieldHelp.SourceRepo" />
                        <input class="form-control num" id="field-source-repo" data-testid="field-source-repo" @bind="_model.SourceRepoId"
                               placeholder="owner/name" autocomplete="off" spellcheck="false" aria-describedby="source-repo-hint" />
                        <div class="field-hint" id="source-repo-hint">
                            Downloads into <code>/models/@(string.IsNullOrWhiteSpace(_model.ModelPath) ? "…" : _model.ModelPath)</code> (the model path).
                        </div>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Revision" For="field-source-revision" Help="@ModelFieldHelp.SourceRevision" />
                        <input class="form-control num" id="field-source-revision" data-testid="field-source-revision" @bind="_model.SourceRevision"
                               placeholder="Default branch" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="field field--wide">
                        <FieldHelp Label="Allow patterns" For="field-source-patterns" Help="@ModelFieldHelp.SourceAllowPatterns" />
                        <input class="form-control num" id="field-source-patterns" data-testid="field-source-patterns" @bind="_model.SourcePatternsText"
                               placeholder="Download defaults" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="field field--wide">
                        <FieldHelp Label="Extra checkpoints" For="add-extra-source" ShowLabel="false" Help="@ModelFieldHelp.ExtraSources">
                            <Leading><span class="field-label" id="extra-sources-label">Extra checkpoints</span></Leading>
                        </FieldHelp>
                        @if (_model.ExtraSources.Count > 0)
                        {
                            <ul class="source-list" aria-labelledby="extra-sources-label" data-testid="extra-sources">
                                @for (int i = 0; i < _model.ExtraSources.Count; i++)
                                {
                                    var row = _model.ExtraSources[i];
                                    int n = i + 1;
                                    <li class="source-row" data-testid="@($"extra-source-{n}")">
                                        <div class="field">
                                            <label class="field-label" for="@($"extra-source-repo-{n}")">Repo id</label>
                                            <input class="form-control num" id="@($"extra-source-repo-{n}")" data-testid="@($"extra-source-repo-{n}")" @bind="row.RepoId"
                                                   placeholder="owner/name" autocomplete="off" spellcheck="false" />
                                        </div>
                                        <div class="field">
                                            <label class="field-label" for="@($"extra-source-folder-{n}")">Folder</label>
                                            <input class="form-control num" id="@($"extra-source-folder-{n}")" data-testid="@($"extra-source-folder-{n}")" @bind="row.Folder"
                                                   placeholder="Folder under /models" autocomplete="off" spellcheck="false" />
                                        </div>
                                        <div class="field">
                                            <label class="field-label" for="@($"extra-source-revision-{n}")">Revision</label>
                                            <input class="form-control num" id="@($"extra-source-revision-{n}")" @bind="row.Revision"
                                                   placeholder="Default branch" autocomplete="off" spellcheck="false" />
                                        </div>
                                        <div class="field">
                                            <label class="field-label" for="@($"extra-source-patterns-{n}")">Allow patterns</label>
                                            <input class="form-control num" id="@($"extra-source-patterns-{n}")" @bind="row.PatternsText"
                                                   placeholder="Download defaults" autocomplete="off" spellcheck="false" />
                                        </div>
                                        <div class="source-row-actions">
                                            <button type="button" class="btn btn-sm btn-ghost" aria-label="@($"Remove extra checkpoint {n}")"
                                                    data-testid="@($"remove-extra-source-{n}")" @onclick="() => _model.ExtraSources.Remove(row)">
                                                <Icon Name="trash" /> Remove
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="add-extra-source" data-testid="add-extra-source"
                                    @onclick="() => _model.ExtraSources.Add(new SourceRow())">
                                <Icon Name="plus" /> Add a checkpoint
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            @if (IsLlamaCpp && !IsNew)
            {
                <section class="panel form-section" aria-labelledby="sec-gguf" data-testid="llamacpp-gguf">
                    <div class="form-section-intro">
                        <h2 id="sec-gguf">GGUF</h2>
                        <p>The file llama-server loads from the model folder (<code>@_model.ModelPath</code>). Its header gives the estimate below.</p>
                    </div>
                    <div class="field-grid">
                        <div class="field field--wide">
                            <GgufPicker Folder="@_model.ModelPath" Candidates="_ggufCandidates" File="@_llama.File" FileChanged="f => _llama.File = f"
                                        OnRead="ReadGgufAsync" Summary="_gguf" Error="@_ggufError" Estimate="_estimate" Rooms="GgufRooms" />
                        </div>
                    </div>
                </section>
            }

            @if (IsLlamaCpp)
            {
                RenderFragment llama = @<LlamaCppSection Form="_llama" OnChanged="OnLlamaChangedAsync" Summary="_gguf" Estimate="_estimate" EstimateError="@(_estimateError ?? _ggufError)"
                                 MemoryBudgetGiB="_model.MemoryBudgetGiB" MemoryBudgetGiBChanged="OnLlamaBudgetChangedAsync" Fit="@(_multiNode ? _fit : null)"
                                 Versions="LlamaVersions" AutoStart="_model.AutoStart" AutoStartChanged="v => _model.AutoStart = v" />;
                @if (IsNew)
                {
                    <div class="wizard-wrap" data-wizard-step="memory" hidden="@StepHidden(WizardStep.Memory)">@llama</div>
                }
                else
                {
                    @llama
                }
            }
            else if (IsMlx)
            {
                RenderFragment mlx = @<MlxSection Form="_mlx" OnChanged="OnMlxChangedAsync" Inspection="MemoryInspection" Estimate="_mlxEstimate"
                                 MemoryBudgetGiB="_model.MemoryBudgetGiB" MemoryBudgetGiBChanged="OnLlamaBudgetChangedAsync" Fit="@(_multiNode ? _fit : null)"
                                 Versions="MlxVersions" AutoStart="_model.AutoStart" AutoStartChanged="v => _model.AutoStart = v" />;
                @if (IsNew)
                {
                    <div class="wizard-wrap" data-wizard-step="memory" hidden="@StepHidden(WizardStep.Memory)">@mlx</div>
                }
                else
                {
                    @mlx
                }
            }
            else if (IsSharedContainer)
            {
                <section class="panel form-section" aria-labelledby="sec-container-runtime" data-wizard-step="@WizardAttr(WizardStep.Memory)" hidden="@StepHidden(WizardStep.Memory)" data-testid="container-runtime-settings">
                    <div class="form-section-intro">
                        <h2 id="sec-container-runtime">@LlamaCppEditing.RuntimeName(_runtime) container</h2>
                        <p>Use an explicit image. MirbadLLM owns the model path, served name, host and port; extra arguments are appended last.</p>
                    </div>
                    <div class="field-grid">
                        <div class="field"><FieldHelp Label="Memory budget (GiB)" For="field-memory-budget" Help="@ModelFieldHelp.MemoryBudgetGiB" /><InputNumber class="form-control num" id="field-memory-budget" @bind-Value="_model.MemoryBudgetGiB" /></div>
                        <div class="field field--wide"><label class="field-label" for="field-image">Image</label><InputText class="form-control num" id="field-image" data-testid="field-image" @bind-Value="_model.Image" /></div>
                        <div class="field field--wide"><label class="field-label" for="field-image-digest">Image digest</label><InputText class="form-control num" id="field-image-digest" data-testid="field-image-digest" @bind-Value="_model.ImageDigest" placeholder="@(_runtime == RuntimeKind.Nim ? "sha256:… (required)" : "sha256:…")" /></div>
                        <div class="field field--wide"><label class="field-label" for="field-extra-args">Extra args (one per line)</label><InputTextArea class="form-control num" id="field-extra-args" data-testid="field-extra-args" rows="4" @bind-Value="_model.ExtraArgsText" /></div>
                        <div class="field field--wide"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_model.AutoStart" /><span>Start automatically</span></label></div>
                    </div>
                </section>
            }
            else
            {
            <section class="panel form-section" aria-labelledby="sec-memory" data-wizard-step="@WizardAttr(WizardStep.Memory)" hidden="@StepHidden(WizardStep.Memory)">
                <div class="form-section-intro">
                    <h2 id="sec-memory">Memory and context</h2>
                    <p>The budget is checked against free memory before the model starts, so it must cover weights, KV cache and activations.</p>
                </div>
                <div class="field-grid">
                    <div class="field">
                        <FieldHelp Label="Memory budget (GiB)" For="field-memory-budget" Help="@ModelFieldHelp.MemoryBudgetGiB" />
                        <InputNumber class="form-control num" id="field-memory-budget" @bind-Value="_model.MemoryBudgetGiB" @bind-Value:after="RefreshFitAsync" data-testid="field-memory-budget"
                                     aria-describedby="field-memory-budget-error memory-budget-hint" />
                        <div id="field-memory-budget-error"><ValidationMessage For="() => _model.MemoryBudgetGiB" /></div>
                        <div class="field-hint" id="memory-budget-hint" data-testid="memory-budget-hint">
                            @if (_suggestionFormula is not null)
                            {
                                <div>Suggested: <span class="num">@_suggestionFormula</span></div>
                            }
                            @if (BudgetTooSmall && MemoryInspection is { } mi)
                            {
                                <div class="budget-check budget-check--over" data-testid="memory-budget-too-small">
                                    <Icon Name="warning" />
                                    <span>Too small for this context: one <span class="num">@_model.MaxModelLen.ToString("N0", CultureInfo.InvariantCulture)</span>-token request needs about <span class="num">@UiFormat.GiB(Math.Ceiling(mi.MinimumBudgetGiB(_model.MaxModelLen)))</span> (<span class="num">@mi.WeightsGiB.ToString("F1", CultureInfo.InvariantCulture)</span> weights + <span class="num">@ModelFolderInspector.RuntimeOverheadGiB.ToString("F1", CultureInfo.InvariantCulture)</span> runtime + <span class="num">@mi.KvGiB(_model.MaxModelLen).ToString("F1", CultureInfo.InvariantCulture)</span> KV cache GiB). vLLM will refuse to start. Raise the budget or lower Max model len.</span>
                                </div>
                            }
                            @if (_multiNode && _fit is { } fit)
                            {
                                @* A budget below the model's minimum never "fits", even when the node has room for it. *@
                                bool roomButTooSmall = fit.Fits == true && BudgetTooSmall;
                                <div class="budget-check @(fit.Fits == false || roomButTooSmall ? "budget-check--over" : fit.Fits == true ? "budget-check--ok" : null)" data-testid="memory-budget-fit"
                                     data-fits="@(roomButTooSmall ? "too-small" : fit.Fits switch { true => "true", false => "false", _ => "unknown" })">
                                    <Icon Name="@(fit.Fits == true && !roomButTooSmall ? "check" : "warning")" />
                                    <span>@(roomButTooSmall ? RoomButTooSmallText(_nodeId) : fit.Message)</span>
                                </div>
                            }
                            @if (ShowBudgetCheck)
                            {
                                @if (_model.MemoryBudgetGiB > FreeAfterReserve)
                                {
                                    <div class="budget-check budget-check--over" data-testid="memory-budget-warning">
                                        <Icon Name="warning" />
                                        <span>Won't fit right now: needs <span class="num">@UiFormat.GiB(_model.MemoryBudgetGiB)</span>, <span class="num">@UiFormat.GiB(Math.Max(0, FreeAfterReserve))</span> free after the <span class="num">@UiFormat.GiB(_reserveGiB)</span> reserve. You can still save it; starting will ask you to confirm.</span>
                                    </div>
                                }
                                else if (BudgetTooSmall)
                                {
                                    <div class="budget-check budget-check--over" data-testid="memory-budget-room-too-small">
                                        <Icon Name="warning" />
                                        <span>@RoomButTooSmallText(null)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="budget-check budget-check--ok">
                                        <Icon Name="check" />
                                        <span>Fits right now: <span class="num">@UiFormat.GiB(FreeAfterReserve)</span> free after the <span class="num">@UiFormat.GiB(_reserveGiB)</span> reserve (of <span class="num">@UiFormat.GiB(_memory.TotalGiB)</span>).</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Max model len" For="field-max-model-len" Help="@ModelFieldHelp.MaxModelLen" />
                        <select class="form-select num" id="field-max-model-len" data-testid="field-max-model-len" @bind="MaxModelLenSelection"
                                aria-describedby="field-max-model-len-error" aria-invalid="@Invalid(context, () => _model.MaxModelLen)">
                            @foreach (int preset in _maxModelLenPresets)
                            {
                                <option value="@preset">@preset.ToString("N0", CultureInfo.InvariantCulture) tokens</option>
                            }
                            <option value="custom">Custom…</option>
                        </select>
                        @if (MaxModelLenSelection == "custom")
                        {
                            <InputNumber class="form-control num" @bind-Value="_model.MaxModelLen" data-testid="field-max-model-len-custom" aria-label="Custom max model len, in tokens"
                                         aria-describedby="field-max-model-len-error" />
                        }
                        <div id="field-max-model-len-error"><ValidationMessage For="() => _model.MaxModelLen" /></div>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Max num seqs" For="field-max-num-seqs" Help="@ModelFieldHelp.MaxNumSeqs" />
                        <select class="form-select num" id="field-max-num-seqs" data-testid="field-max-num-seqs" @bind="MaxNumSeqsSelection"
                                aria-describedby="field-max-num-seqs-error" aria-invalid="@Invalid(context, () => _model.MaxNumSeqs)">
                            @foreach (int preset in VllmOptionsCatalog.MaxNumSeqsPresets)
                            {
                                <option value="@preset">@preset</option>
                            }
                            <option value="custom">Custom…</option>
                        </select>
                        @if (MaxNumSeqsSelection == "custom")
                        {
                            <InputNumber class="form-control num" @bind-Value="_model.MaxNumSeqs" data-testid="field-max-num-seqs-custom" aria-label="Custom max num seqs"
                                         aria-describedby="field-max-num-seqs-error" />
                        }
                        <div id="field-max-num-seqs-error"><ValidationMessage For="() => _model.MaxNumSeqs" /></div>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Max batched tokens" For="field-max-num-batched-tokens" Help="@ModelFieldHelp.MaxNumBatchedTokens" />
                        <select class="form-select num" id="field-max-num-batched-tokens" data-testid="field-max-num-batched-tokens" @bind="MaxNumBatchedTokensSelection">
                            <option value="">vLLM default</option>
                            @foreach (int preset in MaxNumBatchedTokensPresets)
                            {
                                <option value="@preset">@preset.ToString("N0", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <FieldHelp Label="KV cache dtype" For="field-kv-cache-dtype" Help="@ModelFieldHelp.KvCacheDtype" />
                        <select class="form-select" id="field-kv-cache-dtype" data-testid="field-kv-cache-dtype" @bind="_model.KvCacheDtype"
                                aria-describedby="@Described("field-kv-cache-dtype-error", KvCacheDtypeHint is null ? null : "field-kv-cache-dtype-hint")"
                                aria-invalid="@Invalid(context, () => _model.KvCacheDtype)">
                            @foreach (var option in _catalog.KvCacheDtypes)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                        <div id="field-kv-cache-dtype-error"><ValidationMessage For="() => _model.KvCacheDtype" /></div>
                        @if (KvCacheDtypeHint is not null)
                        {
                            <div class="field-hint" id="field-kv-cache-dtype-hint" data-testid="field-kv-cache-dtype-hint">@KvCacheDtypeHint</div>
                        }
                    </div>
                    <div class="field">
                        <FieldHelp Label="Quantization" For="field-quantization" Help="@ModelFieldHelp.Quantization" />
                        <select class="form-select" id="field-quantization" data-testid="field-quantization" @bind="_model.Quantization"
                                aria-describedby="@(QuantizationHint is null ? null : "field-quantization-hint")">
                            @foreach (var option in _catalog.Quantizations)
                            {
                                <option value="@OptionValue(option.Value)">@option.Label</option>
                            }
                        </select>
                        @if (QuantizationHint is not null)
                        {
                            <div class="field-hint" id="field-quantization-hint" data-testid="field-quantization-hint">@QuantizationHint</div>
                        }
                    </div>
                </div>
            </section>

            <section class="panel form-section" aria-labelledby="sec-parsers" data-wizard-step="@WizardAttr(WizardStep.Tuning)" hidden="@StepHidden(WizardStep.Tuning)">
                <div class="form-section-intro">
                    <h2 id="sec-parsers">Parsers</h2>
                    <p>Turn the model's raw output into OpenAI tool calls and reasoning content. They must match the model family.</p>
                </div>
                <div class="field-grid">
                    <div class="field">
                        <FieldHelp Label="Tool call parser" For="field-tool-call-parser" Help="@ModelFieldHelp.ToolCallParser" />
                        <select class="form-select" id="field-tool-call-parser" data-testid="field-tool-call-parser" @bind="_model.ToolCallParser">
                            <option value="">None</option>
                            @foreach (string parser in _catalog.ToolCallParsers)
                            {
                                <option value="@parser">@parser</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Reasoning parser" For="field-reasoning-parser" Help="@ModelFieldHelp.ReasoningParser" />
                        <select class="form-select" id="field-reasoning-parser" data-testid="field-reasoning-parser" @bind="_model.ReasoningParser">
                            <option value="">None</option>
                            @foreach (string parser in _catalog.ReasoningParsers)
                            {
                                <option value="@parser">@parser</option>
                            }
                        </select>
                    </div>
                </div>
            </section>

            <section class="panel form-section" aria-labelledby="sec-performance" data-wizard-step="@WizardAttr(WizardStep.Tuning)" hidden="@StepHidden(WizardStep.Tuning)">
                <div class="form-section-intro">
                    <h2 id="sec-performance">Performance</h2>
                    <p>Compilation and decoding options. The defaults are the settings measured on this box.</p>
                </div>
                <div class="field-grid">
                    <div class="field">
                        <FieldHelp Label="CUDA graph mode" For="field-cuda-graph-mode" Help="@ModelFieldHelp.CudaGraphMode" />
                        <select class="form-select" id="field-cuda-graph-mode" data-testid="field-cuda-graph-mode" @bind="_model.CudaGraphMode"
                                aria-describedby="@(CudaGraphModeHint is null ? null : "field-cuda-graph-mode-hint")">
                            @foreach (var option in _catalog.CudaGraphModes)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                        @if (CudaGraphModeHint is not null)
                        {
                            <div class="field-hint" id="field-cuda-graph-mode-hint" data-testid="field-cuda-graph-mode-hint">@CudaGraphModeHint</div>
                        }
                    </div>
                    <div class="field">
                        <FieldHelp Label="Prefix caching" For="field-prefix-caching" Help="@ModelFieldHelp.EnablePrefixCaching" />
                        <select class="form-select" id="field-prefix-caching" data-testid="field-prefix-caching" @bind="_model.PrefixCaching">
                            <option value="">vLLM default</option>
                            <option value="on">On</option>
                            <option value="off">Off</option>
                        </select>
                    </div>
                    <div class="field">
                        <FieldHelp Label="Async scheduling" For="field-async-scheduling" Help="@ModelFieldHelp.AsyncScheduling" />
                        <select class="form-select" id="field-async-scheduling" data-testid="field-async-scheduling" @bind="_model.AsyncScheduling">
                            <option value="">vLLM default</option>
                            <option value="on">On</option>
                            <option value="off">Off</option>
                        </select>
                    </div>
                    @if (ShowMambaCacheMode)
                    {
                        <div class="field">
                            <FieldHelp Label="Mamba cache mode" For="field-mamba-cache-mode" Help="@ModelFieldHelp.MambaCacheMode" />
                            <select class="form-select" id="field-mamba-cache-mode" data-testid="field-mamba-cache-mode" @bind="_model.MambaCacheMode">
                                <option value="">vLLM default</option>
                                @foreach (string mode in MambaCacheModeOptions)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="field field--wide">
                        <FieldHelp Label="Other compilation-config keys (JSON)" For="field-compilation-config" Help="@ModelFieldHelp.CompilationConfig" />
                        <InputText class="form-control num" id="field-compilation-config" data-testid="field-compilation-config" @bind-Value="_model.CompilationExtraJson"
                                   placeholder="{}" spellcheck="false" />
                    </div>
                    <div class="field field--wide">
                        <FieldHelp Label="Speculative decoding" For="speculativeEnabled" ShowLabel="false" Help="@ModelFieldHelp.SpeculativeEnabled">
                            <Leading>
                                <div class="form-check form-switch switch-row">
                                    <InputCheckbox class="form-check-input" role="switch" @bind-Value="_model.SpeculativeEnabled" id="speculativeEnabled" data-testid="field-speculative-enabled" />
                                    <label class="form-check-label" for="speculativeEnabled">Speculative decoding</label>
                                </div>
                            </Leading>
                        </FieldHelp>
                    </div>
                    @if (_model.SpeculativeEnabled)
                    {
                        <div class="field">
                            <FieldHelp Label="Method" For="field-speculative-method" Help="@ModelFieldHelp.SpeculativeMethod" />
                            <select class="form-select" id="field-speculative-method" data-testid="field-speculative-method" @bind="_model.SpeculativeMethod"
                                    aria-describedby="@(SpeculativeMethodHint is null ? null : "field-speculative-method-hint")">
                                <option value="">None (inferred from the draft model)</option>
                                @foreach (var option in _catalog.SpeculativeMethods.Where(o => o.Value != "none"))
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                                @if (!string.IsNullOrEmpty(_model.SpeculativeMethod) && !_catalog.SpeculativeMethods.Any(o => o.Value == _model.SpeculativeMethod))
                                {
                                    <option value="@_model.SpeculativeMethod">@_model.SpeculativeMethod</option>
                                }
                            </select>
                            @if (SpeculativeMethodHint is not null)
                            {
                                <div class="field-hint" id="field-speculative-method-hint" data-testid="field-speculative-method-hint">@SpeculativeMethodHint</div>
                            }
                        </div>
                        <div class="field">
                            <FieldHelp Label="Num speculative tokens" For="field-speculative-num-tokens" Help="@ModelFieldHelp.SpeculativeNumTokens" />
                            <InputNumber class="form-control num" id="field-speculative-num-tokens" @bind-Value="_model.SpeculativeNumTokens"
                                         aria-describedby="field-speculative-num-tokens-error" />
                            <div id="field-speculative-num-tokens-error"><ValidationMessage For="() => _model.SpeculativeNumTokens" /></div>
                        </div>
                        <div class="field field--wide">
                            <FieldHelp Label="Draft model path" For="field-speculative-draft-model" Help="@ModelFieldHelp.SpeculativeDraftModel" />
                            <InputText class="form-control num" id="field-speculative-draft-model" data-testid="field-speculative-draft-model"
                                       @bind-Value="_model.SpeculativeDraftModel" placeholder="/models/…" spellcheck="false" />
                        </div>
                        <div class="field field--wide">
                            <FieldHelp Label="Advanced speculative keys (JSON)" For="field-speculative-extra" Help="@ModelFieldHelp.SpeculativeExtra" />
                            <InputText class="form-control num" id="field-speculative-extra" data-testid="field-speculative-extra"
                                       @bind-Value="_model.SpeculativeExtraJson" placeholder="{&quot;moe_backend&quot;:&quot;triton&quot;}" spellcheck="false" />
                        </div>
                    }
                    @if (NeedsPiecewiseAdvice)
                    {
                        <div class="field field--wide">
                            <div class="callout callout--busy" role="status" data-testid="mtp-piecewise-advice">
                                <Icon Name="warning" />
                                <div class="callout-body">
                                    <span>MTP on the GB10 needs PIECEWISE; FULL crashed in cuBLAS in Phase 0.</span>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="set-piecewise" @onclick="SetPiecewise">
                                            Set PIECEWISE
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel form-section" aria-labelledby="sec-container" data-wizard-step="@WizardAttr(WizardStep.Tuning)" hidden="@StepHidden(WizardStep.Tuning)">
                <div class="form-section-intro">
                    <h2 id="sec-container">Container</h2>
                    <p>The image the model runs in, raw vLLM arguments, and whether it starts with the controller.</p>
                </div>
                <div class="field-grid">
                    <div class="field field--wide">
                        <FieldHelp Label="Image override" For="field-image" Help="@ModelFieldHelp.Image" />
                        <select class="form-select num" id="field-image" data-testid="field-image" @bind="_model.Image" @bind:after="OnImageChanged">
                            <option value="" data-testid="field-image-default">@DefaultImageLabel</option>
                            @foreach (string image in _catalog.Images)
                            {
                                <option value="@image">@image</option>
                            }
                        </select>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_model.Image))
                    {
                        <div class="field field--wide">
                            <FieldHelp Label="Image digest" For="field-image-digest" Help="@ModelFieldHelp.ImageDigest" />
                            <input class="form-control num" id="field-image-digest" data-testid="field-image-digest" @bind="_model.ImageDigest"
                                   placeholder="sha256:… (needed on Linux PC nodes)" autocomplete="off" spellcheck="false"
                                   aria-describedby="@Described("field-image-digest-hint", DigestProblem is null ? null : "field-image-digest-error")"
                                   aria-invalid="@(DigestProblem is null ? null : "true")" />
                            @if (DigestProblem is not null)
                            {
                                <div class="validation-message" id="field-image-digest-error" data-testid="field-image-digest-error">@DigestProblem</div>
                            }
                            <div class="field-hint" id="field-image-digest-hint">
                                Pins this image to an approved digest. The DGX runs its locally built images by tag and needs none; a Linux PC node needs it.
                            </div>
                        </div>
                    }
                    <div class="field field--wide">
                        <FieldHelp Label="Extra args (one per line)" For="field-extra-args" Help="@ModelFieldHelp.ExtraArgs" />
                        <InputTextArea class="form-control num" id="field-extra-args" data-testid="field-extra-args" rows="3" @bind-Value="_model.ExtraArgsText" spellcheck="false"
                                       aria-describedby="field-extra-args-hint" />
                        <div class="field-hint" id="field-extra-args-hint">
                            Flags that have their own field above (speculative and compilation config, max num seqs, max batched tokens,
                            KV cache dtype, prefix caching, async scheduling, mamba cache mode@(_multiNode ? ", and the tensor parallel size when GPUs are ticked" : "")) are moved into that field when you save,
                            so each is passed to vLLM exactly once.
                        </div>
                        @if (ExtraArgsPreview.Lifted.Count > 0)
                        {
                            <div class="callout callout--busy" role="status" data-testid="extra-args-lifted">
                                <Icon Name="info" />
                                <div class="callout-body">
                                    <span>On save, these move into their fields:</span>
                                    <ul class="plain-list">
                                        @foreach (var lifted in ExtraArgsPreview.Lifted)
                                        {
                                            <li><code>@lifted.Flag</code> → @lifted.Field</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (ExtraArgsPreview.Problems.Count > 0)
                        {
                            <div class="callout callout--failed" role="alert" data-testid="extra-args-problems">
                                <Icon Name="state-failed" />
                                <div class="callout-body">@string.Join(" ", ExtraArgsPreview.Problems)</div>
                            </div>
                        }
                    </div>
                    <div class="field">
                        <FieldHelp Label="Auto-start on boot" For="autoStart" ShowLabel="false" Help="@ModelFieldHelp.AutoStart">
                            <Leading>
                                <div class="form-check form-switch switch-row">
                                    <InputCheckbox class="form-check-input" role="switch" @bind-Value="_model.AutoStart" id="autoStart" />
                                    <label class="form-check-label" for="autoStart">Start when the controller boots</label>
                                </div>
                            </Leading>
                        </FieldHelp>
                    </div>
                </div>
            </section>
            }

            @if (IsNew)
            {
                @WizardReview()
                <div class="form-footer wizard-footer" data-testid="wizard-footer">
                    @if (WizardIndex > 0)
                    {
                        <button type="button" class="btn btn-outline-secondary" data-testid="wizard-back" @onclick="BackStepAsync">
                            <Icon Name="back" /> Back
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary" href="models">Cancel</a>
                    }
                    <span class="wizard-count" data-testid="wizard-count">Step <span class="num">@(WizardIndex + 1)</span> of <span class="num">@WizardSteps.Count</span></span>
                    <span class="spacer"></span>
                    @if (CurrentStep != WizardStep.Review)
                    {
                        string? blocker = NextBlocker ?? _nextProblem;
                        @if (blocker is not null)
                        {
                            <span class="form-footer-note wizard-blocker" id="wizard-next-hint" data-testid="wizard-next-hint">@blocker</span>
                        }
                        <button type="button" class="btn btn-primary" data-testid="wizard-next" disabled="@(NextBlocker is not null)"
                                aria-describedby="@(blocker is null ? null : "wizard-next-hint")" @onclick="NextStepAsync">
                            Next: @StepLabel(WizardSteps[WizardIndex + 1]) <Icon Name="arrow-right" />
                        </button>
                    }
                    <button type="submit" class="btn btn-primary" data-testid="save-button" hidden="@(CurrentStep != WizardStep.Review)">
                        <Icon Name="plus" /> Add model
                    </button>
                </div>
            }
            else
            {
                <div class="form-footer">
                    <button type="submit" class="btn btn-primary" data-testid="save-button">Save changes</button>
                    <a class="btn btn-outline-secondary" href="models">Cancel</a>
                </div>
            }
        </EditForm>

        @if (!IsNew)
        {
            @* Destruction sits alone at the very end, away from Save (dashed red, its own seam). *@
            <section class="danger-zone" aria-labelledby="sec-danger" data-testid="danger-zone">
                <div class="danger-zone-text">
                    <h2 class="panel-label" id="sec-danger">Delete this model</h2>
                    <p class="muted">
                        Removes the definition from MirbadLLM. The checkpoint files stay on disk, so you can add it again later.
                        @if (_deleteDisabled)
                        {
                            <span id="delete-hint">Stop the model first: a running model can't be deleted.</span>
                        }
                    </p>
                </div>
                <button type="button" class="btn btn-outline-danger" disabled="@_deleteDisabled" data-testid="delete-button"
                        aria-describedby="@(_deleteDisabled ? "delete-hint" : null)" @onclick="() => _deleteOpen = true">
                    <Icon Name="trash" /> Delete model…
                </button>
            </section>
        }
    </div>

    <ApplyChangesDialog @ref="_apply" OnFinished="AfterApplyAsync" />

    @if (!IsNew && _multiNode && _original is not null)
    {
        <MoveModelDialog @ref="_moveDialog" Model="_original" Nodes="_nodes" Running="IsRunning" OnChanged="AfterMoveChangedAsync" />
        <UnplaceModelDialog @ref="_unplace" Model="_original" Running="IsRunning" OnUnplaced="AfterMoveChangedAsync" />
    }

    @if (!IsNew)
    {
        <ConfirmDialog @bind-Open="_deleteOpen" Title="@($"Delete {Id}?")" ConfirmLabel="Delete model" Destructive="true"
                       OnConfirm="DeleteAsync" TestId="delete-dialog" ConfirmTestId="confirm-delete">
            <p>
                This removes the model definition from MirbadLLM. The checkpoint files in
                <code>/models/@_model.ModelPath</code> stay on disk, so you can add the model again later.
            </p>
        </ConfirmDialog>
    }
}

@code {
    private enum SourceMode { Folder, Download }

    [Parameter]
    public string? Id { get; set; }

    /// <summary><c>?source=download</c> opens the Hugging Face download tab (used by the empty states).</summary>
    [SupplyParameterFromQuery(Name = "source")]
    public string? SourceQuery { get; set; }

    /// <summary><c>?node=</c> preselects the node of a new model when the master has several (e.g. from a node's page).</summary>
    [SupplyParameterFromQuery(Name = "node")]
    public string? NodeQuery { get; set; }

    private bool IsNew => string.IsNullOrEmpty(Id);

    // ---------- Add model wizard ----------
    // Every step's sections stay rendered so state, validation and the live fit keep working; only the current one is
    // shown. Settings (edit) keeps the single long form.
    private enum WizardStep { Where, Checkpoint, Identity, Memory, Tuning, Review }

    private WizardStep _step = WizardStep.Where;
    private readonly Dictionary<WizardStep, ElementReference> _stepButtons = [];
    private bool _focusStep;

    private bool HasWhereStep => _multiNode || RuntimePicker.Offers(_singleNode, _runtime);

    private List<WizardStep> WizardSteps
    {
        get
        {
            var steps = new List<WizardStep>(6);
            if (HasWhereStep)
            {
                steps.Add(WizardStep.Where);
            }

            steps.Add(WizardStep.Checkpoint);
            steps.Add(WizardStep.Identity);
            steps.Add(WizardStep.Memory);
            if (!IsLlamaCpp && !IsMlx)
            {
                // llama.cpp and MLX keep their performance settings and auto-start in their own settings section.
                steps.Add(WizardStep.Tuning);
            }

            steps.Add(WizardStep.Review);
            return steps;
        }
    }

    /// <summary>The step shown; when the list changes under it (llama.cpp drops Tuning) the nearest earlier step.</summary>
    private WizardStep CurrentStep
    {
        get
        {
            var steps = WizardSteps;
            return steps.Contains(_step) ? _step : steps.LastOrDefault(s => s < _step, steps[0]);
        }
    }

    private int WizardIndex => WizardSteps.IndexOf(CurrentStep);

    private string WizardPercent =>
        (WizardSteps.Count <= 1 ? 100 : 100.0 * WizardIndex / (WizardSteps.Count - 1)).ToString("F1", CultureInfo.InvariantCulture);

    private bool StepHidden(WizardStep step) => IsNew && CurrentStep != step;

    // Steps the operator has opened: a step only shows its check once it has been seen and holds what it needs.
    private readonly HashSet<WizardStep> _visited = [WizardStep.Where];

    private bool StepComplete(WizardStep step) => step switch
    {
        WizardStep.Where => !NeedsNode,
        WizardStep.Checkpoint => !string.IsNullOrWhiteSpace(_model.ModelPath) && (!IsLlamaCpp || !string.IsNullOrWhiteSpace(_llama.File)),
        WizardStep.Identity => !string.IsNullOrWhiteSpace(_model.Id) && !string.IsNullOrWhiteSpace(_model.ServedName),
        WizardStep.Review => false,
        _ => _visited.Contains(step),
    };

    private string? WizardAttr(WizardStep step) => IsNew ? StepKey(step) : null;

    private static string StepKey(WizardStep step) => step.ToString().ToLowerInvariant();

    private string StepLabel(WizardStep step) => step switch
    {
        WizardStep.Where => _multiNode ? "Placement" : "Runtime",
        WizardStep.Checkpoint => "Checkpoint",
        WizardStep.Identity => "Name and tags",
        WizardStep.Memory => IsLlamaCpp ? "llama.cpp settings" : IsMlx ? "MLX settings" : "Memory",
        WizardStep.Tuning => "Tuning",
        _ => "Review",
    };

    private string StepHint(WizardStep step) => step switch
    {
        WizardStep.Where => _multiNode ? "Node and GPUs" : RuntimeChoiceText,
        WizardStep.Checkpoint => "A folder or a download",
        WizardStep.Identity => "Id, served name, source",
        WizardStep.Memory => IsLlamaCpp ? "Context, offload, budget" : IsMlx ? "Context, cache, budget" : "Budget and context",
        WizardStep.Tuning => "Parsers, speed, image",
        _ => "Check and add",
    };

    /// <summary>Why Next is not available yet, or null. Only what a later step cannot work without is required here.</summary>
    private string? NextBlocker => CurrentStep switch
    {
        WizardStep.Where when NeedsNode => "Choose a node first.",
        WizardStep.Checkpoint when string.IsNullOrWhiteSpace(_model.ModelPath) =>
            _source == SourceMode.Download ? "Finish the download, or pick a folder instead." : "Choose a checkpoint folder.",
        WizardStep.Checkpoint when IsLlamaCpp && string.IsNullOrWhiteSpace(_llama.File) => "Choose the GGUF file.",
        WizardStep.Identity when string.IsNullOrWhiteSpace(_model.Id) || string.IsNullOrWhiteSpace(_model.ServedName) =>
            "Fill in the id and the served name.",
        _ => null,
    };

    // ---- Step order ----
    // Steps open strictly in sequence: up to the furthest step reached through Next (each Next checks its step), and
    // never past the first earlier step that has become incomplete again. Back, the stepper and Review's Edit links
    // only go to steps within that reach.
    private EditForm? _form;
    private WizardStep _furthest = WizardStep.Where;
    private string? _nextProblem;

    private int FurthestIndex
    {
        get
        {
            var steps = WizardSteps;
            int i = steps.FindLastIndex(s => s <= _furthest);
            return i < 0 ? 0 : i;
        }
    }

    /// <summary>The last step that may be opened now.</summary>
    private int MaxOpenIndex
    {
        get
        {
            var steps = WizardSteps;
            int max = Math.Max(FurthestIndex, WizardIndex);
            for (int i = 0; i < max; i++)
            {
                if (StepProblem(steps[i]) is not null)
                {
                    return i;
                }
            }

            return max;
        }
    }

    private static readonly string[] IdentityFields = [nameof(EditModel.Id), nameof(EditModel.ServedName), nameof(EditModel.ModelPath)];
    private static readonly string[] MemoryFields =
        [nameof(EditModel.MemoryBudgetGiB), nameof(EditModel.MaxModelLen), nameof(EditModel.MaxNumSeqs), nameof(EditModel.KvCacheDtype)];
    private static readonly string[] TuningFields = [nameof(EditModel.SpeculativeNumTokens)];

    private string[] StepFields(WizardStep step) => step switch
    {
        WizardStep.Identity => IdentityFields,
        WizardStep.Memory => IsLlamaCpp || IsMlx ? [nameof(EditModel.MemoryBudgetGiB)] : MemoryFields,
        WizardStep.Tuning => TuningFields,
        _ => [],
    };

    /// <summary>The model's own validation rules for these fields, checked directly (touched or not).</summary>
    private bool FieldsValid(string[] fields)
    {
        var context = new System.ComponentModel.DataAnnotations.ValidationContext(_model);
        foreach (string field in fields)
        {
            context.MemberName = field;
            object? value = typeof(EditModel).GetProperty(field)!.GetValue(_model);
            if (!System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(value, context, null))
            {
                return false;
            }
        }

        return true;
    }

    /// <summary>What keeps a step from being complete, or null. Next and the stepper both go by it.</summary>
    private string? StepProblem(WizardStep step)
    {
        string? required = step switch
        {
            WizardStep.Where when NeedsNode => "Choose a node first.",
            WizardStep.Checkpoint when string.IsNullOrWhiteSpace(_model.ModelPath) =>
                _source == SourceMode.Download ? "Finish the download, or pick a folder instead." : "Choose a checkpoint folder.",
            WizardStep.Checkpoint when IsLlamaCpp && string.IsNullOrWhiteSpace(_llama.File) => "Choose the GGUF file.",
            WizardStep.Identity when string.IsNullOrWhiteSpace(_model.Id) || string.IsNullOrWhiteSpace(_model.ServedName) =>
                "Fill in the id and the served name.",
            _ => null,
        };
        if (required is not null)
        {
            return required;
        }

        if (!FieldsValid(StepFields(step)))
        {
            return "Fix the fields marked in red first.";
        }

        return step switch
        {
            WizardStep.Memory when IsMlx && MlxSettingsProblem() is not null => "Fix the problems shown above first.",
            WizardStep.Memory when !IsLlamaCpp && BudgetTooSmall => "The budget is too small for this context: raise it or lower Max model len.",
            WizardStep.Tuning when ExtraArgsPreview.Problems.Count > 0 || DigestProblem is not null => "Fix the problems shown above first.",
            _ => null,
        };
    }

    private Task GoToStepAsync(WizardStep step)
    {
        if (IsNew && WizardSteps.IndexOf(step) > MaxOpenIndex)
        {
            return Task.CompletedTask;
        }

        return OpenStepAsync(step);
    }

    private Task OpenStepAsync(WizardStep step)
    {
        _visited.Add(CurrentStep);
        _step = step;
        _visited.Add(step);
        _nextProblem = null;
        _focusStep = true;
        return Task.CompletedTask;
    }

    private Task NextStepAsync()
    {
        if (NextBlocker is not null || WizardIndex >= WizardSteps.Count - 1)
        {
            return Task.CompletedTask;
        }

        // Show the step's own field messages, then hold the step while anything on it is wrong.
        if (_form?.EditContext is { } edit)
        {
            foreach (string field in StepFields(CurrentStep))
            {
                edit.NotifyFieldChanged(new FieldIdentifier(_model, field));
            }
        }

        _nextProblem = StepProblem(CurrentStep);
        if (_nextProblem is not null)
        {
            return Task.CompletedTask;
        }

        var next = WizardSteps[WizardIndex + 1];
        if (next > _furthest)
        {
            _furthest = next;
        }

        return OpenStepAsync(next);
    }

    private Task BackStepAsync() => WizardIndex > 0 ? GoToStepAsync(WizardSteps[WizardIndex - 1]) : Task.CompletedTask;

    /// <summary>An invalid Add opens the step that holds the first field to fix.</summary>
    private Task OnInvalidSubmitAsync(EditContext form)
    {
        if (!IsNew)
        {
            return Task.CompletedTask;
        }

        bool identity = Invalid(form, () => _model.Id) is not null || Invalid(form, () => _model.ServedName) is not null
            || Invalid(form, () => _model.ModelPath) is not null;
        bool memory = Invalid(form, () => _model.MemoryBudgetGiB) is not null || Invalid(form, () => _model.MaxModelLen) is not null;
        WizardStep target = identity ? WizardStep.Identity : memory || IsLlamaCpp || IsMlx ? WizardStep.Memory : WizardStep.Tuning;
        return OpenStepAsync(target);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStep && _stepButtons.TryGetValue(CurrentStep, out var button))
        {
            _focusStep = false;
            try
            {
                await button.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                // The circuit went away or the element was re-rendered: focus is a convenience only.
            }
        }
    }

    private RenderFragment WizardReview() => __builder =>
    {
        <section class="panel form-section wizard-review" aria-labelledby="sec-review" data-wizard-step="review"
                 hidden="@StepHidden(WizardStep.Review)" data-testid="wizard-review">
            <div class="form-section-intro">
                <h2 id="sec-review">Review</h2>
                <p>Check the choices, then add the model. Each row opens its step again.</p>
            </div>
            <dl class="review-list">
                @if (HasWhereStep)
                {
                    <div class="review-row">
                        <dt>@StepLabel(WizardStep.Where)</dt>
                        <dd>
                            <span class="review-value">
                                @if (_multiNode && _nodeId is null)
                                {
                                    <span class="state state--failed"><Icon Name="warning" /> No node chosen</span>
                                }
                                else
                                {
                                    <span class="num">@(_multiNode ? _nodeId : SingleNodeText)</span>
                                }
                                @if (_multiNode && _gpus.Count > 0)
                                {
                                    <span class="muted"> · <span class="num">@_gpus.Count</span> GPU@(_gpus.Count == 1 ? "" : "s")</span>
                                }
                                <span class="muted"> · @LlamaCppEditing.RuntimeName(_runtime)</span>
                            </span>
                            <button type="button" class="btn btn-sm btn-ghost" data-testid="review-edit-where" @onclick="() => GoToStepAsync(WizardStep.Where)">Edit</button>
                        </dd>
                    </div>
                }
                <div class="review-row">
                    <dt>Checkpoint</dt>
                    <dd>
                        <span class="review-value">
                            @if (string.IsNullOrWhiteSpace(_model.ModelPath))
                            {
                                <span class="state state--failed"><Icon Name="warning" /> No checkpoint chosen</span>
                            }
                            else
                            {
                                <code>/models/@_model.ModelPath</code>
                            }
                            @if (IsLlamaCpp && !string.IsNullOrWhiteSpace(_llama.File))
                            {
                                <span class="muted"> · <code>@_llama.File</code></span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-ghost" data-testid="review-edit-checkpoint" @onclick="() => GoToStepAsync(WizardStep.Checkpoint)">Edit</button>
                    </dd>
                </div>
                <div class="review-row">
                    <dt>Name</dt>
                    <dd>
                        <span class="review-value">
                            @if (string.IsNullOrWhiteSpace(_model.ServedName) || string.IsNullOrWhiteSpace(_model.Id))
                            {
                                <span class="state state--failed"><Icon Name="warning" /> Id and served name needed</span>
                            }
                            else
                            {
                                <strong>@_model.ServedName</strong>
                                <span class="num model-card-id">@_model.Id</span>
                            }
                            @if (EffectiveTags.Count > 0)
                            {
                                <TagList Tags="EffectiveTags" />
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-ghost" data-testid="review-edit-identity" @onclick="() => GoToStepAsync(WizardStep.Identity)">Edit</button>
                    </dd>
                </div>
                <div class="review-row">
                    <dt>Memory</dt>
                    <dd>
                        <span class="review-value">
                            <span><span class="num">@UiFormat.GiB(_model.MemoryBudgetGiB)</span> budget</span>
                            @if (IsMlx)
                            {
                                <span class="muted" data-testid="review-mlx-context"> · <span class="num">@_mlx.ContextSize.ToString("N0", CultureInfo.InvariantCulture)</span> tokens per request × <span class="num">@_mlx.Parallel</span></span>
                            }
                            else if (!IsLlamaCpp)
                            {
                                <span class="muted"> · <span class="num">@_model.MaxModelLen.ToString("N0", CultureInfo.InvariantCulture)</span> tokens of context</span>
                            }
                            @if (BudgetTooSmall)
                            {
                                <span class="state state--failed review-flag"><Icon Name="warning" /> Too small for this context</span>
                            }
                            else if (_multiNode && _fit?.Fits is { } fits)
                            {
                                <span class="state @(fits ? "state--ready" : "state--starting") review-flag">
                                    <Icon Name="@(fits ? "state-ready" : "warning")" /> @(fits ? $"Fits on {_nodeId} now" : $"Does not fit on {_nodeId} right now")
                                </span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-ghost" data-testid="review-edit-memory" @onclick="() => GoToStepAsync(WizardStep.Memory)">Edit</button>
                    </dd>
                </div>
                @if (!IsLlamaCpp && !IsMlx)
                {
                    <div class="review-row">
                        <dt>Tuning</dt>
                        <dd>
                            <span class="review-value">
                                <code>@(string.IsNullOrWhiteSpace(_model.Image) ? DefaultImageLabel : _model.Image)</code>
                                <span class="muted"> · auto-start @(_model.AutoStart ? "on" : "off")</span>
                            </span>
                            <button type="button" class="btn btn-sm btn-ghost" data-testid="review-edit-tuning" @onclick="() => GoToStepAsync(WizardStep.Tuning)">Edit</button>
                        </dd>
                    </div>
                }
            </dl>
        </section>
    };

