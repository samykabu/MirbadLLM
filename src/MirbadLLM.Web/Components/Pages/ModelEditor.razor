        !_multiNode ? "Folder already on the DGX" : _nodeId is null ? "Folder already on the node" : $"Folder already on {_nodeId}";

    /// <summary>The single node's id, shown read-only (the editor looks as before P2 with one node).</summary>
    private string SingleNodeText => IsNew ? _singleNodeId ?? BootstrapNodeId : _original?.Placement?.NodeId ?? "Unplaced";

