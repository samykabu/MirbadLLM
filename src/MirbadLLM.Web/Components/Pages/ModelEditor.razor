    private async Task InspectRepoAsync()
    {
        _inspectError = null;
        _repoInspection = null;
        _selectedVariant = "";
        _selectedProjector = "";
        _pendingGgufFile = null;

        if (string.IsNullOrWhiteSpace(_download.RepoId))
        {
            _inspectError = "Repo id is required.";
            return;
        }

        try
        {
            _repoInspection = await RepoInspector.InspectAsync(
                _download.RepoId.Trim(),
                string.IsNullOrWhiteSpace(_download.Revision) ? null : _download.Revision.Trim(),
                await SelectedTokenAsync());

            if (IsLlamaCpp && _repoInspection.Variants.Count > 0)
            {
                SelectLlamaVariant(_repoInspection.Variants[0].Name);
            }
            else if (!IsMlx && _repoInspection.Format is RepoFormat.Gguf or RepoFormat.Mixed && _repoInspection.Variants.Count > 0)
            {
                SelectVariant(_repoInspection.Variants[0].Name);
            }
        }
        catch (Exception ex) when (ex is HuggingFaceApiException or InvalidOperationException)
        {
            _inspectError = ex.Message;
        }
    }

    private void SelectVariant(string variantName)
    {
        _selectedVariant = variantName;
        var variant = _repoInspection?.Variants.FirstOrDefault(v => v.Name == variantName);
        if (_repoInspection is null || variant is null)
        {
            return;
        }

        var patterns = variant.Files.Select(f => f.Name).ToList();
        if (_repoInspection.OtherFiles.Any(f => f.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase)))
        {
            patterns.Add("*.json");
        }

        if (_repoInspection.OtherFiles.Any(f => f.Name.StartsWith("tokenizer", StringComparison.OrdinalIgnoreCase)))
        {
            patterns.Add("tokenizer*");
        }

        _download.AllowPatternsText = string.Join(", ", patterns);
    }

    private async Task StartDownloadAsync()
    {
        _downloadError = null;
        if (string.IsNullOrWhiteSpace(_download.RepoId))
        {
            _downloadError = "Repo id is required.";
            return;
        }

        var patterns = _download.AllowPatternsText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        try
        {
            var request = new DownloadRequest(
                RepoId: _download.RepoId.Trim(),
                Revision: string.IsNullOrWhiteSpace(_download.Revision) ? null : _download.Revision.Trim(),
                Token: await SelectedTokenAsync(),
                Folder: string.IsNullOrWhiteSpace(_download.Folder) ? null : _download.Folder.Trim(),
                AllowPatterns: patterns.Length > 0 ? patterns : null);

            _activeDownloader = NodeDownloader();
            _downloadStatus = await _activeDownloader.StartAsync(request);

            // Record where the checkpoint came from, so a restore from a backup can fetch it again.
            _model.SourceRepoId = request.RepoId;
            _model.SourceRevision = request.Revision ?? "";
            _model.SourcePatternsText = patterns.SequenceEqual(HuggingFaceDownloader.DefaultAllowPatterns, StringComparer.Ordinal) ? "" : string.Join(", ", patterns);
            _autoSourceFolder = _downloadStatus.Folder;
            StartPolling(_downloadStatus.Folder);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or HuggingFaceApiException)
        {
            _downloadError = ex.Message;
        }
    }

    /// <summary>
    /// The picked saved token's value, read on the server only as a request goes out, so it is never kept in the form or
    /// sent to the browser (MN-132). Null when none is picked.
    /// </summary>
    private async Task<string?> SelectedTokenAsync()
    {
        if (string.IsNullOrEmpty(_download.TokenId))
        {
            return null;
        }

        string? value = Services.GetService<ITokenStore>() is { } store ? await store.GetValueAsync(_download.TokenId) : null;
        return value ?? throw new InvalidOperationException("The picked access token was deleted. Pick another one, or none.");
    }

    private async Task CancelDownloadAsync()
    {
        if (_downloadStatus is null)
        {
            return;
        }

        await StopPollingAsync();
        await (_activeDownloader ?? Downloader).CancelAsync(_downloadStatus.Folder);
        _downloadStatus = null;
    }

    /// <summary>
    /// A download already on the selected node (started before this page was refreshed or reopened) is shown and
    /// followed as if started here, so it completes into the form and starting it again is not refused as in progress.
    /// A finished one is shown too: a failure stays readable, a completed folder is applied; Dismiss clears it.
    /// </summary>
    private async Task AttachToNodeDownloadAsync()
    {
        _downloadStatus = null;
        _otherDownloads = [];
        if (NeedsNode)
        {
            return;
        }

        var downloader = NodeDownloader();
        IReadOnlyList<DownloadStatus> downloads;
        try
        {
            downloads = await downloader.ListAsync();
        }
        catch (Exception ex) when (ex is NodeUnavailableException or InvalidOperationException or System.Net.Http.HttpRequestException)
        {
            return; // the node cannot be asked right now: the form opens as it did before
        }

        var active = downloads.Where(d => d.State is DownloadState.Downloading or DownloadState.Queued).ToList();
        var found = active.FirstOrDefault() ?? downloads.FirstOrDefault(d => d.State is DownloadState.Failed or DownloadState.Completed);
        if (found is null)
        {
            return;
        }

        _source = SourceMode.Download;
        _activeDownloader = downloader;
        _downloadStatus = found;
        _download.RepoId = found.RepoId;
        _download.Revision = found.Revision ?? "";
        _download.Folder = found.Folder;
        _model.SourceRepoId = found.RepoId;
        _model.SourceRevision = found.Revision ?? "";
        _autoSourceFolder = found.Folder;
        _otherDownloads = [.. active.Skip(1).Select(d => d.Folder)];
        if (found.State == DownloadState.Completed)
        {
            await ApplyDownloadedFolderAsync(found.Folder);
        }
        else if (found.State is DownloadState.Downloading or DownloadState.Queued)
        {
            StartPolling(found.Folder);
        }
    }

    /// <summary>The finished download's folder becomes the checkpoint, as if picked from the folder list.</summary>
    private async Task ApplyDownloadedFolderAsync(string folder)
    {
        _selectedFolder = folder;
        await LoadFoldersAsync();
        await ApplyFolderAsync(folder);
    }

    private void StartPolling(string folder)
    {
        _pollCts = new CancellationTokenSource();
        _pollLoop = PollLoopAsync(folder, _pollCts.Token);
    }

    private async Task PollLoopAsync(string folder, CancellationToken ct)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _pollTimer.WaitForNextTickAsync(ct))
            {
                var status = await (_activeDownloader ?? Downloader).GetAsync(folder, ct);
                _downloadStatus = status;
                if (status is null)
                {
                    break;
                }

                if (status.State == DownloadState.Completed)
                {
                    await ApplyDownloadedFolderAsync(folder);
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                if (status.State is DownloadState.Failed or DownloadState.Cancelled)
                {
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose/cancel.
        }
    }

    private async Task StopPollingAsync()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        if (_pollLoop is not null)
        {
            try
            {
                await _pollLoop;
            }
            catch (OperationCanceledException)
            {
                // Expected.
            }
        }

        _pollCts?.Dispose();
        _pollCts = null;
    }

    private static string Slugify(string value)
    {
        string slug = value.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').Aggregate("", (acc, c) => acc + c);
        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return slug.Trim('-');
    }

    private async Task SaveAsync()
    {
        _saveError = null;
        _saveErrorDetails = [];
        _saveNotice = null;

        if (NeedsNode)
        {
            _nodeMissing = true;
            _saveError = "More than one node exists: choose the node this model runs on under Placement.";
            return;
        }

        if (DigestProblem is { } digestProblem)
        {
            _saveError = "Image digest: " + digestProblem;
            return;
        }

        if (SelectedNode is { Discrete: true } discreteNode && _gpus.Count == 0)
        {
            _saveError = $"Tick at least one GPU on {discreteNode.Id} under Placement.";
            return;
        }

        if (_model.SpeculativeEnabled && string.IsNullOrWhiteSpace(_model.SpeculativeMethod) && string.IsNullOrWhiteSpace(_model.SpeculativeDraftModel))
        {
            _saveError = "Speculative decoding needs a method or a draft model path.";
            return;
        }

        if (_model.SpeculativeEnabled && !EditModel.IsJsonObjectOrBlank(_model.SpeculativeExtraJson))
        {
            _saveError = "Advanced speculative keys must be a JSON object, e.g. {\"moe_backend\":\"triton\"}.";
            return;
        }

        if (!EditModel.IsJsonObjectOrBlank(_model.CompilationExtraJson))
        {
            _saveError = "Other compilation-config keys must be a JSON object, e.g. {\"mode\":3}.";
            return;
        }

        if (_model.ExtraSources.Any(r => !r.IsBlank && (string.IsNullOrWhiteSpace(r.RepoId) || string.IsNullOrWhiteSpace(r.Folder))))
        {
            _saveError = "Every extra checkpoint needs both a repo id and a folder (or remove the row).";
            return;
        }

        if (IsLlamaCpp && LlamaSaveProblem() is { } llamaProblem)
        {
            _saveError = llamaProblem;
            return;
        }

        if (IsMlx && MlxSettingsProblem() is { } mlxProblem)
        {
            _saveError = mlxProblem;
            return;
        }

        // Canonical configuration: owned flags typed into the extra args move into their fields (shown live under
        // the extra args); the form then shows where they went.
        // Edit: re-read the stored definition as the baseline so the fields the form does not show (placement, runtime,
        // keep-serving, …) are kept, including a move or unplace made since the page loaded. Create: §5.6 default
        // placement (the only node), else the operator must place it through the API.
        ModelDefinition? baseline = null;
        if (!IsNew)
        {
            baseline = await Registry.GetAsync(Id!) ?? _original;
        }

        // A llama.cpp or MLX model has no vLLM arguments to lift: its typed flags are refused in its own ExtraArgs instead (D126).
        var draft = WithPlacementEdits(Draft(IsNew ? _model.Id : Id!, baseline) with { Tags = EffectiveTags.ToList() });
        var normalized = IsLlamaCpp || IsMlx ? new NormalizedDefinition(draft, [], []) : VllmArgsNormalizer.Normalize(draft);
        if (normalized.Problems.Count > 0)
        {
            _saveError = "Extra args: " + string.Join(" ", normalized.Problems);
            return;
        }

        if (IsLlamaCpp && LlamaCppArgsBuilder.Problems(normalized.Definition) is { Count: > 0 } llamaProblems)
        {
            _saveError = "Not saved: the llama.cpp settings were refused.";
            _saveErrorDetails = [.. llamaProblems.Select(p => p.Message)];
            return;
        }

        if (IsMlx && MlxArgsBuilder.Problems(normalized.Definition) is { Count: > 0 } mlxProblems)
        {
            _saveError = "Not saved: the MLX settings were refused.";
            _saveErrorDetails = [.. mlxProblems.Select(p => p.Message)];
            return;
        }

        var definition = normalized.Definition;
        if (IsNew && definition.Placement is null)
        {
            string bootstrap = Services.GetService<Microsoft.Extensions.Options.IOptions<RegistryMigrationOptions>>()?.Value.EffectiveBootstrapNodeId
                ?? RegistryMigrationOptions.DefaultBootstrapNodeId;
            if (await MirbadLLM.Orchestration.Nodes.DefaultPlacement.ApplyAsync(definition, Services.GetService<INodeRegistry>(), bootstrap) is not { } placed)
            {
                _saveError = "More than one node exists; place the model on a node.";
                return;
            }

            definition = placed;
        }

        string? liftedNote = null;
        if (normalized.Lifted.Count > 0)
        {
            _model.LoadFrom(definition);
            liftedNote = "Moved into their fields: " + string.Join(", ", normalized.Lifted.Select(l => l.ToString())) + ".";
        }

        try
        {
            // An edit is written only onto the placement this page showed (D75, W7 review MN-126, MN-118): a move, unplace
            // or place landing after the page read the model (here: since it opened or last re-read it) is refused
            // (placement_changed) instead of being reverted, and a GPU change carries the stored generation.
            using (IsNew ? null : ModelWriteScope.ExpectStoredPlacement(_original?.Placement))
            {
                await Registry.UpsertAsync(definition);
            }
        }
        catch (Exception ex) when (ex is ArgumentException or ModelBusyException or PlacementConflictException or PlacementValidationException)
        {
            ModelDefinition? current = null;
            if (ex is PlacementConflictException && !IsNew)
            {
                // Show the placement as it is now, keep the other edits, so a second save goes onto it.
                current = await Registry.GetAsync(Id!);
                if (current is not null)
                {
                    _original = current;
                    ResetPlacementFrom(current);
                    await RefreshNodesAsync();
                    await RefreshFitAsync();
                    await RefreshMoveAsync();
                }
            }

            var gpus = current?.Placement?.NodeId is { } node ? _nodes.FirstOrDefault(n => n.Id == node)?.Gpus : null;
            var message = EditorRefusals.Save(ex, definition.Id, current, gpus, placementSection: _multiNode);
            _saveError = message.Text;
            _saveErrorDetails = [.. message.Details];
            return;
        }

        // The registry stamps the placement generation (a GPU change increments it): the next save from this page carries it.
        var stored = IsNew ? definition : await Registry.GetAsync(definition.Id) ?? definition;

        if (IsNew)
        {
            Nav.NavigateTo($"/?added={Uri.EscapeDataString(definition.Id)}");
            return;
        }

        // A benchmark or tuning job on this model holds the router in maintenance mode; a restart now would
        // fight it for the box. The settings are already saved (above) — stay on the page, explain that the
        // restart is deferred, and let the operator apply it from the Dashboard once the job finishes.
        if (Services.GetService<IMaintenanceMode>()?.Active.FirstOrDefault(w => w.ModelId == definition.Id) is { } activeJob)
        {
            string jobWord = string.Equals(activeJob.JobKind, "tuning", StringComparison.Ordinal) ? "tuning" : "a benchmark";
            _saveNotice = $"Saved. The restart is blocked while {jobWord} runs; apply it from the Dashboard when the job finishes." +
                (liftedNote is null ? "" : " " + liftedNote);
            _original = stored;
            ResetPlacementFrom(stored);
            return;
        }

        // Only AutoStart (or nothing) changed, or the model isn't running: nothing to apply.
        bool running = _runningState is ModelState.Starting or ModelState.Ready;
        if (!running || _original is null || RestartNeeded(_original, definition).Count == 0 || _apply is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        // List everything the restart applies: against what the container actually runs when it can be read back.
        var launched = await ReadLaunchedAsync(definition.Id) ?? _original;
        _original = stored;
        if (_multiNode)
        {
            ResetPlacementFrom(stored);
        }

        _saveNotice = liftedNote is null ? null : "Saved. " + liftedNote;
        await _apply.OpenAsync(definition, RestartNeeded(launched, definition), launched.MemoryBudgetGiB);
    }

    private async Task<ModelDefinition?> ReadLaunchedAsync(string id)
    {
        if (Services.GetService<IModelLauncher>() is not { } launcher)
        {
            return null;
        }

        try
        {
            return await launcher.GetLaunchedDefinitionAsync(id);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or DockerApiException)
        {
            return null;
        }
    }

    private Task AfterApplyAsync(bool restarted)
    {
        _ = restarted;
        Nav.NavigateTo("/");
        return Task.CompletedTask;
    }

    private async Task DeleteAsync()
    {
        if (Id is null)
        {
            return;
        }

        try
        {
            await Registry.DeleteAsync(Id);
        }
        catch (ModelBusyException ex)
        {
            // A job, move or restore holds the model (design §6.7; composed by the W7 review MN-126): say so, don't crash.
            _saveError = EditorRefusals.Delete(ex, Id).Text;
            _saveErrorDetails = [];
            return;
        }

        Nav.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        await StopPollingAsync();
        if (_liveCts is not null)
        {
            await _liveCts.CancelAsync();
            try
            {
                if (_liveLoop is not null)
                {
                    await _liveLoop;
                }
            }
            catch (OperationCanceledException)
            {
                // Expected.
            }

            _liveCts.Dispose();
            _liveCts = null;
        }
    }

    // --- llama.cpp (design-p3p4 §A.7; MN-226) ---

    private RuntimeKind _runtime = RuntimeKind.Vllm;
    private LlamaCppForm _llama = new();
    private MirbadLLM.Agent.Contracts.GgufSummary? _gguf;
    private string? _ggufError;

    /// <summary>Generation of the GGUF header read in flight (MN-239 item 5): an overtaken answer is dropped.</summary>
    private int _ggufReadVersion;

    private IReadOnlyList<string> _ggufCandidates = [];
    private GgufMemoryEstimate? _estimate;
    private string? _estimateError;
    private IReadOnlyList<MirbadLLM.Agent.Contracts.ModelFolderEntry> _entries = [];
    private string _selectedProjector = "";

    /// <summary>The first GGUF of the variant being downloaded, read once the download completes.</summary>
    private string? _pendingGgufFile;

    /// <summary>True once the budget was typed (or the model existed): a new model's budget follows the estimate until then.</summary>
    private bool _budgetTouched;

    private bool IsLlamaCpp => _runtime == RuntimeKind.LlamaCpp;

    private bool IsSharedContainer => _runtime is RuntimeKind.Sglang or RuntimeKind.Nim;

    /// <summary>The model the form describes: the vLLM fields on <paramref name="baseline"/>, plus the llama.cpp settings for a llama.cpp model.</summary>
    private ModelDefinition Draft(string id, ModelDefinition? baseline)
    {
        var definition = _model.ToDefinition(id, baseline);
        if (IsSharedContainer)
        {
            return definition with
            {
                Runtime = _runtime,
                Container = new ContainerRuntimeSettings
                {
                    Image = (_model.Image ?? "").Trim(),
                    ImageDigest = string.IsNullOrWhiteSpace(_model.ImageDigest) ? null : _model.ImageDigest.Trim(),
                    ExtraArgs = _model.ExtraArgsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                },
                LlamaCpp = null,
                Mlx = null,
                Image = null,
                ImageDigest = null,
                ExtraArgs = [],
                ToolCallParser = null,
                ReasoningParser = null,
            };
        }

        if (IsMlx)
        {
            // mlx_lm.server reads none of the vLLM fields: no parsers and no vLLM extra args are stored for it.
            return definition with
            {
                Runtime = RuntimeKind.Mlx, Mlx = MlxDraftSettings(), LlamaCpp = null, ToolCallParser = null, ReasoningParser = null, ExtraArgs = [],
            };
        }

        return IsLlamaCpp ? definition with { Runtime = RuntimeKind.LlamaCpp, LlamaCpp = LlamaDraftSettings() } : definition;
    }

    /// <summary>The node's llama.cpp delivery (a native process on Windows), else the stored one.</summary>
    private LaunchDelivery LlamaDelivery =>
        LlamaCppEditing.Runtime(SelectedNode)?.Delivery ?? _llama.Baseline?.Delivery ?? LaunchDelivery.Container;

    private LlamaCppSettings LlamaDraftSettings() => _llama.ToSettings(_model.ModelPath, LlamaDelivery, _gpus.Count);

    /// <summary>
    /// The node's installed llama-server versions; null when it reports none (or the node is unknown). The node is the
    /// chosen one on a fleet of several, the fleet's one member otherwise (MN-239 item 3) — without that a single-node
    /// fleet offered only "Node default (none verified)" however many versions the PC had.
    /// </summary>
    private IReadOnlyList<RuntimeVersion>? LlamaVersions => LlamaCppEditing.Runtime(SelectedNode ?? _singleNode)?.Versions;

    /// <summary>The vision projectors of the inspected repo, listed apart from the variants.</summary>
    private IReadOnlyList<RepoFile> RepoProjectors =>
        [.. (_repoInspection?.AuxiliaryFiles ?? []).Where(f => Path.GetFileName(f.Name).StartsWith("mmproj", StringComparison.OrdinalIgnoreCase))];

    /// <summary>The room on each GPU of the chosen node, from the fit preview (every GPU as a single-GPU option).</summary>
    private IReadOnlyList<GgufGpuRoom> GgufRooms
    {
        get
        {
            if (SelectedNode is not { } node || _nodeFits.GetValueOrDefault(node.Id) is not { } fit)
            {
                return [];
            }

            if (!node.Discrete)
            {
                return [new GgufGpuRoom(node.Id, fit.FreeGiB, fit.ReserveGiB)];
            }

            return
            [
                .. node.Gpus.Select(gpu => fit.Gpus.FirstOrDefault(g => string.Equals(g.Uuid, gpu.Uuid, StringComparison.Ordinal)) is { } room
                    ? new GgufGpuRoom(PlacementEditing.GpuLabel(gpu), room.FreeGiB, room.ReserveGiB)
                    : new GgufGpuRoom(PlacementEditing.GpuLabel(gpu), null, 0)),
            ];
        }
    }

    /// <summary>The <c>--tensor-split</c> the builder would emit for the ticked GPUs (two or more); null otherwise.</summary>
    private string? LlamaTensorSplit
    {
        get
        {
            if (!IsLlamaCpp || _gpus.Count < 2 || SelectedNode is not { } node)
            {
                return null;
            }

            try
            {
                var model = Draft(string.IsNullOrEmpty(_model.Id) ? "preview" : _model.Id, _original) with
                {
                    Placement = PlacementEditing.Build(node.Id, _gpus, node.Gpus, 0),
                };
                return LaunchSpecBuilder.TensorSplitWeights(model, node.Record) is { } weights
                    ? LlamaCppArgsBuilder.FormatTensorSplit(LlamaCppArgsBuilder.TensorSplit(weights))
                    : null;
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
            {
                return null; // budgets that do not match yet, or a GPU without memory in the report: no split to show
            }
        }
    }

    private async Task OnRuntimeChangedAsync(RuntimeKind kind)
    {
        _runtime = kind;
        // The vLLM parsers mean nothing to llama-server (its template decides): a new llama.cpp model stores none; back on
        // vLLM the editor's defaults return.
        var defaults = new ModelDefinition { Id = "x", ServedName = "x", ModelPath = "x" };
        _model.ToolCallParser = IsLlamaCpp || IsMlx || IsSharedContainer ? null : defaults.ToolCallParser;
        _model.ReasoningParser = IsLlamaCpp || IsMlx || IsSharedContainer ? null : defaults.ReasoningParser;
        _selectedFolder = "";
        _inspection = null;
        _suggestionFormula = null;
        _folderError = null;
        ResetGguf();
        if (_repoInspection is { Variants.Count: > 0 } repo)
        {
            if (IsLlamaCpp)
            {
                SelectLlamaVariant(repo.Variants[0].Name);
            }
            else if (IsMlx)
            {
                // An MLX download takes the default patterns (safetensors, json, tokenizer), never a GGUF variant.
                _selectedProjector = "";
                _selectedVariant = "";
                _download.AllowPatternsText = string.Join(", ", HuggingFaceDownloader.DefaultAllowPatterns);
            }
            else
            {
                _selectedProjector = "";
                SelectVariant(repo.Variants[0].Name);
            }
        }

        await LoadFoldersAsync();
        RecomputeLlama();
        RecomputeMlx();
        await RefreshFitAsync();
    }

    private void ResetGguf()
    {
        _ggufReadVersion++; // a header read still out belongs to the folder, file or node just left (MN-239 item 5)
        _gguf = null;
        _ggufError = null;
        _ggufCandidates = [];
        _estimate = null;
        _estimateError = null;
        _pendingGgufFile = null;
    }

    private async Task OnLlamaChangedAsync()
    {
        RecomputeLlama();
        await RefreshFitAsync();
    }

    private async Task OnLlamaBudgetChangedAsync(double budget)
    {
        _model.MemoryBudgetGiB = budget;
        _budgetTouched = true;
        await RefreshFitAsync();
    }

    private async Task OnGpuBudgetsChangedAsync(IReadOnlyList<double?> budgets)
    {
        _llama.GpuBudgets = [.. budgets];
        RecomputeLlama();
        await RefreshFitAsync();
    }

    /// <summary>Recomputes the live estimate; a new model whose budget was not typed takes it as its budget.</summary>
    private void RecomputeLlama()
    {
        if (!IsLlamaCpp)
        {
            _estimate = null;
            _estimateError = null;
            return;
        }

        _estimate = LlamaCppEditing.TryEstimate(_gguf, LlamaDraftSettings(), _gpus.Count, out _estimateError);
        if (IsNew && !_budgetTouched && _estimate is { } estimate)
        {
            _model.MemoryBudgetGiB = estimate.BudgetGiB;
        }
    }

    /// <summary>A GGUF folder was picked (or a download finished): the model path, the names, then its header.</summary>
    private async Task ApplyGgufFolderAsync(string folder, string? preferredFile)
    {
        ResetGguf();
        _llama.File = preferredFile ?? "";
        if (string.IsNullOrEmpty(folder))
        {
            RecomputeLlama();
            return;
        }

        if (_autoSourceFolder is not null && !string.Equals(_autoSourceFolder, folder, StringComparison.Ordinal))
        {
            _model.SourceRepoId = "";
            _model.SourceRevision = "";
            _model.SourcePatternsText = "";
            _autoSourceFolder = null;
        }

        _model.ModelPath = folder;
        _model.Id = string.IsNullOrWhiteSpace(_model.Id) ? Slugify(folder) : _model.Id;
        _model.ServedName = string.IsNullOrWhiteSpace(_model.ServedName) ? folder : _model.ServedName;
        if (!string.IsNullOrEmpty(_selectedProjector))
        {
            _llama.ProjectorFile = _selectedProjector;
        }

        await ReadGgufAsync();
    }

    /// <summary>
    /// Reads the header of the chosen GGUF (the folder's only one when none is chosen) through the node's agent. On a new
    /// model it pre-fills the settings (D118); on an existing one it only gives the estimate (and the file name, when it was
    /// left to the agent), so the stored settings stay as they are.
    /// <para>The read is a remote call with no bound of its own, and the folder, the file and the node can all change
    /// while it is in flight. Each read takes a generation and an answer that a newer read has overtaken is dropped
    /// (MN-239 item 5, D131; the same guard as <c>NodeDetail.LoadAgentStatusAsync</c>), so a slow read of folder A can no
    /// longer overwrite the summary and the pre-fill of the folder the operator has since chosen.</para>
    /// </summary>
    private async Task ReadGgufAsync()
    {
        int version = ++_ggufReadVersion;
        _gguf = null;
        _ggufError = null;
        if (string.IsNullOrWhiteSpace(_model.ModelPath))
        {
            _ggufError = "Choose the folder first.";
            RecomputeLlama();
            return;
        }

        var read = await ModelSourcing.InspectGgufAsync(Services, SourceNodeId, _model.ModelPath.Trim(), _llama.File);
        if (version != _ggufReadVersion)
        {
            return; // another folder, file or node was chosen while this read was out: its own read answers.
        }

        _gguf = read.Summary;
        _ggufError = read.Error;
        if (read.Candidates.Count > 0)
        {
            _ggufCandidates = read.Candidates;
        }

        if (_gguf is { } summary)
        {
            if (IsNew)
            {
                _llama.ApplyGguf(summary);
                if (string.Equals(_model.ServedName, _model.ModelPath, StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(summary.Name))
                {
                    _model.ServedName = summary.Name;
                }
            }
            else if (string.IsNullOrWhiteSpace(_llama.File))
            {
                _llama.File = summary.File;
            }
        }

        RecomputeLlama();
        await RefreshFitAsync();
    }

    /// <summary>A variant of the inspected repo: the download fetches its files (and the chosen projector) only.</summary>
    private void SelectLlamaVariant(string variantName)
    {
        _selectedVariant = variantName;
        if (_repoInspection?.Variants.FirstOrDefault(v => v.Name == variantName) is not { } variant)
        {
            return;
        }

        var files = variant.Files.Select(f => f.Name).Order(StringComparer.Ordinal).ToList();
        _pendingGgufFile = files.FirstOrDefault();
        var patterns = new List<string>(files);
        if (!string.IsNullOrEmpty(_selectedProjector))
        {
            patterns.Add(_selectedProjector);
        }

        _download.AllowPatternsText = string.Join(", ", patterns);
    }

    private void SelectProjector(string projector)
    {
        _selectedProjector = projector ?? "";
        SelectLlamaVariant(_selectedVariant);
    }

    /// <summary>What a llama.cpp save needs that the registry's checks do not say in the editor's words; null when fine.</summary>
    private string? LlamaSaveProblem()
    {
        if (string.IsNullOrWhiteSpace(_llama.File))
        {
            return "Choose the GGUF file: pick its folder and read its header, or type the file name.";
        }

        if (LlamaCppEditing.GpuBudgetProblem(_llama.GpuBudgets, _gpus.Count, _model.MemoryBudgetGiB) is { } budgets)
        {
            return "Per-GPU budgets: " + budgets;
        }

        var refused = LlamaCppEditing.RefusedExtraArgs(_llama.ExtraArgsText);
        return refused.Count > 0
            ? $"Extra args: {string.Join(" ", refused)} cannot be set there (use its field, or leave it to MirbadLLM)."
            : null;
    }

    /// <summary>Every setting a restart applies: the vLLM list (unchanged for vLLM models) and the llama.cpp settings.</summary>
    private static IReadOnlyList<SettingChange> RestartNeeded(ModelDefinition before, ModelDefinition after) =>
        [.. SettingChanges.RestartNeeded(before, after), .. LlamaCppEditing.RestartNeeded(before, after), .. MlxEditing.RestartNeeded(before, after)];

    // --- MLX (docs/macos/implementation-plan.md, Phase 3 "UI") ---

    private MlxForm _mlx = new();
    private MlxMemoryEstimate? _mlxEstimate;

    private bool IsMlx => _runtime == RuntimeKind.Mlx;

    /// <summary>The MLX settings the form describes; the checkpoint folder is the model's folder.</summary>
    private MlxSettings MlxDraftSettings() => _mlx.ToSettings(_model.ModelPath);

    /// <summary>The node's installed mlx-lm versions; null when it reports none (or the node is unknown).</summary>
    private IReadOnlyList<RuntimeVersion>? MlxVersions => MlxEditing.Runtime(SelectedNode ?? _singleNode)?.Versions;

    /// <summary>The node offers MLX (or the model already is one): the runtime texts then name it.</summary>
    private bool MlxOffered => IsMlx || MlxEditing.Runtime(SelectedNode ?? _singleNode) is not null;

    /// <summary>The node offers llama.cpp (or the model already is one).</summary>
    private bool LlamaOffered => IsLlamaCpp || LlamaCppEditing.Runtime(SelectedNode ?? _singleNode) is not null;

    /// <summary>"vLLM or llama.cpp" (as before MLX), "vLLM or MLX", "vLLM, llama.cpp or MLX".</summary>
    private string RuntimeChoiceText =>
        !MlxOffered ? "vLLM or llama.cpp" : LlamaOffered ? "vLLM, llama.cpp or MLX" : "vLLM or MLX";

    /// <summary>What a checkpoint is per runtime, for the runtime step.</summary>
    private string RuntimeCheckpointText =>
        !MlxOffered ? "a folder for vLLM, one GGUF file for llama.cpp"
        : LlamaOffered ? "a folder for vLLM and MLX, one GGUF file for llama.cpp"
        : "a folder for vLLM and MLX";

    private async Task OnMlxChangedAsync()
    {
        RecomputeMlx();
        await RefreshFitAsync();
    }

    /// <summary>Recomputes the MLX estimate; a new model whose budget was not typed takes it as its budget.</summary>
    private void RecomputeMlx()
    {
        if (!IsMlx)
        {
            _mlxEstimate = null;
            return;
        }

        _mlxEstimate = MlxEditing.TryEstimate(MlxDraftSettings(), MemoryInspection);
        if (IsNew && !_budgetTouched && _mlxEstimate is { } estimate)
        {
            _model.MemoryBudgetGiB = estimate.BudgetGiB;
        }
    }

    /// <summary>What an MLX save needs that the registry's checks do not say in the editor's words; null when fine.</summary>
    private string? MlxSettingsProblem()
    {
        var refused = MlxEditing.RefusedExtraArgs(_mlx.ExtraArgsText);
        if (refused.Count > 0)
        {
            return $"Extra args: {string.Join(" ", refused)} cannot be set there (use its field, or leave it to MirbadLLM).";
        }

        return MlxEditing.ChatTemplateArgsProblem(_mlx.ChatTemplateArgs) is { } template ? "Chat template arguments: " + template : null;
    }

    private sealed class DownloadFormModel
    {
        public string RepoId { get; set; } = "";
        public string Revision { get; set; } = "";
        /// <summary>A saved token's id (Access > Tokens), never its value.</summary>
        public string? TokenId { get; set; }
        public string Folder { get; set; } = "";
        public string AllowPatternsText { get; set; } = string.Join(", ", HuggingFaceDownloader.DefaultAllowPatterns);
    }

    private sealed class EditModel
    {
        [Required]
        [RegularExpression("^[a-z0-9][a-z0-9-]{0,39}$", ErrorMessage = "Id must be lowercase letters/digits/hyphens, start with a letter or digit, max 40 characters.")]
        public string Id { get; set; } = "";

        [Required]
        public string ServedName { get; set; } = "";

        [Required]
        public string ModelPath { get; set; } = "";

        public string? Quantization { get; set; }

        [Required]
        public string KvCacheDtype { get; set; } = "fp8";

        [Range(1, int.MaxValue)]
        public int MaxModelLen { get; set; } = 262_144;

        [Range(1, int.MaxValue)]
        public int MaxNumSeqs { get; set; } = 16;

        public int? MaxNumBatchedTokens { get; set; }

        [Range(0.1, 1000)]
        public double MemoryBudgetGiB { get; set; } = 36;

        public string? ToolCallParser { get; set; } = "qwen3_coder";
        public string? ReasoningParser { get; set; } = "qwen3";

        /// <summary>Tri-state: "" = vLLM default, "on", "off".</summary>
        public string PrefixCaching { get; set; } = "on";

        /// <summary>Tri-state: "" = vLLM default, "on", "off".</summary>
        public string AsyncScheduling { get; set; } = "";

        public string? MambaCacheMode { get; set; }

        public bool SpeculativeEnabled { get; set; }
        public string SpeculativeMethod { get; set; } = "";

        [Range(1, int.MaxValue)]
        public int SpeculativeNumTokens { get; set; } = 1;

        public string SpeculativeDraftModel { get; set; } = "";

        /// <summary>Every other <c>--speculative-config</c> key, as a JSON object.</summary>
        public string SpeculativeExtraJson { get; set; } = "";

        public string? CudaGraphMode { get; set; }

        /// <summary>Every other <c>--compilation-config</c> key (besides cudagraph_mode), as a JSON object.</summary>
        public string CompilationExtraJson { get; set; } = "";
        public string? Image { get; set; }

        /// <summary>The image override's digest (D85); only shown, and only saved, with an image override.</summary>
        public string ImageDigest { get; set; } = "";
        public string ExtraArgsText { get; set; } = "";
        public bool AutoStart { get; set; }

        /// <summary>The primary source: the repo the folder at <see cref="ModelPath"/> comes from.</summary>
        public string SourceRepoId { get; set; } = "";
        public string SourceRevision { get; set; } = "";
        public string SourcePatternsText { get; set; } = "";
        public List<SourceRow> ExtraSources { get; set; } = [];

        public void LoadFrom(ModelDefinition definition)
        {
            Id = definition.Id;
            ServedName = definition.ServedName;
            ModelPath = definition.ModelPath;
            Quantization = definition.Quantization;
            KvCacheDtype = definition.KvCacheDtype;
            MaxModelLen = definition.MaxModelLen;
            MaxNumSeqs = definition.MaxNumSeqs;
            MaxNumBatchedTokens = definition.MaxNumBatchedTokens;
            MemoryBudgetGiB = definition.MemoryBudgetGiB;
            ToolCallParser = definition.ToolCallParser;
            ReasoningParser = definition.ReasoningParser;
            PrefixCaching = TriState(definition.EnablePrefixCaching);
            AsyncScheduling = TriState(definition.AsyncScheduling);
            MambaCacheMode = definition.MambaCacheMode;
            SpeculativeEnabled = definition.Speculative is not null;
            SpeculativeMethod = definition.Speculative?.Method ?? "";
            SpeculativeNumTokens = definition.Speculative is { NumSpeculativeTokens: > 0 } s ? s.NumSpeculativeTokens : 1;
            SpeculativeDraftModel = definition.Speculative?.DraftModel ?? "";
            SpeculativeExtraJson = definition.Speculative is { Extra.IsEmpty: false } withExtra ? withExtra.Extra.ToJson() : "";
            CudaGraphMode = definition.CudaGraphMode;
            CompilationExtraJson = definition.CompilationConfig is { IsEmpty: false } cc ? cc.ToJson() : "";
            Image = definition.Image;
            ImageDigest = definition.ImageDigest ?? "";
            ExtraArgsText = string.Join('\n', definition.ExtraArgs);
            AutoStart = definition.AutoStart;

            var sources = definition.Sources ?? [];
            var primary = sources.FirstOrDefault(src => string.Equals(src.Folder, definition.ModelPath, StringComparison.Ordinal));
            SourceRepoId = primary?.RepoId ?? "";
            SourceRevision = primary?.Revision ?? "";
            SourcePatternsText = primary?.AllowPatterns is { Count: > 0 } patterns ? string.Join(", ", patterns) : "";
            ExtraSources = sources.Where(src => !ReferenceEquals(src, primary)).Select(SourceRow.From).ToList();
        }

        /// <summary>
        /// The form's fields applied on top of <paramref name="baseline"/> (the stored definition when editing), so every
        /// member the form does not show — placement, runtime, llama.cpp settings, host-memory budget, keep-serving and
        /// whatever later phases add — is kept on save (MN-090: a fresh definition here would unplace the model).
        /// </summary>
        public ModelDefinition ToDefinition(string id, ModelDefinition? baseline = null) =>
            (baseline ?? new ModelDefinition { Id = id, ServedName = ServedName, ModelPath = ModelPath }) with
        {
            Id = id,
            ServedName = ServedName,
            ModelPath = ModelPath,
            Quantization = string.IsNullOrWhiteSpace(Quantization) ? null : Quantization,
            KvCacheDtype = KvCacheDtype,
            MaxModelLen = MaxModelLen,
            MaxNumSeqs = MaxNumSeqs,
            MaxNumBatchedTokens = MaxNumBatchedTokens,
            MemoryBudgetGiB = MemoryBudgetGiB,
            ToolCallParser = string.IsNullOrWhiteSpace(ToolCallParser) ? null : ToolCallParser,
            ReasoningParser = string.IsNullOrWhiteSpace(ReasoningParser) ? null : ReasoningParser,
            EnablePrefixCaching = FromTriState(PrefixCaching),
            AsyncScheduling = FromTriState(AsyncScheduling),
            MambaCacheMode = string.IsNullOrWhiteSpace(MambaCacheMode) ? null : MambaCacheMode.Trim(),
            Speculative = SpeculativeEnabled ? BuildSpeculative() : null,
            CudaGraphMode = string.IsNullOrWhiteSpace(CudaGraphMode) ? null : CudaGraphMode,
            CompilationConfig = JsonFields.TryParse(CompilationExtraJson, out var compilation) && !compilation.IsEmpty ? compilation : null,
            Image = string.IsNullOrWhiteSpace(Image) ? null : Image,
            ImageDigest = string.IsNullOrWhiteSpace(Image) || string.IsNullOrWhiteSpace(ImageDigest) ? null : ImageDigest.Trim(),
            ExtraArgs = ExtraArgsText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            AutoStart = AutoStart,
            Sources = BuildSources(),
        };

        /// <summary>The speculative object: the advanced JSON keys, then the typed fields on top (they win).</summary>
        private SpeculativeDecoding BuildSpeculative()
        {
            var extra = JsonFields.TryParse(SpeculativeExtraJson, out var parsed) ? parsed : JsonFields.Empty;
            var typed = new SpeculativeDecoding(SpeculativeMethod ?? "", SpeculativeNumTokens)
            {
                DraftModel = string.IsNullOrWhiteSpace(SpeculativeDraftModel) ? null : SpeculativeDraftModel.Trim(),
            };
            return SpeculativeDecoding.FromFields(extra.MergedWith(typed.ToFields()));
        }

        public static bool IsJsonObjectOrBlank(string? text) => string.IsNullOrWhiteSpace(text) || JsonFields.TryParse(text, out _);

        private static string TriState(bool? value) => value switch
        {
            true => "on",
            false => "off",
            null => "",
        };

        private static bool? FromTriState(string? value) => value switch
        {
            "on" => true,
            "off" => false,
            _ => null,
        };

        private List<ModelSource> BuildSources()
        {
            var sources = new List<ModelSource>();
            if (!string.IsNullOrWhiteSpace(SourceRepoId) && !string.IsNullOrWhiteSpace(ModelPath))
            {
                sources.Add(new ModelSource(SourceRepoId.Trim(), ModelPath.Trim(), Blank(SourceRevision), Patterns(SourcePatternsText)));
            }

            sources.AddRange(ExtraSources.Where(r => !r.IsBlank).Select(r => r.ToSource()));
            return sources;
        }
    }

    /// <summary>One extra checkpoint row in the Source section.</summary>
    private sealed class SourceRow
    {
        public string RepoId { get; set; } = "";
        public string Folder { get; set; } = "";
        public string Revision { get; set; } = "";
        public string PatternsText { get; set; } = "";

        public bool IsBlank => string.IsNullOrWhiteSpace(RepoId) && string.IsNullOrWhiteSpace(Folder);

        public ModelSource ToSource() => new(RepoId.Trim(), Folder.Trim(), Blank(Revision), Patterns(PatternsText));

        public static SourceRow From(ModelSource source) => new()
        {
            RepoId = source.RepoId,
            Folder = source.Folder,
            Revision = source.Revision ?? "",
            PatternsText = source.AllowPatterns is { Count: > 0 } patterns ? string.Join(", ", patterns) : "",
        };
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static IReadOnlyList<string>? Patterns(string? text)
    {
        var patterns = (text ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return patterns.Length == 0 ? null : patterns;
    }
}
