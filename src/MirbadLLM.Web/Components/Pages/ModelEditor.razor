    protected override async Task OnInitializedAsync()
    {
        // Resolved once (MN-132): the live refresh loop runs until DisposeAsync awaits it, and a lookup from a scope that is
        // being disposed throws ObjectDisposedException.
        _nodeRegistry = Services.GetService<INodeRegistry>();
        _nodeCache = Services.GetService<INodeStatusCache>();
        _moves = Services.GetService<MoveService>();
        // The composed preview first (MN-233): it carries the agent clients, so a llama.cpp model on a node reporting
        // gguf.inspect shows the GGUF estimate next to the budget (design-p3p4 §A.1.10).
        _fitPreview = Services.GetService<PlacementFit>()
            ?? (_nodeRegistry is null
                ? null
                : new PlacementFit(_nodeRegistry, Registry, Services.GetService<INodeTelemetry>(), _nodeCache, Services.GetService<TimeProvider>()));
        _reserveGiB = SparkOptions.Value.MemoryReserveGiB;
        _memory = await MemoryProbe.GetAsync();

        if (!IsNew)
        {
            var existing = await Registry.GetAsync(Id!);
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _model.LoadFrom(existing);
            if (existing.Runtime == RuntimeKind.LlamaCpp)
            {
                _runtime = RuntimeKind.LlamaCpp;
                _llama = LlamaCppForm.From(existing.LlamaCpp ?? new LlamaCppSettings { ModelFile = "" }, existing.ModelPath);
                _budgetTouched = true;
            }
            else if (existing.Runtime == RuntimeKind.Mlx)
            {
                _runtime = RuntimeKind.Mlx;
                _mlx = MlxForm.From(existing.Mlx ?? new MlxSettings { ModelFolder = existing.ModelPath });
                _budgetTouched = true;
            }
            else if (existing.Runtime is RuntimeKind.Sglang or RuntimeKind.Nim)
            {
                _runtime = existing.Runtime;
                _model.Image = existing.Container?.Image ?? "";
                _model.ImageDigest = existing.Container?.ImageDigest ?? "";
                _model.ExtraArgsText = string.Join(Environment.NewLine, existing.Container?.ExtraArgs ?? []);
                _budgetTouched = true;
            }

            _tags = [.. existing.Tags ?? []];
            _tagsTouched = true;
            _original = existing;
            try
            {
                _pathInspection = await ModelSourcing.InspectAsync(Services, existing.Placement?.NodeId, existing.ModelPath);
            }
            catch (Exception ex) when (ex is IOException or System.Text.Json.JsonException or UnauthorizedAccessException or NodeUnavailableException)
            {
                _pathInspection = null;
            }

            var status = await Runtime.GetStatusAsync(Id!);
            _runningState = status.State;
            _deleteDisabled = status.State is ModelState.Starting or ModelState.Ready or ModelState.Stopping;

            // A running model already holds its saved budget; a restart releases it first, so count it as free.
            _ownBudgetInUseGiB = _deleteDisabled ? existing.MemoryBudgetGiB : 0;
        }

        await LoadNodesAsync();
        _catalog = await ModelSourcing.GetCatalogAsync(Services, SourceNodeId, _model.Image);
        _maxModelLenPresets = VllmOptionsCatalog.MaxModelLenPresetsFor(null);
        _maxModelLenCustom = !_maxModelLenPresets.Contains(_model.MaxModelLen);
        _maxNumSeqsCustom = !VllmOptionsCatalog.MaxNumSeqsPresets.Contains(_model.MaxNumSeqs);

        if (IsNew)
        {
            await LoadFoldersAsync();
            if (string.Equals(SourceQuery, "download", StringComparison.OrdinalIgnoreCase))
            {
                _source = SourceMode.Download;
            }

            await AttachToNodeDownloadAsync();
        }

        if (!IsNew && IsLlamaCpp && !string.IsNullOrWhiteSpace(_model.ModelPath))
        {
            await ReadGgufAsync(); // the header behind the estimate; the stored settings stay as they are
        }

        RecomputeMlx(); // an existing MLX model: the estimate from its folder's inspection

        if (_multiNode)
        {
            await RefreshFitAsync();
            await RefreshMoveAsync();
            StartLiveRefresh();
        }
    }

