@page "/not-found"
@layout MainLayout

<PageTitle>Not found · MirbadLLM</PageTitle>

<PageHeader Title="Page not found" />
<EmptyState Title="Nothing lives at this address">
    <ChildContent><p>The page may have moved, or a model it pointed to was deleted.</p></ChildContent>
    <Actions>
        <a class="btn btn-primary" href="/">Go to Dashboard</a>
        <a class="btn btn-outline-secondary" href="models">See all models</a>
    </Actions>
</EmptyState>
