@page "/models"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using MirbadLLM.Orchestration
@using MirbadLLM.Orchestration.Benchmarking
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Models · MirbadLLM</PageTitle>

<PageHeader Title="Models">
    <Subtitle>Every model on the fleet, where it runs and how it is doing. Start, stop and open each one from here. <LiveStamp At="_loadedAt" TestId="models-updated" /></Subtitle>
    <Actions>
        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="btn btn-primary" href="models/new" data-testid="add-model" data-tour="add-model"><Icon Name="plus" /> Add model</a>
    </Actions>
</PageHeader>

@if ((_lifecycle?.Error ?? _liveError ?? _nodesError) is { } error)
{
    <div class="callout callout--failed page-alert" role="alert" data-testid="models-error">
        <Icon Name="state-failed" />
        <div class="callout-body">@error</div>
    </div>
}

@if (_rows is null)
{
    <p class="muted" role="status">Loading models…</p>
}
else if (_rows.Count == 0)
{
    <EmptyState Title="No models yet" TestId="models-empty">
        <ChildContent>
            <p>
                A model is one runtime (such as vLLM, llama.cpp or SGLang) serving one checkpoint under a served name, on one node.
                Add one from a checkpoint folder that is already on a node, or download a checkpoint from Hugging Face first.
                You set its node, memory budget and context length in the editor, then start it here.
            </p>
        </ChildContent>
        <Actions>
            <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="btn btn-primary" href="models/new"><Icon Name="folder" /> Add from a folder</a>
            <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="btn btn-outline-secondary" href="models/new?source=download"><Icon Name="download" /> Download from Hugging Face</a>
        </Actions>
    </EmptyState>
}
else
{
    <div class="models-toolbar">
        <div class="models-find">
            <label class="form-label" for="models-find-input">Find <kbd class="models-key" title="Press / to jump here">/</kbd></label>
            <input id="models-find-input" class="form-control" type="search" placeholder="Served name, id or node"
                   autocomplete="off" spellcheck="false" data-testid="models-filter" data-shortcut-filter
                   @bind="_text" @bind:event="oninput" />
        </div>
        @if (_nodeOptions.Count > 1)
        {
            <NodeFilter Nodes="_nodeOptions" Selected="@SelectedNode" SelectedChanged="OnNodeChanged" TestId="models-node-filter" />
        }
        <span class="models-count num">@Shown.Count of @_rows.Count models · @_rows.Count(r => IsRunning(r)) running</span>
    </div>
    <TagFilter Counts="_tagCounts" Selected="_selectedTags" SelectedChanged="OnTagsChanged" Matching="Shown.Count" Total="_rows.Count" TestId="models-tag-filter" />

    var shown = Shown;
    @if (shown.Count == 0)
    {
        <EmptyState Title="No model matches" HeadingLevel="2" Inline="true" TestId="models-filter-empty">
            <ChildContent>
                <p>@NoMatchText</p>
            </ChildContent>
        </EmptyState>
    }
    else
    {
        var pageRows = Pager.Slice(shown.OrderBy(r => IsRunning(r) ? 0 : 1).ToList(), _page, _size);
        <div class="panel panel--scroll-x models-panel">
            <table class="data-table models-table" data-testid="models-table" data-tour="models-list">
                <caption class="visually-hidden">Models: placement, state, memory, context, KV cache, speculative decoding, token throughput, requests and actions</caption>
                <thead>
                    <tr>
                        <th scope="col">Model</th>
                        <th scope="col">Where</th>
                        <th scope="col" class="col-state">State</th>
                        <th scope="col" class="col-num" title="Memory reserved for it on its node (its budget)">Memory</th>
                        <th scope="col" class="col-num" title="Context length in tokens">Context</th>
                        <th scope="col" class="col-opt">KV cache</th>
                        <th scope="col" class="col-opt">Speculative</th>
                        <th scope="col" class="col-num">Tok/s</th>
                        <th scope="col" class="col-num">Requests</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (bool active in Groups)
                    {
                        var groupRows = pageRows.Where(r => IsRunning(r) == active).ToList();
                        bool expanded = active ? _showRunning : _showStopped;
                        <tr class="models-group"><th colspan="10"><button @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" type="button" aria-expanded="@expanded" data-testid="@(active ? "models-running-group" : "models-stopped-group")" @onclick="() => ToggleGroup(active)"><Icon Name="@(expanded ? "chevron-down" : "chevron-right")" /> @(active ? "Running" : "Stopped") · @shown.Count(r => IsRunning(r) == active)</button></th></tr>
                        @if (expanded)
                        {
                    @for (int i = 0; i < groupRows.Count; i++)
                    {
                        var row = groupRows[i];
                        var d = row.Definition;
                        var state = row.Status.State;
                        var router = _routerStats.GetValueOrDefault(d.ServedName);
                        bool first = d.Id == pageRows[0].Definition.Id;
                        <tr @key="d.Id" class="models-row" tabindex="0" @ref="_rowRefs[d.Id]" aria-label="@($"Show details for {d.ServedName}")" @onclick="() => OpenDetails(d.Id)" @onkeydown="e => OnRowKey(e, d.Id)" data-drawer-keep data-state="@state.ToString().ToLowerInvariant()" data-testid="@($"models-row-{d.Id}")">
                            <td class="col-primary">
                                <span class="models-swatch" style="@($"background:{_colors.GetValueOrDefault(d.Id)}")" aria-hidden="true"></span>
                                <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="models-name" href="@($"models/{d.Id}/overview")" data-testid="@($"models-link-{d.Id}")">@foreach (string part in NameParts(d.ServedName)) { <span class="models-name-part">@part</span><wbr /> }</a>
                                @if (!string.Equals(d.Id, d.ServedName, StringComparison.Ordinal))
                                {
                                    <div class="models-id">@d.Id</div>
                                }
                                <TagList Tags="d.Tags" Max="3" TestId="@($"models-tags-{d.Id}")" />
                            </td>
                            <td class="models-place" data-label="Where" data-testid="@($"models-node-{d.Id}")">
                                <span class="models-node">
                                    <Icon Name="server" />
                                    @if (d.Placement?.NodeId is { Length: > 0 } nodeId)
                                    {
                                        var node = NodeOf(nodeId);
                                        @if (node is not null)
                                        {
                                            <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" href="@($"nodes/{Uri.EscapeDataString(nodeId)}")">@node.Name</a>
                                            @if (!node.IsServing)
                                            {
                                                <span class="models-node-state">@StateBadge.NodeLook(node.State).Label</span>
                                            }
                                        }
                                        else
                                        {
                                            <span title="The master has no such node">@nodeId</span>
                                        }
                                        @if (FleetNodes.GpuText(d, node) is { } gpus)
                                        {
                                            <span class="models-gpus">@gpus</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">Not placed</span>
                                    }
                                </span>
                            <div class="models-runtime">@FleetNodes.RuntimeLabel(d.Runtime)</div>
                            </td>
                            <td class="col-state" data-label="State">
                                <div class="models-state">
                                    <StateBadge State="state" Since="row.Status.Since" Now="_now" TestId="@($"state-{d.Id}")" />
                                    @if (row.Job is { } job)
                                    {
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="chip chip--busy" href="@($"models/{d.Id}/{(job == JobKind.Tuning ? "tune" : "benchmark")}")"
                                           data-testid="@($"models-job-{d.Id}")"><Icon Name="gauge" /> @(job == JobKind.Tuning ? "Tuning" : "Benchmarking")</a>
                                    }
                                    else if (row.Status.RestartPending && state is ModelState.Ready or ModelState.Starting)
                                    {
                                        <span class="chip chip--busy" data-testid="@($"models-restart-pending-{d.Id}")"><Icon Name="refresh" /> Restart pending</span>
                                        <button @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" type="button" class="btn btn-sm btn-outline-secondary" data-testid="@($"models-apply-{d.Id}")"
                                                aria-label="@($"Apply saved settings to {d.ServedName}")" @onclick="() => ApplyAsync(d)">Apply</button>
                                    }
                                </div>
                                @if (row.Crash is { } crash && state is ModelState.Failed or ModelState.Starting)
                                {
                                    <p class="models-cause" data-testid="@($"crash-{d.Id}")"><span class="failure-cause">@UiFormat.CrashNote(crash)</span></p>
                                }
                                @if (state == ModelState.Failed)
                                {
                                    <p class="models-cause" data-testid="@($"failure-{d.Id}")">
                                        <span class="failure-cause">@UiFormat.FailureSummary(row.Status.Error, 140)</span>
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" href="@($"models/{d.Id}/logs")" aria-label="@($"Logs for {d.ServedName}")">Logs</a>
                                    </p>
                                }
                                else if (row.Progress is { } progress)
                                {
                                    <p class="models-cause" data-testid="@($"progress-{d.Id}")">
                                        <span class="failure-cause">@progress.Text</span>
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" href="@($"models/{d.Id}/logs")" aria-label="@($"Logs for {d.ServedName}")">Logs</a>
                                    </p>
                                }
                                @if (OnDemand(d) is { } onDemand)
                                {
                                    <p class="models-cause" data-testid="@($"on-demand-{d.Id}")">@onDemand</p>
                                }
                            </td>
                            <td data-label="Memory" class="num col-num" data-testid="@($"models-memory-{d.Id}")">@UiFormat.GiB(d.MemoryBudgetGiB)</td>
                            <td data-label="Context" class="num col-num" data-testid="@($"models-context-{d.Id}")">@UiFormat.ContextLength(ModelCapabilities.MaxModelLen(d))</td>
                            <td data-label="KV cache" class="num col-opt" data-testid="@($"models-kv-{d.Id}")">@UiFormat.KvCacheLabel(d)</td>
                            <td data-label="Speculative" class="num col-opt" data-testid="@($"models-spec-{d.Id}")">@UiFormat.SpeculativeLabel(d.Speculative)</td>
                            <td data-label="tok/s" class="num col-num">
                                <div class="models-rate">
                                    <Sparkline Values="@Trend(d)" Color="@_colors.GetValueOrDefault(d.Id)" Label="Throughput, last 3 minutes" />
                                    <span data-testid="@($"tok-s-{d.Id}")">@(state == ModelState.Ready ? UiFormat.Number(row.TokS) : UiFormat.Missing)</span>
                                </div>
                                @if (PoolingDetection.Detect(d) != PoolingMode.None) { <small class="muted">input tok/s</small> }
                            </td>
                            <td data-label="Requests" class="num col-num">
                                @(router is null ? UiFormat.Missing : UiFormat.Whole(router.TotalRequests))
                                @if (ErrorPercent(router) is > 5) { <small class="models-errors" title="@FailedTip(router!)" data-testid="@($"models-errors-{d.Id}")">@UiFormat.Percent(ErrorPercent(router)) failed</small> }
                            </td>
                            <td class="col-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <span class="row-actions">
                                    @{ bool busy = _lifecycle?.IsBusy(d.Id) == true; string? blocked = row.Job is null ? null : "A benchmark or tuning job is measuring this model"; }
                                    @if (state is ModelState.Stopped or ModelState.Failed)
                                    {
                                        <button @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" type="button" class="btn btn-sm btn-outline-secondary models-act models-act--start" disabled="@(busy || blocked is not null)"
                                                title="@blocked" data-testid="@($"start-{d.Id}")" data-tour="@(first ? "model-start" : null)"
                                                aria-label="@($"Start {d.ServedName}")" @onclick="() => StartAsync(d.Id)">
                                            <Icon Name="play" /> @(_lifecycle?.IsQueued(d.Id) == true ? "Queued" : busy ? "Starting…" : "Start")
                                        </button>
                                        @if (_lifecycle?.IsQueued(d.Id) == true)
                                        {
                                            <button type="button" class="btn btn-sm btn-ghost" data-testid="@($"cancel-start-{d.Id}")" aria-label="@($"Cancel queued start for {d.ServedName}")" @onclick="() => _lifecycle.CancelStart(d.Id)">Cancel</button>
                                        }
                                    }
                                    else if (state is ModelState.Ready or ModelState.Starting)
                                    {
                                        <button @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" type="button" class="btn btn-sm btn-outline-secondary models-act" disabled="@(busy || blocked is not null)"
                                                title="@blocked" data-testid="@($"stop-{d.Id}")" data-tour="@(first ? "model-start" : null)"
                                                aria-label="@($"Stop {d.ServedName}")" @onclick="() => StopAsync(d.Id)">
                                            <Icon Name="stop" /> @(busy ? "Stopping…" : "Stop")
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" type="button" class="btn btn-sm btn-outline-secondary models-act" disabled data-tour="@(first ? "model-start" : null)">
                                            <Icon Name="stop" /> Stopping…
                                        </button>
                                    }
                                    <RowMenu Id="@($"models-{d.Id}")" Label="@($"More actions for {d.ServedName}")" TestId="@($"models-more-{d.Id}")">
                                        @if (state == ModelState.Ready)
                                        {
                                            <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="row-menu-item" role="menuitem" tabindex="-1" href="@($"chat?model={Uri.EscapeDataString(d.ServedName)}")"
                                               aria-label="@($"Chat with {d.ServedName}")" data-testid="@($"models-chat-{d.Id}")"><Icon Name="chat" /> Chat</a>
                                        }
                                        else
                                        {
                                            <span class="row-menu-item models-menu-off" role="menuitem" aria-disabled="true" data-testid="@($"models-chat-{d.Id}")">
                                                <Icon Name="chat" /> <span>Chat <span class="models-menu-why">· start it first</span></span>
                                            </span>
                                        }
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="row-menu-item" role="menuitem" tabindex="-1" href="@($"models/{d.Id}/logs")" data-testid="@($"models-logs-{d.Id}")"><Icon Name="logs" /> Logs</a>
                                        @if (state == ModelState.Ready)
                                        {
                                            <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="row-menu-item" role="menuitem" tabindex="-1" href="@($"models/{d.Id}/benchmark")" data-testid="@($"models-benchmark-{d.Id}")"><Icon Name="gauge" /> Benchmark</a>
                                        }
                                        else
                                        {
                                            <span class="row-menu-item models-menu-off" role="menuitem" aria-disabled="true" data-testid="@($"models-benchmark-{d.Id}")">
                                                <Icon Name="gauge" /> <span>Benchmark <span class="models-menu-why">· needs Ready</span></span>
                                            </span>
                                        }
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="row-menu-item" role="menuitem" tabindex="-1" href="@($"models/{d.Id}/tune")" data-testid="@($"models-tune-{d.Id}")"><Icon Name="sliders" /> Tune</a>
                                        <a @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="row-menu-item" role="menuitem" tabindex="-1" href="@($"models/{d.Id}")" aria-label="@($"Edit {d.ServedName}")" data-testid="@($"models-edit-{d.Id}")"><Icon Name="edit" /> Edit</a>
                                    </RowMenu>
                                </span>
                            </td>
                        </tr>
                    }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    <Pager Total="shown.Count" @bind-Page="_page" @bind-Size="_size" ResetKey="@PagerResetKey" Noun="models" TestId="models-pager" />
}

<ModelLifecycle @ref="_lifecycle" Models="_definitions" NodeRows="_nodeRows" ReserveGiB="_reserveGiB" Changed="LoadAsync" />
@if (SelectedRow is { } selected)
{
    var definition = selected.Definition;
    var load = _latestKpis.GetValueOrDefault(definition.Id)?.Load;
    var router = _routerStats.GetValueOrDefault(definition.ServedName);
    <Drawer Open="true" TitleId="models-detail-title" OnClose="CloseDetails" TestId="models-drawer">
        <Header><h2 id="models-detail-title">@definition.ServedName</h2><StateBadge State="selected.Status.State" /></Header>
        <ChildContent>
            <div class="models-detail-hero">
                <div><span class="panel-label">@(PoolingDetection.Detect(definition) == PoolingMode.None ? "Generation" : "Input")</span><strong class="num">@UiFormat.Number(selected.TokS) <small>tok/s</small></strong></div>
                <div><span class="panel-label">Running · waiting</span><LoadPips Running="@(load?.RunningRequests ?? double.NaN)" Waiting="@(load?.WaitingRequests ?? double.NaN)" /></div>
                <RingGauge Percent="@(load?.KvCacheUsage * 100)" Label="KV cache" Size="56" ShowValue="true" />
            </div>
            <LineChart Title="Throughput, last 3 minutes" Unit="tok/s" Height="120" Series="@DetailSeries(definition)" />
            <h3 class="panel-label">Placement and settings</h3>
            <dl class="kv">
                <dt>Node</dt><dd>@if (definition.Placement?.NodeId is { } nodeId) { <a href="@($"nodes/{Uri.EscapeDataString(nodeId)}")">@(NodeOf(nodeId)?.Name ?? nodeId)</a> } else { @:Not placed
                }</dd>
                <dt>Runtime</dt><dd>@FleetNodes.RuntimeLabel(definition.Runtime)</dd>
                <dt>OS</dt><dd>@(definition.Placement?.NodeId is { } placedId ? NodeOf(placedId)?.Capabilities?.Os.Description ?? UiFormat.Missing : UiFormat.Missing)</dd>
                <dt>Memory reserved</dt><dd class="num">@UiFormat.GiB(definition.MemoryBudgetGiB)</dd>
                <dt>Context</dt><dd class="num">@ModelCapabilities.MaxModelLen(definition).ToString("#,0", CultureInfo.InvariantCulture) tokens</dd>
                <dt>KV cache</dt><dd class="num" data-testid="models-detail-kv">@UiFormat.KvCacheLabel(definition)</dd>
                <dt>Speculative</dt><dd class="num" data-testid="models-detail-spec">@UiFormat.SpeculativeLabel(definition.Speculative)</dd>
                <dt>On demand</dt><dd data-testid="models-detail-on-demand">@(OnDemand(definition) ?? "Off")</dd>
                @if (definition.Container is { } container && definition.Runtime is RuntimeKind.Sglang or RuntimeKind.Nim)
                {
                    <dt>Image</dt><dd class="num kv-full models-detail-image" data-testid="models-detail-image">@container.Image</dd>
                }
            </dl>
            <h3 class="panel-label">Router, since controller start</h3>
            <dl class="kv"><dt>Requests</dt><dd class="num">@(router is null ? UiFormat.Missing : UiFormat.Whole(router.TotalRequests))</dd><dt>Failed</dt><dd class="num">@(router is null ? UiFormat.Missing : UiFormat.Whole(router.FailedRequests))</dd><dt>Error rate</dt><dd class="num">@UiFormat.Percent(ErrorPercent(router))</dd><dt>In flight</dt><dd class="num">@(router is null ? UiFormat.Missing : UiFormat.Whole(router.InFlight))</dd></dl>
            <div class="models-detail-actions">
                @if (selected.Status.State == ModelState.Ready)
                {
                    <a class="btn btn-primary" href="@($"chat?model={Uri.EscapeDataString(definition.ServedName)}")">Try in Playground</a>
                    <a class="btn btn-outline-secondary" href="@($"./?model={Uri.EscapeDataString(definition.Id)}")">Readout</a>
                }
                else if (selected.Status.State is ModelState.Stopped or ModelState.Failed)
                {
                    <button type="button" class="btn btn-primary" disabled="@(_lifecycle?.IsBusy(definition.Id) == true || selected.Job is not null)" @onclick="() => StartAsync(definition.Id)">@(_lifecycle?.IsQueued(definition.Id) == true ? "Queued" : "Start")</button>
                }
            </div>
        </ChildContent>
    </Drawer>
}
<ApplyChangesDialog @ref="_apply" OnFinished="AfterApplyAsync" />

@code {
    private sealed record Row(ModelDefinition Definition, ModelStatus Status, double? TokS, JobKind? Job, ModelProgressIssue? Progress = null, CrashRestart? Crash = null);

    private const string UnplacedKey = "_unplaced";
    private const LiveNeeds Needs = LiveNeeds.Models | LiveNeeds.Statuses;

    private static readonly bool[] Groups = [true, false];
    private bool _showRunning = true;
    private bool _showStopped = true;
    private string? _selectedModel;
    private string? _focusModel;
    private readonly Dictionary<string, ElementReference> _rowRefs = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, string> _colors = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, ModelKpis> _latestKpis = new Dictionary<string, ModelKpis>();
    private IReadOnlyDictionary<string, RouterModelStats> _routerStats = new Dictionary<string, RouterModelStats>();
    [SupplyParameterFromQuery(Name = "model")] public string? ModelQuery { get; set; }
    private Row? SelectedRow => _rows?.FirstOrDefault(r => r.Definition.Id == _selectedModel);
    private static bool IsRunning(Row row) => row.Status.State is ModelState.Starting or ModelState.Ready or ModelState.Stopping;
    private void ToggleGroup(bool active) { if (active) _showRunning = !_showRunning; else _showStopped = !_showStopped; }
    private void OpenDetails(string id) { _selectedModel = id; UrlQuery.For(Nav).Replace("model", id); }
    private void CloseDetails() { _focusModel = _selectedModel; _selectedModel = null; UrlQuery.For(Nav).Replace("model", null); }
    private void OnRowKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") OpenDetails(id); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModel is { } id && _rowRefs.TryGetValue(id, out var element)) { _focusModel = null; await element.FocusAsync(preventScroll: true); }
    }
    private static double? ErrorPercent(RouterModelStats? stats) => stats is { TotalRequests: > 0 } ? 100.0 * stats.FailedRequests / stats.TotalRequests : null;

    /// <summary>What the "failed" share counts, with the two numbers behind it (the router's own rule, ProxyHandler).</summary>
    private static string FailedTip(RouterModelStats stats) =>
        $"{UiFormat.Whole(stats.FailedRequests)} of {UiFormat.Whole(stats.TotalRequests)} requests failed since the controller last started. " +
        "A request fails when the model's server answers with an error or can't be reached, or when the client disconnects before the answer ends. " +
        "Shown above 5%.";
    private IReadOnlyList<double?> Trend(ModelDefinition model) => (_history?.GetModel(model.Id, TimeSpan.FromMinutes(3)) ?? [])
        .Select(s => s.HasRates ? (double?)(PoolingDetection.Detect(model) == PoolingMode.None ? s.Kpis.Load.GenerationTokensPerSecond : s.Kpis.Load.PromptTokensPerSecond) : null).ToList();
    private IReadOnlyList<LineChartSeries> DetailSeries(ModelDefinition model) => [new("Tokens", _colors.GetValueOrDefault(model.Id, "var(--ss-series-1)"), (_history?.GetModel(model.Id, TimeSpan.FromMinutes(3)) ?? [])
        .Select(s => new LineChartPoint(s.At, s.HasRates ? (PoolingDetection.Detect(model) == PoolingMode.None ? s.Kpis.Load.GenerationTokensPerSecond : s.Kpis.Load.PromptTokensPerSecond) : null)).ToList())];

    private List<Row>? _rows;
    private IReadOnlyList<ModelDefinition> _definitions = [];
    private IReadOnlyList<(string Tag, int Count)> _tagCounts = [];
    private IReadOnlyList<string> _selectedTags = [];
    private List<Nodes.NodeRow> _nodeRows = [];
    private IReadOnlyList<NodeFilter.Option> _nodeOptions = [];
    private string? _selectedNode;
    private string _text = "";
    private int _page = 1;
    private int? _size;
    private double _reserveGiB = 8;
    private bool _startOnRequestForAll;

    /// <summary>What happens to the model without anyone pressing Start or Stop; the global AutoStartOnRequest switch counts.</summary>
    private string? OnDemand(ModelDefinition d) => UiFormat.OnDemandLabel(d.StartOnRequest || _startOnRequestForAll, d.IdleStopMinutes, d.StopToMakeRoom);
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private DateTimeOffset? _loadedAt;
    private string? _liveError;
    private string? _nodesError;

    private ModelLifecycle? _lifecycle;
    private ApplyChangesDialog? _apply;
    private CancellationTokenSource? _cts;
    private LiveDataService? _live;
    private bool _ownsLive;
    private IDisposable? _subscription;
    private IMetricsHistory? _history;
    private IModelMetricsReader? _metricsReader;
    private ModelJobService? _jobs;
    private INodeStatusCache? _nodeCache;
    private INodeRegistry? _nodeRegistry;

    /// <summary><c>?node={id}</c>: show only that node's models (the Overview's node scope, same control).</summary>
    [SupplyParameterFromQuery(Name = "node")]
    public string? NodeQuery { get; set; }

    /// <summary>The <c>?node=</c> scope while it names a node (or "not placed") on the list; otherwise none.</summary>
    private string? SelectedNode => _selectedNode is { } node && _nodeOptions.Any(o => o.Id == node) ? node : null;

    /// <summary>Rows carrying every selected tag, on the scoped node, matching the find text.</summary>
    private List<Row> Shown => _rows?
        .Where(r => ModelTags.HasAll(r.Definition, _selectedTags))
        .Where(r => SelectedNode is not { } node || string.Equals(KeyOf(r.Definition), node, StringComparison.Ordinal))
        .Where(r => Matches(r.Definition))
        .ToList() ?? [];

    private string PagerResetKey => $"{string.Join(',', _selectedTags)}|{SelectedNode}|{_text}";

    private string NoMatchText
    {
        get
        {
            var parts = new List<string>(3);
            if (!string.IsNullOrWhiteSpace(_text))
            {
                parts.Add($"matches “{_text.Trim()}”");
            }

            if (SelectedNode is { } node)
            {
                parts.Add($"is on {_nodeOptions.First(o => o.Id == node).Name}");
            }

            if (_selectedTags.Count > 0)
            {
                parts.Add($"has all of these tags: {string.Join(", ", _selectedTags.Select(ModelTags.Label))}");
            }

            return parts.Count == 0
                ? "No model to show."
                : $"No model {string.Join(" and ", parts)}. Clear the find box, pick All nodes, or turn a tag off.";
        }
    }

    private bool Matches(ModelDefinition d)
    {
        string text = _text.Trim();
        if (text.Length == 0)
        {
            return true;
        }

        string? nodeName = d.Placement?.NodeId is { } id ? NodeOf(id)?.Name ?? id : null;
        return d.ServedName.Contains(text, StringComparison.OrdinalIgnoreCase)
            || d.Id.Contains(text, StringComparison.OrdinalIgnoreCase)
            || (nodeName?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static string KeyOf(ModelDefinition d) => d.Placement?.NodeId is { Length: > 0 } node ? node : UnplacedKey;

    private Nodes.NodeRow? NodeOf(string id) => _nodeRows.FirstOrDefault(n => n.Id == id);

    private void OnTagsChanged(IReadOnlyList<string> tags) => _selectedTags = tags;

    private void OnNodeChanged(string? node)
    {
        _selectedNode = node;
        UrlQuery.For(Nav).Replace("node", node);
    }

    protected override void OnParametersSet()
    {
        _selectedNode = string.IsNullOrWhiteSpace(NodeQuery) ? null : NodeQuery;
        _selectedModel = string.IsNullOrWhiteSpace(ModelQuery) ? null : ModelQuery;
    }

    protected override async Task OnInitializedAsync()
    {
        _history = Services.GetService<IMetricsHistory>();
        _metricsReader = Services.GetService<IModelMetricsReader>();
        _jobs = Services.GetService<ModelJobService>();
        _nodeCache = Services.GetService<INodeStatusCache>();
        _nodeRegistry = Services.GetService<INodeRegistry>();
        _reserveGiB = Services.GetService<IOptions<MirbadLLMOptions>>()?.Value.MemoryReserveGiB ?? new MirbadLLMOptions().MemoryReserveGiB;
        _startOnRequestForAll = Services.GetService<IOptions<MirbadLLMOptions>>()?.Value.AutoStartOnRequest == true;

        _cts = new CancellationTokenSource();
        _live = LiveDataService.Resolve(Services, out _ownsLive);
        await ApplyAsync(await _live.GetAsync(Needs, _cts.Token));

        // Data follows the circuit's shared 5 s refresh; the 1 s clock only re-renders elapsed timers while a model is
        // Starting or Stopping.
        _subscription = _live.Subscribe(Needs,
            snapshot => InvokeAsync(async () =>
            {
                await ApplyAsync(snapshot);
                StateHasChanged();
            }),
            now => _rows?.Any(r => r.Status.State is ModelState.Starting or ModelState.Stopping) == true
                ? InvokeAsync(() =>
                {
                    _now = now;
                    StateHasChanged();
                })
                : Task.CompletedTask);
    }

    /// <summary>Reloads now through the shared service, so the status bar updates in the same pass.</summary>
    private async Task LoadAsync()
    {
        if (_live is not null)
        {
            await ApplyAsync(await _live.RefreshAsync(_cts?.Token ?? CancellationToken.None));
        }
    }

    private async Task ApplyAsync(LiveSnapshot snapshot)
    {
        var ct = _cts?.Token ?? CancellationToken.None;
        _now = DateTimeOffset.UtcNow;
        _loadedAt = snapshot.At;
        _liveError = snapshot.Error;

        var definitions = snapshot.Models ?? [];
        var statuses = snapshot.Statuses ?? new Dictionary<string, ModelStatus>();
        var reading = await FleetNodes.ReadAsync(_nodeCache, _nodeRegistry, definitions, ct);
        _nodeRows = reading.Rows;
        _nodesError = reading.Error;

        var latest = snapshot.LatestKpis;
        _latestKpis = latest;
        _colors = ModelColors.Assign(definitions.Select(d => d.Id));
        _routerStats = (Services.GetService<IRouterStats>()?.Snapshot() ?? []).ToDictionary(r => r.ServedName, StringComparer.OrdinalIgnoreCase);
        var running = _jobs?.Running ?? [];
        var recovery = Services.GetService<ModelRecoveryState>();
        var rows = new List<Row>(definitions.Count);
        foreach (var d in definitions.OrderBy(d => d.ServedName, StringComparer.OrdinalIgnoreCase))
        {
            var status = statuses.TryGetValue(d.Id, out var s) ? s : new ModelStatus(d.Id, ModelState.Stopped);
            double? tokS = null;
            if (status.State == ModelState.Ready)
            {
                var load = latest.TryGetValue(d.Id, out var kpis)
                    ? kpis.Load
                    : _history is null && _metricsReader is not null
                        ? await _metricsReader.GetAsync(d.Id, ct)
                        : null;
                tokS = PoolingDetection.Detect(d) == PoolingMode.None ? load?.GenerationTokensPerSecond : load?.PromptTokensPerSecond;
            }

            var progress = status.State == ModelState.Ready && _history is not null
                ? ModelProgress.Assess(_history.GetModel(d.Id, ModelProgress.Window), _now)
                : null;
            rows.Add(new Row(d, status, tokS, running.FirstOrDefault(j => j.ModelId == d.Id)?.Kind, progress, recovery?.CrashRestartOf(d.Id)));
        }

        _rows = rows;
        _definitions = definitions;
        _tagCounts = ModelTags.Counts(definitions);
        _nodeOptions = BuildNodeOptions(definitions);
    }

    /// <summary>All nodes by name, then placements naming a node the master does not list, then "Not placed".</summary>
    private List<NodeFilter.Option> BuildNodeOptions(IReadOnlyList<ModelDefinition> definitions)
    {
        var counts = definitions.GroupBy(KeyOf, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.Count(), StringComparer.Ordinal);
        var options = _nodeRows.Select(n => new NodeFilter.Option(n.Id, n.Name, counts.GetValueOrDefault(n.Id))).ToList();
        options.AddRange(counts.Keys
            .Where(k => k != UnplacedKey && _nodeRows.All(n => n.Id != k))
            .Order(StringComparer.Ordinal)
            .Select(k => new NodeFilter.Option(k, k, counts[k])));
        if (counts.TryGetValue(UnplacedKey, out int unplaced))
        {
            options.Add(new NodeFilter.Option(UnplacedKey, "Not placed", unplaced));
        }

        return options;
    }

    /// <summary>A served name split after each "/", so a path-like name can wrap there and nowhere else.</summary>
    public static IEnumerable<string> NameParts(string name)
    {
        int start = 0;
        for (int i = 0; i < name.Length; i++)
        {
            if (name[i] == '/')
            {
                yield return name[start..(i + 1)];
                start = i + 1;
            }
        }

        if (start < name.Length)
        {
            yield return name[start..];
        }
    }

    private Task StartAsync(string id) => _lifecycle?.StartAsync(id) ?? Task.CompletedTask;

    private Task StopAsync(string id) => _lifecycle?.StopAsync(id) ?? Task.CompletedTask;

    private async Task ApplyAsync(ModelDefinition model)
    {
        if (_apply is not null)
        {
            await _apply.OpenForPendingAsync(model);
        }
    }

    private Task AfterApplyAsync(bool restarted) => restarted ? LoadAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        _cts?.Cancel();
        if (_ownsLive && _live is not null)
        {
            await _live.DisposeAsync();
        }

        _cts?.Dispose();
    }
}
