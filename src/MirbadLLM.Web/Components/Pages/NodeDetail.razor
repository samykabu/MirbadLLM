            <Pager Total="ops.Count" @bind-Page="_opsPage" @bind-Size="_opsSize" QueryPrefix="ops" Noun="operations" TestId="node-ops-pager" />
        }
    };

    private RenderFragment AuditTable(IReadOnlyList<AuditRecord> lines, bool paged) => __builder =>
    {
        @if (_auditError is not null)
        {
            <div class="callout callout--failed" role="alert" data-testid="node-audit-error">
                <Icon Name="state-failed" />
                <div class="callout-body">@_auditError</div>
            </div>
        }
        else if (lines.Count == 0)
        {
            <p class="muted" data-testid="node-audit-empty">No commands recorded for this node yet.</p>
        }
        else
        {
            <div class="panel panel--scroll-x">
                <table class="data-table data-table--stack" data-testid="@(paged ? "node-audit-table" : "node-recent-table")">
                    <caption class="visually-hidden">Recent commands</caption>
                    <thead>
                        <tr>
                            <th scope="col">Command</th>
                            <th scope="col">Result</th>
                            <th scope="col">When</th>
                            <th scope="col">Who</th>
                            <th scope="col">Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in paged ? Pager.Slice(lines, _auditPage, _auditSize) : lines)
                        {
                            var look = ResultLook(line.Result);
                            <tr data-testid="node-audit-row" data-action="@line.Action">
                                <td class="col-primary">
                                    <div>@ActionText(line.Action)</div>
                                    @if (TargetText(line) is { } target)
                                    {
                                        <div class="model-card-id">@target</div>
                                    }
                                </td>
                                <td data-label="Result">
                                    <span class="state state--@look.Tone" data-state="@line.Result"><Icon Name="@look.Icon" /> <span>@look.Label</span></span>
                                </td>
                                <td data-label="When">
                                    <span class="num" title="@UiFormat.IsoUtc(line.Time)">@Nodes.LastSeenText(line.Time, _now)</span>
                                </td>
                                <td data-label="Who"><span title="@line.Actor">@ActorText(line.Actor)</span></td>
                                <td data-label="Detail"><span class="node-break">@DetailText(line)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (paged)
            {
                <Pager Total="lines.Count" @bind-Page="_auditPage" @bind-Size="_auditSize" QueryPrefix="audit" Noun="commands" TestId="node-audit-pager" />
            }
        }
    };

    private sealed record Look(string Label, string Icon, string Tone);

    private static Look ResultLook(string result) => result switch
    {
        AuditResults.Succeeded => new("Succeeded", "state-ready", "ready"),
        AuditResults.Refused => new("Refused", "close", "failed"),
        AuditResults.Failed => new("Failed", "state-failed", "failed"),
        AuditResults.Accepted => new("Accepted", "clock", "starting"),
        _ => new("Unknown", "info", "stopped"),
    };

    /// <summary>"node.drain" → "Drain", "model.start" → "Model start"; unknown actions as recorded.</summary>
    public static string ActionText(string action) => action switch
    {
        AuditActions.NodeJoinToken => "Join token",
        AuditActions.NodeEnroll => "Enroll",
        AuditActions.NodeApprove => "Approve",
        AuditActions.NodeReject => "Reject",
        AuditActions.NodeDrain => "Drain",
        AuditActions.NodeUndrain => "Undrain",
        AuditActions.NodeUpdate => "Settings change",
        AuditActions.NodeRevoke => "Revoke",
        AuditActions.NodeRotateCert => "Certificate rotation",
        AuditActions.ModelStart => "Model start",
        AuditActions.ModelStop => "Model stop",
        AuditActions.ModelRestart => "Model restart",
        AuditActions.ModelUnplace => "Model unplace",
        AuditActions.ModelMove => "Model move",
        AuditActions.FencingTakeover => "Takeover",
        AuditActions.FencingContinue => "Takeover continued",
        AuditActions.PkiCaRotation => "CA rotation",
        AuditActions.Download => "Download",
        AuditActions.FolderDelete => "Folder delete",
        AuditActions.HostService => "Host service",
        AuditActions.Job => "Benchmark or tuning job",
        _ => action,
    };

    /// <summary>"Admin (session 1a2b3c)", "System (pki)", "API 192.0.2.10", "Configuration".</summary>
    public static string ActorText(string actor)
    {
        ArgumentNullException.ThrowIfNull(actor);
        if (actor.StartsWith("admin:", StringComparison.Ordinal))
        {
            string hash = actor["admin:".Length..];
            return $"Admin (session {hash[..Math.Min(6, hash.Length)]})";
        }

        if (actor.StartsWith("system:", StringComparison.Ordinal))
        {
            return $"System ({actor["system:".Length..]})";
        }

        if (actor.StartsWith("api:", StringComparison.Ordinal))
        {
            return $"API {actor["api:".Length..]}";
        }

        return actor == AuditActors.Config ? "Configuration" : actor;
    }

    private static string? TargetText(AuditRecord line) =>
        string.Join(" · ", new[] { line.ModelId, line.Target, line.OperationId }.Where(v => !string.IsNullOrEmpty(v))) is { Length: > 0 } text ? text : null;

    private static string DetailText(AuditRecord line) => (line.Detail, line.ErrorCode) switch
    {
        ({ Length: > 0 } detail, { Length: > 0 } code) => $"{detail} ({code})",
        ({ Length: > 0 } detail, _) => detail,
        (_, { Length: > 0 } code) => code,
        _ => UiFormat.Missing,
    };

    // ---- Certificates ----------------------------------------------------------------------------------------------

    private CaRotationRecord? CaRotation => _caRotation?.Rotation ?? _trust?.Document.Rotation;

    private bool CaPending(string nodeId) => MasterTrustStore.IsPending(CaRotation, nodeId);

    private RenderFragment AgentCertificateSection(Nodes.NodeRow row) => __builder =>
    {
        var record = row.Record;
        var rotation = record?.Rotation;
        <section class="section" aria-labelledby="node-agent-cert-title" data-testid="node-certs">
            <div class="section-head">
                <h2 id="node-agent-cert-title">Agent certificate</h2>
            </div>
            <div class="panel panel-body">
                <dl class="kv kv--wide">
                    <dt>Expires</dt>
                    <dd><span class="num" data-testid="node-certs-expiry">@Nodes.CertExpiryText(row.CertNotAfter, _now)</span></dd>
                    <dt>Renewal due</dt>
                    <dd><span class="num" data-testid="node-certs-renewal">@(record is null || CertificateRotationService.RenewalDue(record) is not { } due ? UiFormat.Missing : UiFormat.IsoUtc(due))</span></dd>
                    <dt>Key fingerprint</dt>
                    <dd><code class="num node-fingerprint" data-testid="node-certs-pin">@PendingNodeFacts.Fingerprint(record?.CertSpkiSha256)</code></dd>
                    @if (record?.PendingCertSpkiSha256 is { } pendingPin)
                    {
                        <dt>Pending key</dt>
                        <dd><code class="num node-fingerprint" data-testid="node-certs-pending-pin">@PendingNodeFacts.Fingerprint(pendingPin)</code> <span class="muted">awaiting approval</span></dd>
                    }
                    <dt>Rotation</dt>
                    <dd data-testid="node-certs-rotation">@Nodes.RotationText(row.RotationStage)</dd>
                    @if (rotation is not null)
                    {
                        <dt>Rotation id</dt>
                        <dd><code class="num">@rotation.RotationId</code></dd>
                        <dt>Last step</dt>
                        <dd><span class="num">@UiFormat.IsoUtc(rotation.UpdatedAt)</span></dd>
                        @if (rotation.NewCertNotAfter is { } until)
                        {
                            <dt>New certificate</dt>
                            <dd>expires <span class="num">@until.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span></dd>
                        }
                        @if (rotation.Error is { } rotationError)
                        {
                            <dt>Last error</dt>
                            <dd data-testid="node-certs-error">@rotationError</dd>
                        }
                    }
                </dl>
            </div>
            <p class="muted">The master renews this certificate on its own before it expires. Rotate it by hand after a suspected key leak; re-pair the node when its key is lost or the certificate expired. Both are among the node's actions at the top of this page.</p>
        </section>

    };

    private RenderFragment CaRotationSection(Nodes.NodeRow row) => __builder =>
    {
        <section class="section" aria-labelledby="node-ca-title" data-testid="node-ca">
            <div class="section-head"><h2 id="node-ca-title">CA rotation</h2></div>
            @if (CaRotation is not { } ca)
            {
                <p class="muted" data-testid="node-ca-none">No CA rotation has run on this master.</p>
            }
            else
            {
                var progress = ca.Nodes.FirstOrDefault(n => string.Equals(n.NodeId, row.Id, StringComparison.Ordinal));
                bool open = MasterTrustStore.IsOpen(ca.Stage);
                <div class="panel panel-body">
                    <dl class="kv kv--wide">
                        <dt>Rotation</dt>
                        <dd><code class="num">@ca.RotationId</code> <span data-testid="node-ca-stage">@CaStageText(ca.Stage)</span></dd>
                        <dt>Started</dt>
                        <dd><span class="num">@UiFormat.IsoUtc(ca.StartedAt)</span></dd>
                        <dt>This node</dt>
                        <dd data-testid="node-ca-progress">@CaProgressText(ca, progress, row.Id)</dd>
                        @if (progress?.Error is { } caError)
                        {
                            <dt>Last error</dt>
                            <dd data-testid="node-ca-error">@caError</dd>
                        }
                    </dl>
                </div>
                <p class="muted" data-testid="node-ca-backups">
                    @(open
                        ? "Backups made before this rotation hold the old CA key: delete them once it closes."
                        : "Backups made before this rotation hold the old CA key: delete them.")
                </p>
            }
        </section>
    };

    private static string CaStageText(CaRotationStage stage) => stage switch
    {
        CaRotationStage.Started => "Started: the master trusts both CAs",
        CaRotationStage.AgentsTrusting => "Adding the new CA to the agents",
        CaRotationStage.MasterReissued => "Master certificates re-issued under the new CA",
        CaRotationStage.AgentsRotating => "Rotating the agent certificates",
        CaRotationStage.Closing => "Closing: removing the old CA",
        CaRotationStage.Closed => "Closed",
        CaRotationStage.ClosedEarly => "Closed early",
        _ => stage.ToString(),
    };

    private static string CaProgressText(CaRotationRecord ca, CaRotationNodeProgress? progress, string nodeId)
    {
        if (progress is null)
        {
            return MasterTrustStore.IsPending(ca, nodeId) ? "Not reached yet" : "Not part of this rotation";
        }

        if (progress.OldTrustRemoved)
        {
            return "Done: certificate under the new CA, old CA removed";
        }

        if (progress.CertificateRotated)
        {
            return "Certificate rotated under the new CA";
        }

        if (ca.Stage == CaRotationStage.ClosedEarly)
        {
            return "Not rotated before the rotation was closed early: re-pair it (rekey)";
        }

        return progress.TrustAdded ? "Trusts the new CA; certificate not rotated yet" : "Waiting to trust the new CA";
    }

    // ---- Settings --------------------------------------------------------------------------------------------------

    private sealed class SettingsForm
    {
        public string DisplayName { get; set; } = "";

        public string Address { get; set; } = "";

        public string AltAddresses { get; set; } = "";

        public string MemoryReserve { get; set; } = "";

        public Dictionary<string, string> GpuReserves { get; } = new(StringComparer.Ordinal);

        public string MaxConcurrentStarts { get; set; } = "";

        public string VllmImage { get; set; } = "";

        public string VllmDigest { get; set; } = "";

        public string LlamaImage { get; set; } = "";

        public string LlamaDigest { get; set; } = "";

        public string Labels { get; set; } = "";
    }

    private static SettingsForm FormOf(NodeRecord record, NodeCapabilities? caps)
    {
        var form = new SettingsForm
        {
            DisplayName = record.DisplayName ?? "",
            Address = record.Address,
            AltAddresses = string.Join("\n", record.AltAddresses),
            MemoryReserve = record.MemoryReserveGiB.ToString("0.###", CultureInfo.InvariantCulture),
            MaxConcurrentStarts = record.MaxConcurrentStarts?.ToString(CultureInfo.InvariantCulture) ?? "",
            VllmImage = record.DefaultVllmImage ?? "",
            VllmDigest = record.DefaultVllmImageDigest ?? "",
            LlamaImage = record.DefaultLlamaCppImage ?? "",
            LlamaDigest = record.DefaultLlamaCppImageDigest ?? "",
            Labels = string.Join(" ", record.Labels),
        };
        foreach (var gpu in (caps?.Gpus ?? []).Where(g => !g.SharesHostMemory))
        {
            form.GpuReserves[gpu.Uuid] = record.GpuReserveGiB.TryGetValue(gpu.Uuid, out double v) ? v.ToString("0.###", CultureInfo.InvariantCulture) : "";
        }

        return form;
    }

    private RenderFragment SettingsTab(Nodes.NodeRow row) => __builder =>
    {
        <Tabs Items="SettingsSections" SelectedId="@_settingsSection" SelectedIdChanged="section => _settingsSection = section"
              QueryKey="section" Variant="TabsVariant.Segmented" AriaLabel="Node settings" TestId="node-settings-tabs">
            <ChildContent Context="section">
                @switch (section)
                {
                    case "certificate":
                        @AgentCertificateSection(row)
                        break;
                    case "ca-rotation":
                        @CaRotationSection(row)
                        break;
                    case "hardware":
                        @HardwareSection(row)
                        break;
                    default:
                        @GeneralSettingsSection(row)
                        break;
                }
            </ChildContent>
        </Tabs>
    };

    private RenderFragment GeneralSettingsSection(Nodes.NodeRow row) => __builder =>
    {
        @SettingsFormSection(row)
        @if (NodeActionRules.CanRevoke(row))
        {
            @* Revoke sits alone at the end of the node's Settings, never in the header beside routine actions. *@
            <section class="danger-zone" aria-labelledby="sec-node-danger" data-testid="node-danger-zone">
                <div class="danger-zone-text">
                    <h2 class="panel-label" id="sec-node-danger">Revoke this node</h2>
                    <p class="muted">
                        The agent keeps running, but the master stops talking to it, and a revoked id cannot be used again.
                        The confirmation lets you stop and unplace the models placed on it first.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-danger" data-testid="@($"node-revoke-{row.Id}")"
                        @onclick="() => Pick(new NodeActionRequest(NodeAction.Revoke, row))"><Icon Name="trash" /> Revoke…</button>
            </section>
        }
    };

    private RenderFragment HardwareSection(Nodes.NodeRow row) => __builder =>
    {
        <section class="section" aria-labelledby="node-caps-title" data-testid="node-capabilities">
            <div class="section-head"><h2 id="node-caps-title">@(_tab == "settings" ? "Hardware and agent" : "At a glance")</h2></div>
            <div class="panel panel-body">
                <dl class="kv kv--wide">
                    <dt>Address</dt>
                    <dd><span class="num" data-testid="node-address">@(row.Address ?? UiFormat.Missing)</span></dd>
                    @if (row.AltAddresses.Count > 0)
                    {
                        <dt>Other addresses</dt>
                        <dd><span class="num">@string.Join(", ", row.AltAddresses)</span></dd>
                    }
                    <dt>Operating system</dt>
                    <dd data-testid="node-os">@Nodes.OsText(row.Capabilities)@(row.Capabilities?.Os.Kernel is { } kernel ? $" · {kernel}" : null)</dd>
                    <dt>CPU</dt>
                    <dd data-testid="node-cpu">@CpuText(row.Capabilities)</dd>
                    <dt>Memory</dt>
                    <dd data-testid="node-memory-model">@Nodes.MemoryModelText(row)</dd>
                    <dt>GPUs</dt>
                    <dd data-testid="node-gpus">
                        @if (row.Capabilities is { Gpus.Count: > 0 } caps)
                        {
                            <ul>
                                @foreach (var gpu in caps.Gpus.OrderBy(g => g.Index))
                                {
                                    <li>
                                        <span>@gpu.Name</span>
                                        @if (gpu.MemoryTotalGiB is { } vram)
                                        {
                                            @: &#160;
                                            <span class="num">@UiFormat.GiB(vram)</span>
                                        }
                                        <span class="muted">@GpuDetails(gpu)</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            @Nodes.GpuText(row.Capabilities)
                        }
                    </dd>
                    <dt>Runtimes</dt>
                    <dd data-testid="node-runtimes">@RuntimesText(row.Capabilities)</dd>
                    @foreach (var runtime in (row.Capabilities?.Runtimes ?? []).Where(r => r.Versions is not null))
                    {
                        string slug = RuntimeSlug(runtime);
                        <dt>@RuntimeName(runtime.Kind) versions</dt>
                        <dd data-testid="@($"node-runtime-versions-{slug}")">
                            @if (runtime.Versions!.Count == 0)
                            {
                                <span class="muted">None installed</span>
                            }
                            else
                            {
                                <ul class="node-versions">
                                    @foreach (var version in runtime.Versions.OrderByDescending(v => v.Default).ThenBy(v => v.Version, StringComparer.Ordinal))
                                    {
                                        <li data-testid="@($"node-runtime-version-{slug}-{version.Version}")" data-verified="@(version.Verified ? "true" : "false")">
                                            <span class="num">@version.Version</span>
                                            @if (VersionDetails(version) is { Length: > 0 } details)
                                            {
                                                <span class="muted"> · @details</span>
                                            }
                                            @if (!version.Verified)
                                            {
                                                <span class="state state--failed node-version-state"><Icon Name="state-failed" /> <span>Not verified: launches with it are refused</span></span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </dd>
                    }
                    @if (_agentStatus is { } agentStatus && agentStatus.NodeId == row.Id)
                    {
                        <dt>Clock</dt>
                        <dd data-testid="node-clock">@ClockText(agentStatus.Snapshot.Time - agentStatus.ReadAt)</dd>
                    }
                    <dt>Cache</dt><dd>@foreach (var root in row.Capabilities?.ModelRoots ?? []) { <div>@root.Name <span class="num">@UiFormat.GiB(root.FreeBytes / 1073741824.0)</span> free</div> }@if (row.Capabilities?.ModelRoots.Count is not > 0) { @UiFormat.Missing }</dd>
                    <dt>UID</dt><dd class="num node-break">@(row.Record?.Uid ?? UiFormat.Missing)</dd>
                    <dt>Agent version</dt>
                    <dd>
                        <span class="num node-break" data-testid="node-agent-version">@(row.AgentVersion ?? UiFormat.Missing)</span>
                        @if (Nodes.AgentBuildDiffers(row))
                        {
                            <div class="muted node-break" data-testid="node-agent-build">MirbadLLM is <span class="num">@ProductVersion.Controller</span>: update the agent from this master's bundle.</div>
                        }
                    </dd>
                    <dt>Protocol</dt>
                    <dd data-testid="node-protocol">@Nodes.ProtocolText(row)</dd>
                </dl>
            </div>
        </section>

    };

