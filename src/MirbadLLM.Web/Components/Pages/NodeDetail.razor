                            {
                                var runtime = runtimes.GetValueOrDefault(model.Id);
                                <tr data-testid="@($"node-model-{model.Id}")">
                                    <td class="col-primary">
                                        <a class="node-model-name" href="@($"models/{Uri.EscapeDataString(model.Id)}")" data-testid="@($"node-model-open-{model.Id}")">@model.ServedName</a>
                                        @if (!string.Equals(model.ServedName, model.Id, StringComparison.Ordinal))
                                        {
                                            <div class="model-card-id">@model.Id</div>
                                        }
                                    </td>
                                    <td data-label="State" class="node-model-state">
                                        @if (runtime is not null)
                                        {
                                            <StateBadge State="runtime.State" Since="runtime.Since" Now="_now" TestId="@($"node-model-state-{model.Id}")" />
                                            @if (runtime.State == ModelState.Failed && !string.IsNullOrWhiteSpace(runtime.Error))
