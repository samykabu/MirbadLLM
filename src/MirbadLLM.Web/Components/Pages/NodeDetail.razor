    /// <summary>Per-GPU headroom: the models segment from the collector's per-GPU model memory, else each running model's budget split over its GPUs.</summary>
    private List<GpuHeadroom> GpuHeadrooms(Nodes.NodeRow row, List<GpuRow> gpus)
    {
        var measured = (LatestSample(row.Id)?.Gpus ?? []).Where(g => g.ModelMemoryGiB is not null)
            .GroupBy(g => g.Uuid, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.Last().ModelMemoryGiB!.Values.Sum(), StringComparer.Ordinal);
        var active = ActiveModels(row);
        return [.. gpus.Select(g => new GpuHeadroom(
            g.Index,
            g.Uuid,
            g.Name,
            g.TotalGiB,
            g.FreeGiB,
            measured.TryGetValue(g.Uuid, out double m) ? m : active.Sum(model => BudgetShare(model, g.Uuid, gpus.Count)),
            g.ReserveGiB ?? 0))];
    }

    private static double BudgetShare(ModelDefinition model, string uuid, int nodeGpuCount)
    {
        var uuids = model.Placement?.GpuUuids;
        if (uuids is not { Count: > 0 })
        {
            return nodeGpuCount > 0 ? model.MemoryBudgetGiB / nodeGpuCount : 0;
        }

        return uuids.Contains(uuid, StringComparer.Ordinal) ? model.MemoryBudgetGiB / uuids.Count : 0;
    }

    // ---- Models ----------------------------------------------------------------------------------------------------

    /// <summary>Models placed on this node, plus models without a placement that this node runs (the bootstrap DGX).</summary>
    private List<ModelDefinition> ModelsHere(Nodes.NodeRow row)
    {
        var running = row.Runtimes.Select(r => r.ModelId).ToHashSet(StringComparer.Ordinal);
        return [.. (_models ?? [])
            .Where(m => string.Equals(m.Placement?.NodeId, row.Id, StringComparison.Ordinal) || (m.Placement is null && running.Contains(m.Id)))
            .OrderBy(m => m.ServedName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.Id, StringComparer.Ordinal)];
    }

    private RenderFragment ModelsSection(Nodes.NodeRow row) => __builder =>
    {
        var models = ModelsHere(row);
        <section class="section" aria-labelledby="node-models-title" data-testid="node-models">
            <div class="section-head">
                <h2 id="node-models-title">Models on this node</h2>
                <span class="section-note"><span class="num">@row.ReadyModels</span> Ready · <span class="num">@models.Count</span> placed</span>
            </div>
            @if (models.Count == 0)
            {
                <p class="muted" data-testid="node-models-empty">No model is placed on this node. Choose this node in a model's Placement section to run it here.</p>
            }
            else
            {
                var runtimes = row.Runtimes.ToDictionary(r => r.ModelId, StringComparer.Ordinal);
                <div class="panel panel--scroll-x">
                    <table class="data-table node-models-table" data-testid="node-models-table">
                        <caption class="visually-hidden">Models on this node</caption>
