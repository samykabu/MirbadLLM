                                        {
                                            <div class="muted" data-testid="@($"node-model-measured-{model.Id}")">measured at start <span class="num">@UiFormat.GiB(measured)</span></div>
                                        }
                                    </td>
                                    <td data-label="GPUs">@ModelGpusText(row, model)</td>
