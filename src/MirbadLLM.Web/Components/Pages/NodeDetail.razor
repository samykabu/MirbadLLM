                                                <div class="node-model-error" data-testid="@($"node-model-error-{model.Id}")">@UiFormat.FailureSummary(runtime.Error)</div>
                                            }
                                            else if (runtime.State == ModelState.Ready && _history is not null
                                                     && ModelProgress.Assess(_history.GetModel(model.Id, ModelProgress.Window), _now) is { } progress)
                                            {
                                                <div class="node-model-error" data-testid="@($"node-model-progress-{model.Id}")">@progress.Text</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="muted" data-testid="@($"node-model-state-{model.Id}")">@UiFormat.Missing</span>
                                        }
