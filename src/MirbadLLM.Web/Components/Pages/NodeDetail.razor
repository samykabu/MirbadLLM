                            }
                        </tbody>
                    </table>
                </div>
                <Pager Total="models.Count" @bind-Page="_modelsPage" @bind-Size="_modelsSize" QueryPrefix="models" Noun="models" TestId="node-models-pager" />
            }
        </section>
    };

    private static string ModelGpusText(Nodes.NodeRow row, ModelDefinition model)
    {
        if (model.Placement?.GpuUuids is { Count: > 0 } uuids)
        {
            var index = (row.Capabilities?.Gpus ?? []).ToDictionary(g => g.Uuid, g => g.Index, StringComparer.Ordinal);
            return string.Join(", ", uuids.Select(u => index.TryGetValue(u, out int i) ? i.ToString(CultureInfo.InvariantCulture) : u));
        }

        if (model.Placement?.GpuIndices is { Count: > 0 } indices)
        {
            return string.Join(", ", indices.Select(i => i.ToString(CultureInfo.InvariantCulture)));
        }

        return row.Capabilities?.Memory.Model == MemoryModel.Unified ? "Shared" : "All";
    }

