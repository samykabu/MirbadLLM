                            <label class="field-label" for="ns-vllm-digest">Approved vLLM image digest</label>
                            <input id="ns-vllm-digest" class="form-control" spellcheck="false" data-testid="node-settings-vllm-digest" value="@form.VllmDigest"
                                   @oninput="e => form.VllmDigest = e.Value?.ToString() ?? string.Empty" aria-describedby="ns-vllm-digest-hint" />
                            <span class="field-hint" id="ns-vllm-digest-hint"><code>sha256:</code> + 64 hex digits; an agent that refuses tag pulls runs only this digest.</span>
                        </div>
                        <div class="field field--wide">
                            <label class="field-label" for="ns-llama">Default llama.cpp image</label>
                            <input id="ns-llama" class="form-control" spellcheck="false" data-testid="node-settings-llama" value="@form.LlamaImage"
                                   @oninput="e => form.LlamaImage = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="field field--wide">
                            <label class="field-label" for="ns-llama-digest">Approved llama.cpp image digest</label>
                            <input id="ns-llama-digest" class="form-control" spellcheck="false" data-testid="node-settings-llama-digest" value="@form.LlamaDigest"
                                   @oninput="e => form.LlamaDigest = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div></section>
                    @if (_formError is not null)
                    {
                        <div class="callout callout--failed" role="alert" data-testid="node-settings-error">
                            <Icon Name="state-failed" />
                            <div class="callout-body">@_formError</div>
                        </div>
                    }
                    @if (SettingsDirty(row))
                    {
                    <div class="node-settings-actions" role="status">
                        <button type="submit" class="btn btn-primary" data-testid="node-settings-save" disabled="@_saving"><Icon Name="check" /> Save</button>
                        <button type="button" class="btn btn-outline-secondary" data-testid="node-settings-reset" disabled="@_saving" @onclick="ResetForm">Discard changes</button>
                    </div>
                    }
                </form>
            }
        </section>
    };

    private bool SettingsDirty(Nodes.NodeRow row)
    {
        if (_form is null || row.Record is null) return false;
        try { return !IsEmpty(BuildPatch(_form, row.Record)); }
        catch (FormatException) { return true; }
    }

    private void ResetForm()
    {
        _form = null;
        _formError = null;
    }

    /// <summary>Sends only the fields that differ from the stored record (absent = keep), as one PATCH.</summary>
    private async Task SaveAsync()
    {
        if (_admin is null || _caller is null || _form is not { } form || _row?.Record is not { } record)
        {
            return;
        }

        _formError = null;
        NodePatchRequest patch;
        try
        {
            patch = BuildPatch(form, record);
        }
        catch (FormatException ex)
        {
            _formError = ex.Message;
            return;
        }

        if (IsEmpty(patch))
        {
            _status = "Nothing to save: the settings are unchanged.";
            return;
        }

        _saving = true;
        try
        {
            await _admin.PatchAsync(record.Id, patch, _caller);
            _status = $"Saved the settings of {_row.Name}.";
            _form = null;
            await ReloadAsync();
        }
        catch (NodeApiException ex)
        {
            _formError = ex.Message;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or TimeoutException)
        {
            _formError = $"The master could not complete this: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private static NodePatchRequest BuildPatch(SettingsForm form, NodeRecord record)
    {
        static string? Changed(string value, string? stored) =>
            string.Equals(value.Trim(), stored ?? "", StringComparison.Ordinal) ? null : value.Trim();

        static double ParseGiB(string text, string field) =>
            double.TryParse(text.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out double v)
                ? v
                : throw new FormatException($"{field} must be a number of GiB, e.g. 8 or 4.5.");

        var alt = form.AltAddresses.Split(['\n', '\r', ',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var labels = form.Labels.Split([' ', ',', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

        double? reserve = null;
        if (form.MemoryReserve.Trim().Length == 0)
        {
            throw new FormatException("Memory reserve is required (0 for none).");
        }

        double parsedReserve = ParseGiB(form.MemoryReserve, "Memory reserve");
        if (parsedReserve != record.MemoryReserveGiB)
        {
            reserve = parsedReserve;
        }

        Dictionary<string, double>? gpuReserves = null;
        if (form.GpuReserves.Count > 0)
        {
            var map = new Dictionary<string, double>(record.GpuReserveGiB, StringComparer.Ordinal);
            foreach ((string uuid, string text) in form.GpuReserves)
            {
                if (text.Trim().Length == 0)
                {
                    map.Remove(uuid);
                }
                else
                {
                    map[uuid] = ParseGiB(text, "A GPU reserve");
                }
            }

            bool same = map.Count == record.GpuReserveGiB.Count && map.All(kv => record.GpuReserveGiB.TryGetValue(kv.Key, out double v) && v == kv.Value);
            gpuReserves = same ? null : map;
        }

        int? starts = null;
        string startsText = form.MaxConcurrentStarts.Trim();
        int parsedStarts = startsText.Length == 0
            ? 0
            : int.TryParse(startsText, NumberStyles.Integer, CultureInfo.InvariantCulture, out int s) && s > 0
                ? s
                : throw new FormatException("Concurrent starts must be a whole number of 1 or more (empty = the default).");
        if (parsedStarts != (record.MaxConcurrentStarts ?? 0))
        {
            starts = parsedStarts;
        }

        return new NodePatchRequest
        {
            DisplayName = Changed(form.DisplayName, record.DisplayName),
            Address = Changed(form.Address, record.Address),
            AltAddresses = alt.SequenceEqual(record.AltAddresses, StringComparer.Ordinal) ? null : alt,
            MemoryReserveGiB = reserve,
            GpuReserveGiB = gpuReserves,
            MaxConcurrentStarts = starts,
            DefaultVllmImage = Changed(form.VllmImage, record.DefaultVllmImage),
            DefaultVllmImageDigest = Changed(form.VllmDigest, record.DefaultVllmImageDigest),
            DefaultLlamaCppImage = Changed(form.LlamaImage, record.DefaultLlamaCppImage),
            DefaultLlamaCppImageDigest = Changed(form.LlamaDigest, record.DefaultLlamaCppImageDigest),
            Labels = labels.SequenceEqual(record.Labels, StringComparer.Ordinal) ? null : labels,
        };
    }

    private static bool IsEmpty(NodePatchRequest patch) =>
        patch is
        {
            DisplayName: null, Address: null, AltAddresses: null, MemoryReserveGiB: null, GpuReserveGiB: null, MaxConcurrentStarts: null,
            DefaultVllmImage: null, DefaultVllmImageDigest: null, DefaultLlamaCppImage: null, DefaultLlamaCppImageDigest: null, Labels: null,
        };

    // ---- Shared helpers --------------------------------------------------------------------------------------------

    private List<ModelDefinition> ActiveModels(Nodes.NodeRow row)
    {
        var active = row.Runtimes
            .Where(r => r.State is ModelState.Starting or ModelState.Ready or ModelState.Stopping)
            .Select(r => r.ModelId)
            .ToHashSet(StringComparer.Ordinal);
        return [.. (_models ?? []).Where(m => active.Contains(m.Id))];
    }

    /// <summary>Budgets of the models placed here whose instance is Starting, Ready or Stopping (as the Dashboard counts them).</summary>
    private double ModelsGiB(Nodes.NodeRow row) => ActiveModels(row).Sum(m => m.MemoryBudgetGiB);

    private static string GpuName(Nodes.NodeRow row, GpuMemorySnapshot gpu)
    {
        string? name = row.Capabilities?.Gpus.FirstOrDefault(g => string.Equals(g.Uuid, gpu.Uuid, StringComparison.Ordinal))?.Name;
        return string.Create(CultureInfo.InvariantCulture, $"{gpu.Index}: {name ?? gpu.Uuid}");
    }

    private static string GpuDetails(GpuCapability gpu)
    {
        var parts = new List<string>();
        if (gpu.ComputeCapability is { } cc)
        {
            parts.Add($"compute {cc}");
        }

        if (gpu.Driver is { } driver)
        {
            parts.Add($"driver {driver}");
        }

        if (gpu.SharesHostMemory)
        {
            parts.Add("shares host memory");
        }

        return parts.Count == 0 ? "" : $" · {string.Join(" · ", parts)}";
    }

    private static string CpuText(NodeCapabilities? capabilities) => capabilities?.Cpu switch
    {
        null => UiFormat.Missing,
        { Model: { } model } cpu => string.Create(CultureInfo.InvariantCulture, $"{model} · {cpu.LogicalCores} logical cores"),
        var cpu => string.Create(CultureInfo.InvariantCulture, $"{cpu.LogicalCores} logical cores"),
    };

    private static string RuntimesText(NodeCapabilities? capabilities)
    {
        if (capabilities is null)
        {
            return UiFormat.Missing;
        }

        if (capabilities.Runtimes.Count == 0)
        {
            return "None";
        }

        return string.Join(", ", capabilities.Runtimes.Select(r =>
            $"{RuntimeName(r.Kind)} ({(r.Delivery == LaunchDelivery.Container ? "container" : "process")}{(r.Available ? "" : ", unavailable")})"));
    }

    /// <summary>The runtimes a node can launch (vLLM, llama.cpp…), once each, in a stable order, for the header chips.</summary>
    public static IReadOnlyList<RuntimeKind> RuntimeKinds(NodeCapabilities? capabilities) =>
        [.. (capabilities?.Runtimes ?? []).Where(r => r.Available).Select(r => r.Kind).Distinct().Order()];

    private static string RuntimeName(RuntimeKind kind) => kind switch
    {
        RuntimeKind.Vllm => "vLLM",
        RuntimeKind.LlamaCpp => "llama.cpp",
        RuntimeKind.Mlx => "MLX",
        _ => kind.ToString(),
    };

    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        if (_ownsLive && _live is not null)
        {
            await _live.DisposeAsync();
        }
    }
}
