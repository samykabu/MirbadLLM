@page "/nodes/{Id}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using MirbadLLM.Orchestration
@using MirbadLLM.Orchestration.Benchmarking
@using MirbadLLM.Agent.Contracts
@using MirbadLLM.Orchestration.Pki
@using MirbadLLM.Web.Api
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav

<PageTitle>@(_row?.Name ?? Id) · Nodes · MirbadLLM</PageTitle>

<div class="node-identity">
<PageHeader Title="@Id" BackHref="nodes" BackLabel="Nodes">
    <Subtitle>
        <div class="node-head-meta">
            @if (!string.Equals(_row?.Name ?? Id, Id, StringComparison.Ordinal))
            {
                <span class="num node-head-id" data-testid="node-id">@Id</span><span>@_row?.Name</span>
            }
            @if (_row is { } head)
            {
                <StateBadge Node="head.State" Draining="Nodes.BadgeDraining(head)" TestId="node-state-badge" />
                @if (Nodes.ShowDrainingChip(head))
                {
                    <span class="chip chip--busy chip--inline" data-testid="node-draining"><Icon Name="state-stopping" /> Draining</span>
                }
                @if (JobHere is { } headJob)
                {
                    <a class="chip chip--busy chip--inline" href="@Nodes.JobHref(headJob)" data-testid="node-job"><Icon Name="gauge" /> @Nodes.JobText(headJob) on @headJob.ModelId</a>
                }
                @if (Nodes.OsBadgeText(head.Capabilities) is { } os)
                {
                    <span class="tag-chip" data-testid="node-os-badge">@os</span><span class="muted">· @head.Capabilities?.Arch</span>
                }
                @foreach (var kind in RuntimeKinds(head.Capabilities))
                {
                    <span class="tag-chip" data-testid="@($"node-runtime-chip-{kind.ToString().ToLowerInvariant()}")">@RuntimeName(kind)</span>
                }
            }
        </div>
        @if (_row is { } line)
        {
            <div class="node-head-line">
                @if (line.Reasons.Count > 0 && line.State != NodeState.Online)
                {
                    <span class="node-head-reason" data-testid="node-state-reason">@line.Reasons[0]@(line.Reasons.Count > 1 ? $" (+{line.Reasons.Count - 1} more on Overview)" : "")</span>
                }
                <span>last seen <span class="num" data-testid="node-last-seen">@Nodes.LastSeenText(line.LastContact, _now)</span></span>
                <LiveStamp At="_loadedAt" TestId="node-updated" />
            </div>
        }
    </Subtitle>
    <Actions>
        @if (_row is { } header && _admin is not null && _caller is not null)
        {
            <NodeRowMenu Row="header" OnPick="Pick" CanRotate="_rotation is not null" TestIdPrefix="node" Inline="true" ShowRevoke="false" />
        }
    </Actions>
</PageHeader>
</div>

@if (_status is not null)
{
    <div class="callout callout--ready page-alert" role="status" data-testid="node-status">
        <Icon Name="state-ready" />
        <div class="callout-body">@_status</div>
    </div>
}

@if (_cache is null && _registry is null)
{
    <EmptyState Title="Node monitoring is not running" TestId="node-unavailable">
        <ChildContent>
            <p>This master has no node registry or status cache yet, so there is nothing to show for this node.</p>
        </ChildContent>
    </EmptyState>
}
else if (!_loaded)
{
    <p class="muted loading-line" role="status" data-testid="node-loading"><Icon Name="refresh" Class="icon--spin" /> Reading the node…</p>
}
else if (_row is null)
{
    @if (_error is not null)
    {
        <div class="callout callout--failed page-alert" role="alert" data-testid="node-error">
            <Icon Name="state-failed" />
            <div class="callout-body">@_error</div>
        </div>
    }
    else
    {
        <EmptyState Title="Node not found" TestId="node-not-found">
            <ChildContent>
                <p>No node has the id <code>@Id</code>. It may have been revoked or removed.</p>
            </ChildContent>
            <Actions>
                <a class="btn btn-outline-secondary" href="nodes"><Icon Name="back" /> All nodes</a>
            </Actions>
        </EmptyState>
    }
}
else
{
    var row = _row;
    @if (_error is not null)
    {
        <div class="callout callout--failed page-alert" role="alert" data-testid="node-error">
            <Icon Name="state-failed" />
            <div class="callout-body">@_error</div>
        </div>
    }

    @* The tour points at the tab bar (Overview · GPUs · Services · Operations · Settings). *@
    <div class="node-tabs" data-tour="node-tabs">
        <Tabs Items="TabItems" SelectedId="@_tab" SelectedIdChanged="OnTabChangedAsync" QueryKey="tab" AriaLabel="Node" TestId="node-tabs">
            <ChildContent Context="tab">
                @switch (tab)
                {
                    case "gpus":
                        @GpusTab(row)
                        break;
                    case "services":
                        @ServicesTab(row)
                        break;
                    case "operations":
                        @OperationsTab(row)
                        break;
                    case "settings":
                        @SettingsTab(row)
                        break;
                    default:
                        @OverviewTab(row)
                        break;
                }
            </ChildContent>
        </Tabs>
    </div>
}

@if (_admin is not null && _caller is not null)
{
    <NodeActionDialogs @bind-Request="_action" Caller="_caller" Models="_models" OnDone="OnActionDoneAsync" />
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private const int RecentOnOverview = 5;
    private const int AuditLines = 200;

    private INodeStatusCache? _cache;
    private INodeRegistry? _registry;
    private IAuditLog? _audit;
    private IFencingCoordinator? _fencing;
    private IMetricsHistory? _history;
    private ModelJobService? _jobs;
    private NodeAdminService? _admin;
    private CertificateRotationService? _rotation;
    private CaRotationService? _caRotation;
    private MasterTrustStore? _trust;
    private NodeApiCaller? _caller;
    private TimeProvider _time = TimeProvider.System;
    private Nodes.NodeRow? _row;
    private IReadOnlyList<ModelDefinition>? _models;
    private IReadOnlyList<AuditRecord>? _auditLines;
    private string? _auditError;
    private bool _loaded;
    private string? _loadedId;
    private string? _error;
    private string? _status;
    private string _tab = "overview";
    private string _settingsSection = "general";
    private static readonly IReadOnlyList<TabItem> SettingsSections =
    [
        new("general", "General"),
        new("certificate", "Agent certificate"),
        new("ca-rotation", "CA rotation"),
        new("hardware", "Hardware and agent"),
    ];
    private DateTimeOffset? _loadedAt;
    private DateTimeOffset _now;
    private int _opsPage = 1;
    private int? _opsSize;
    private int _modelsPage = 1;
    private int? _modelsSize;
    private int _auditPage = 1;
    private int? _auditSize;
    private NodeActionRequest? _action;
    private SettingsForm? _form;
    private string? _formNodeId;
    private string? _formError;
    private bool _saving;
    private LiveDataService? _live;
    private bool _ownsLive;
    private IDisposable? _subscription;
    private IAgentClientFactory? _agents;
    private AgentStatusRead? _agentStatus;
    private string? _agentStatusError;
    private int _agentReadVersion;

    /// <summary>The node agent's own status snapshot (health codes, clock, downloads) and when the master read it.</summary>
    private sealed record AgentStatusRead(string NodeId, StatusSnapshot Snapshot, DateTimeOffset ReadAt);

    /// <summary>How long the page waits for a node's status snapshot before it shows the page without it.</summary>
    private static readonly TimeSpan AgentStatusTimeout = TimeSpan.FromSeconds(5);

    // Same pacing as the list: the shared 5 s refresh, then a direct read of the node cache and registry.
    private const LiveNeeds Needs = LiveNeeds.Models;

    private IReadOnlyList<TabItem> TabItems
    {
        get
        {
            var row = _row;
            int? gpus = row?.Capabilities?.Gpus.Count is 0 && row is not null && IsMac(row) && LatestSample(row.Id)?.Gpu is not null
                ? 1
                : row?.Capabilities?.Gpus.Count;
            return
            [
                new("overview", "Overview"),
                new("gpus", "GPUs", Count: gpus, CountNoun: gpus == 1 ? "GPU" : "GPUs"),
                new("services", "Services"),
                new("operations", "Operations", Count: row is null ? null : row.OpenOperations.Count + (JobHere is null ? 0 : 1), CountNoun: "open"),
                new("settings", "Settings", BadgeText: row is not null && CaPending(row.Id) ? "CA rotation" : null, BadgeIcon: "restart", BadgeClass: "starting"),
            ];
        }
    }

    /// <summary>
    /// Tabs of the earlier layout and where their content lives now (Models on Overview, Recent commands under Operations,
    /// Certificates under Settings), so an old link still opens the right place.
    /// </summary>
    public static string TabFor(string? requested) => requested switch
    {
        "models" => "overview",
        "commands" => "operations",
        "certificates" => "settings",
        "gpus" or "services" or "operations" or "settings" => requested,
        _ => "overview",
    };

    private JobSnapshot? JobHere => _jobs?.JobOnNode(Id);

    protected override async Task OnInitializedAsync()
    {
        _cache = ServiceProvider.GetService<INodeStatusCache>();
        _registry = ServiceProvider.GetService<INodeRegistry>();
        _time = ServiceProvider.GetService<TimeProvider>() ?? TimeProvider.System;
        if (NodeSelector.FromQuery(Nav, "tab") is { } requestedTab)
        {
            _tab = TabFor(requestedTab);
            if (!string.Equals(_tab, requestedTab, StringComparison.Ordinal))
            {
                UrlQuery.For(Nav).Replace("tab", _tab == "overview" ? null : _tab);
            }
            if (requestedTab == "certificates" && NodeSelector.FromQuery(Nav, "section") is null)
            {
                _settingsSection = "certificate";
                UrlQuery.For(Nav).Replace("section", _settingsSection);
            }
        }

        if (_cache is null && _registry is null)
        {
            return;
        }

        _audit = ServiceProvider.GetService<IAuditLog>();
        _fencing = ServiceProvider.GetService<IFencingCoordinator>();
        _history = ServiceProvider.GetService<IMetricsHistory>();
        _jobs = ServiceProvider.GetService<ModelJobService>();
        _admin = ServiceProvider.GetService<NodeAdminService>();
        _rotation = ServiceProvider.GetService<CertificateRotationService>();
        _caRotation = ServiceProvider.GetService<CaRotationService>();
        _trust = ServiceProvider.GetService<MasterTrustStore>();
        _agents = ServiceProvider.GetService<IAgentClientFactory>();
        if (_admin is not null)
        {
            _caller = await NodeActionDialogs.ResolveCallerAsync(ServiceProvider, Nodes.PageHost(Nav), Nav.BaseUri);
        }

        _live = LiveDataService.Resolve(ServiceProvider, out _ownsLive);
        await LoadAsync(await _live.GetAsync(Needs));
        _subscription = _live.Subscribe(Needs, snapshot => InvokeAsync(async () =>
        {
            await LoadAsync(snapshot);
            StateHasChanged();
        }));
    }

    protected override async Task OnParametersSetAsync()
    {
        // The router reuses this component for another /nodes/{id}: show that node at once.
        if (_live?.Current is { } current && _loadedId is not null && !string.Equals(_loadedId, Id, StringComparison.Ordinal))
        {
            _status = null;
            _form = null;
            await LoadAsync(current);
        }
    }

    private async Task LoadAsync(LiveSnapshot snapshot)
    {
        try
        {
            var record = _registry is null ? null : await _registry.GetAsync(Id);
            var live = _cache?.GetNode(Id);
            _models = snapshot.Models;
            _row = (record is null || record.Revoked) && live is null ? null : Nodes.Merge(record, live, _models);
            if (_row?.State == NodeState.Revoked)
            {
                _row = null;
            }

            _error = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Could not read the node: {ex.Message}";
        }

        if (_row is not null && _tab == "operations")
        {
            await LoadAuditAsync();
        }

        // Overview (reason help), Operations (downloads) and Settings (clock) all read it; it never holds the page back.
        BeginAgentStatusRead(_row);

        _loaded = true;
        _loadedId = Id;
        _now = _time.GetUtcNow();
        _loadedAt = _now;
    }

    /// <summary>Recent audit lines about this node (design §12.1 "Recent commands", MN-116), newest first.</summary>
    private async Task LoadAuditAsync()
    {
        if (_audit is null)
        {
            _auditLines = null;
            return;
        }

        try
        {
            _auditLines = await _audit.ReadAsync(new AuditQuery { NodeId = Id, Max = AuditLines });
            _auditError = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _auditError = $"Could not read the audit log: {ex.Message}";
        }
    }

    private async Task OnTabChangedAsync(string tab)
    {
        _tab = tab;
        if (tab == "operations")
        {
            await LoadAuditAsync();
        }

        if (tab is "overview" or "operations" or "settings")
        {
            await LoadAgentStatusAsync(_row);
        }
    }

    private async Task ViewUpdateOperationsAsync()
    {
        UrlQuery.For(Nav).Replace("tab", "operations");
        await OnTabChangedAsync("operations");
    }

    // ---- Windows and native nodes (design-p3p4 §A.7, MN-227) -------------------------------------------------------

    private static bool IsLinux(Nodes.NodeRow row) =>
        string.Equals(row.Capabilities?.Os.Family?.Trim(), "linux", StringComparison.OrdinalIgnoreCase);

    private static bool IsWindows(Nodes.NodeRow row) =>
        string.Equals(row.Capabilities?.Os.Family?.Trim(), "windows", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// True for a node whose detail page reads its agent's status snapshot (health codes, clock, downloads): a serving
    /// Windows/native details, and structured health reasons for any reachable Degraded node.
    /// </summary>
    public static bool UsesAgentDetails(Nodes.NodeRow row)
    {
        ArgumentNullException.ThrowIfNull(row);
        if (!row.IsServing || row.Capabilities is not { } caps)
        {
            return false;
        }

        return row.State == NodeState.Degraded || IsWindows(row)
            || caps.Features.Contains(AgentFeatures.DownloadsHfNative, StringComparer.Ordinal)
            || caps.Features.Contains(AgentFeatures.RuntimeLlamaCppProcess, StringComparer.Ordinal);
    }

    /// <summary>
    /// Starts the agent-status read without waiting for it (MN-239 item 6, D131). The read is bounded by
    /// <see cref="AgentStatusTimeout"/>, so an unreachable Windows node would otherwise hold the whole page back by up to
    /// 5 s on first load and again on every 5 s tick of the live refresh; this way the page renders at once and the
    /// Overview fills in when the read lands. <see cref="LoadAgentStatusAsync"/>'s version guard drops an answer a newer
    /// read has overtaken, so the reads cannot cross. A tab click still waits: the operator asked for that tab.
    /// </summary>
    private void BeginAgentStatusRead(Nodes.NodeRow? row) => _ = InvokeAsync(async () =>
    {
        await LoadAgentStatusAsync(row);
        try
        {
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The page was left while the read was still out; nothing to render.
        }
    });

    /// <summary>Reads the node agent's status snapshot for the Overview (one read per refresh, bounded); a failure only says so.</summary>
    private async Task LoadAgentStatusAsync(Nodes.NodeRow? row)
    {
        int version = ++_agentReadVersion;
        if (row is null || _agents is null || !UsesAgentDetails(row))
        {
            _agentStatus = null;
            _agentStatusError = null;
            return;
        }

        string nodeId = row.Id;
        try
        {
            using var timeout = new CancellationTokenSource(AgentStatusTimeout);
            StatusSnapshot snapshot = await _agents.GetClient(nodeId).GetStatusAsync(timeout.Token);
            if (version == _agentReadVersion)
            {
                _agentStatus = new AgentStatusRead(nodeId, snapshot, _time.GetUtcNow());
                _agentStatusError = null;
            }
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            if (version == _agentReadVersion)
            {
                _agentStatus = null;
                _agentStatusError = $"Could not read the agent's own status (downloads, clock): {ex.Message}";
            }
        }
    }

    /// <summary>What to do about the Degraded reasons the Windows and native agents add (design-p3p4 §A.4.3, §A.1.2, §A.4.7).</summary>
    private List<(string Code, string Text)> ReasonHelp(Nodes.NodeRow row)
    {
        var help = new List<(string, string)>();
        if (_agentStatus is not { } status || status.NodeId != row.Id)
        {
            return help;
        }

        var codes = status.Snapshot.Health.Reasons.Select(r => r.Code).ToHashSet(StringComparer.Ordinal);
        if ((status.Snapshot.Time - status.ReadAt).Duration() > Protocol.DegradedClockSkew)
        {
            codes.Add(HealthReasonCodes.ClockSkew);
        }

        foreach (string code in HelpOrder)
        {
            if (codes.Contains(code) && ReasonHelpText(code, IsWindows(row)) is { } text)
            {
                help.Add((code, text));
            }
        }

        return help;
    }

    private static readonly string[] HelpOrder =
        [HealthReasonCodes.ModelRootLow, HealthReasonCodes.GpuExternalUseHigh, HealthReasonCodes.ExecutableUnverified, HealthReasonCodes.ClockSkew];

    /// <summary>The help line for a Degraded reason code, or null for a code without one.</summary>
    public static string? ReasonHelpText(string code, bool windows) => code switch
    {
        HealthReasonCodes.ModelRootLow =>
            "Low disk space can prevent model downloads and agent state writes. Free space on the disk containing each affected volume until it meets the threshold in the warning. " +
            "If models and cache share a disk, freeing space on that disk addresses both warnings.",
        HealthReasonCodes.GpuExternalUseHigh =>
            "Another program on this machine (a game, a 3D or video app, a browser) uses more GPU memory than the GPU's reserve. " +
            "Models keep running, but new starts on that GPU may be refused. Close the program, or raise the GPU's reserve under Settings.",
        HealthReasonCodes.ExecutableUnverified => windows
            ? "An installed llama.cpp version no longer matches its install manifest, so launches that use it are refused; other versions keep working. " +
              "Install it again on the PC: in Windows PowerShell run as administrator, run .\\install-agent.ps1 -LlamaCpp from the agent's folder."
            : "An installed llama.cpp version no longer matches its install manifest, so launches that use it are refused; other versions keep working. " +
              "Install it again on the node.",
        HealthReasonCodes.ClockSkew => windows
            ? "The PC's clock is off the master's. Above 5 minutes the agent refuses every change. Check the Windows Time service: w32tm /query /status, then w32tm /resync."
            : "The node's clock is off the master's. Above 5 minutes the agent refuses every change. Check its time synchronization.",
        _ => null,
    };

    /// <summary>"In step with the master (under 1 s apart)", "12 s ahead of the master", "45 s behind the master (Degraded above 30 s; …)".</summary>
    public static string ClockText(TimeSpan agentMinusMaster)
    {
        double seconds = Math.Abs(agentMinusMaster.TotalSeconds);
        if (seconds < 1)
        {
            return "In step with the master (under 1 s apart)";
        }

        string side = agentMinusMaster > TimeSpan.Zero ? "ahead of" : "behind";
        string amount = seconds < 120
            ? string.Create(CultureInfo.InvariantCulture, $"{seconds:0} s")
            : string.Create(CultureInfo.InvariantCulture, $"{seconds / 60:0.#} min");
        string text = $"{amount} {side} the master";
        if (seconds > Protocol.DegradedClockSkew.TotalSeconds)
        {
            text += string.Create(CultureInfo.InvariantCulture,
                $" (Degraded above {Protocol.DegradedClockSkew.TotalSeconds:0} s; above 5 min the agent refuses changes)");
        }

        return text;
    }

    private RenderFragment DownloadsSection(Nodes.NodeRow row, IReadOnlyList<NodeDownloadStatus> downloads) => __builder =>
    {
        <section class="section" aria-labelledby="node-downloads-title" data-testid="node-downloads">
            <div class="section-head">
                <h2 id="node-downloads-title">Downloads</h2>
                <span class="section-note"><span class="num">@downloads.Count(d => d.State is DownloadState.Queued or DownloadState.Downloading)</span> running</span>
            </div>
            <div class="panel panel--scroll-x">
                <table class="data-table data-table--stack" data-testid="node-downloads-table">
                    <caption class="visually-hidden">Downloads on this node</caption>
                    <thead>
                        <tr>
                            <th scope="col">Folder</th>
                            <th scope="col">State</th>
                            <th scope="col">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var download in downloads.OrderByDescending(d => d.NeedsToken).ThenByDescending(d => d.StartedAt))
                        {
                            var look = DownloadLook(download);
                            <tr data-testid="@($"node-download-{download.Folder}")">
                                <td class="col-primary">
                                    <div>@download.Folder</div>
                                    <div class="model-card-id">@download.RepoId</div>
                                </td>
                                <td data-label="State">
                                    <span class="state state--@look.Tone" data-state="@download.State.ToString().ToLowerInvariant()"><Icon Name="@look.Icon" /> <span>@look.Label</span></span>
                                    @if (download.NeedsToken)
                                    {
                                        <div data-testid="@($"node-download-needs-token-{download.Folder}")">
                                            Paused: needs the Hugging Face token again.
                                            @if (ModelForFolder(row, download.Folder) is { } model)
                                            {
                                                <span>Restart it with the token from <a href="@($"models/{Uri.EscapeDataString(model.Id)}")">@model.ServedName</a>'s download row.</span>
                                            }
                                            else
                                            {
                                                <span>Restart it with the token from the model editor's download row.</span>
                                            }
                                        </div>
                                    }
                                    else if (download.State == DownloadState.Failed && !string.IsNullOrWhiteSpace(download.Error))
                                    {
                                        <div class="muted">@UiFormat.FailureSummary(download.Error)</div>
                                    }
                                </td>
                                <td data-label="Progress" class="num">@DownloadProgressText(download)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    };

    private static Look DownloadLook(NodeDownloadStatus download) => download.State switch
    {
        DownloadState.Completed => new("Completed", "state-ready", "ready"),
        DownloadState.Failed => new("Failed", "state-failed", "failed"),
        DownloadState.Cancelled => new("Cancelled", "close", "stopped"),
        DownloadState.Queued => new("Queued", "clock", "starting"),
        _ => new("Downloading", "refresh", "starting"),
    };

    /// <summary>"3.2 GB of 8.0 GB", or "3.2 GB" when the size is unknown.</summary>
    public static string DownloadProgressText(NodeDownloadStatus download)
    {
        ArgumentNullException.ThrowIfNull(download);
        return download.TotalBytes > 0
            ? $"{UiFormat.Bytes(download.BytesDownloaded)} of {UiFormat.Bytes(download.TotalBytes)}"
            : UiFormat.Bytes(download.BytesDownloaded);
    }

    /// <summary>The model here whose checkpoint folder is <paramref name="folder"/> (case-insensitive on Windows, D125).</summary>
    private ModelDefinition? ModelForFolder(Nodes.NodeRow row, string folder)
    {
        var comparison = IsWindows(row) ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
        return ModelsHere(row).FirstOrDefault(m => string.Equals(m.ModelPath?.Trim('/', '\\'), folder, comparison));
    }

    /// <summary>
    /// A process instance's GPU memory as its agent measured it at start (design-p3p4 §A.4.3, D129 (1): WDDM reports no
    /// per-process memory, so a Windows model is never shown "measured: 0"); null for a container instance or before the
    /// start was measured.
    /// </summary>
    public static double? MeasuredAtStart(Nodes.NodeRow row, ModelDefinition model, NodeModelRuntime? runtime)
    {
        ArgumentNullException.ThrowIfNull(row);
        ArgumentNullException.ThrowIfNull(model);
        _ = row;
        if (runtime?.MeasuredGpuGiB is not { } measured || !(measured > 0) || !UiFormat.HasValue(measured))
        {
            return null;
        }

        // The model's own delivery decides, exactly as the master's attribution does (MN-230): reading it off the node's
        // runtime capabilities hid the figure on a node that reports both a container and a process runtime of that kind.
        return MirbadLLM.Orchestration.ModelMemoryAttribution.IsProcessDelivery(model) ? measured : null;
    }

    private static string RuntimeSlug(RuntimeCapability runtime) =>
        $"{runtime.Kind.ToString().ToLowerInvariant()}-{runtime.Delivery.ToString().ToLowerInvariant()}";

    /// <summary>"CUDA 13.4 · default", "CUDA 13.4", "default", or "".</summary>
    public static string VersionDetails(RuntimeVersion version)
    {
        ArgumentNullException.ThrowIfNull(version);
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(version.Cuda))
        {
            parts.Add($"CUDA {version.Cuda}");
        }

        if (version.Default)
        {
            parts.Add("default");
        }

        return string.Join(" · ", parts);
    }

    private void Pick(NodeActionRequest request)
    {
        _status = null;
        _action = request;
    }

    private async Task OnActionDoneAsync(NodeActionResult result)
    {
        _status = result.Message;
        _form = null; // the record changed: start the Settings form from the stored values again
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_live is not null)
        {
            await LoadAsync(await _live.RefreshAsync());
        }
    }

    // ---- Overview: attention, headroom and the models placed here ------------------------------------------------

    private RenderFragment OverviewTab(Nodes.NodeRow row) => __builder =>
    {
        var help = ReasonHelp(row);
        // Open operations have their tab and failed models are listed right below with their cause: not repeated here.
        var alerts = Nodes.Alerts(row, _now).Where(a => a.Key is not ("ops" or "models")).ToList();
        string? fencing = FencingText(row.Id);
        bool pending = row.Record is { Approved: false, Revoked: false };
        bool caPending = CaPending(row.Id);
        bool detailsError = _agentStatusError is not null && UsesAgentDetails(row);
        bool any = row.Reasons.Count > 0 || help.Count > 0 || row.Draining || fencing is not null || pending || alerts.Count > 0 || caPending || detailsError;

        <div class="page-grid--two node-overview"><div>
        <AgentUpdatePanel Row="row" Admin="_admin" Caller="_caller" OnViewOperations="ViewUpdateOperationsAsync" />

        <section class="section" aria-labelledby="node-memory-title" data-testid="node-memory">
            <div class="section-head">
                <h2 id="node-memory-title">Headroom</h2>
                @if (row.Memory is { } m)
                {
                    <span class="section-note">@(m.Model == MemoryModel.Discrete ? "Per GPU: what a new model can still get" : "Unified memory shared by CPU and GPU")</span>
                }
            </div>
            @if (row.Memory is { } memory)
            {
                @if (memory.Model == MemoryModel.Discrete && memory.Gpus.Count > 0)
                {
                    <MemoryHeadroom Gpus="GpuHeadrooms(row, GpuRows(row))" HostTotalGiB="memory.HostTotalGiB" HostAvailableGiB="memory.HostAvailableGiB" IdPrefix="node" Title="VRAM" />
                }
                else
                {
                    <MemoryHeadroom TotalGiB="memory.HostTotalGiB" AvailableGiB="memory.HostAvailableGiB" ModelsGiB="ModelsGiB(row)" ReserveGiB="row.ReserveGiB" />
                }
            }
            else
            {
                <p class="muted" data-testid="node-memory-missing">No memory reading from this node yet.</p>
            }
        </section>

        @ModelsSection(row)
        </div><div>
        <section class="section section--first" aria-labelledby="node-attention-title" data-testid="node-attention">
            <div class="section-head"><h2 id="node-attention-title" tabindex="-1">Attention</h2></div>
            @if (!any)
            {
                <p class="muted" data-testid="node-attention-none">Nothing needs attention on this node.</p>
            }
            else
            {
                <div class="panel panel-body node-attention">
                    @if (row.State == NodeState.Degraded)
                    {
                        <p data-testid="node-health-summary"><strong>Why this node is Degraded</strong></p>
                    }
                    @if (row.Reasons.Count > 0)
                    {
                        <ul class="node-attention-list" data-testid="node-reasons">
                            @foreach (string reason in row.Reasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    }
                    @if (help.Count > 0)
                    {
                        <ul class="node-reason-help" data-testid="node-reason-help">
                            @foreach ((string reasonCode, string text) in help)
                            {
                                <li data-code="@reasonCode" data-testid="@($"node-reason-help-{reasonCode}")"><Icon Name="info" /> <span>@text</span></li>
                            }
                        </ul>
                    }
                    @if (help.Any(h => h.Code == HealthReasonCodes.ModelRootLow))
                    {
                        <div class="node-disk-recovery" data-testid="node-disk-recovery">
                            <h3>Free disk space on @row.Id</h3>
                            <ol>
                                <li>
                                    @if (IsMac(row))
                                    {
                                        <span>On this Mac, open <strong>System Settings → General → Storage</strong>. Review large files and apps you no longer need.</span>
                                    }
                                    else if (IsWindows(row))
                                    {
                                        <span>On this PC, open <strong>Settings → System → Storage → Cleanup recommendations</strong>. Review the suggested files on the affected drive.</span>
                                    }
                                    else
                                    {
                                        <span>On this node, run <code>df -h</code> to find the full filesystem. Review large files on the disk holding the agent's configured models and cache folders.</span>
                                    }
                                </li>
                                <li>Move unwanted files to another disk or delete files you have reviewed, then empty Trash or Recycle Bin. Keep model files that are still in use; stopping a model does not free disk space.</li>
                                <li>Keep this page open. Health is checked every 5 seconds; each disk warning clears once free space meets its threshold. The node returns to Online when all health warnings are resolved.</li>
                            </ol>
                            @if (IsMac(row))
                            {
                                <a href="https://support.apple.com/102624" target="_blank" rel="noopener noreferrer" data-testid="node-disk-guide">Apple guide to freeing disk space <span class="visually-hidden">(opens a new tab)</span></a>
                            }
                            else if (IsWindows(row))
                            {
                                <a href="https://support.microsoft.com/en-us/windows/experience/storage-filemanagement/free-up-drive-space-in-windows" target="_blank" rel="noopener noreferrer" data-testid="node-disk-guide">Microsoft guide to freeing disk space <span class="visually-hidden">(opens a new tab)</span></a>
                            }
                        </div>
                    }
                    @if (alerts.Count > 0)
                    {
                        <ul class="node-alerts">
                            @foreach (var alert in alerts)
                            {
                                <li class="node-alert node-alert--@alert.Tone" data-testid="@($"node-alert-{alert.Key}")"><Icon Name="@alert.Icon" /> <span>@AlertDetail(row, alert)</span></li>
                            }
                        </ul>
                    }
                    @if (caPending)
                    {
                        <p data-testid="node-ca-pending"><Icon Name="restart" /> CA rotation: this node is not yet rotated under the new CA (see Settings).</p>
                    }
                    @if (row.Draining)
                    {
                        <p class="muted" data-testid="node-draining-note">Draining: no new starts or placements here; running models keep serving.</p>
                    }
                    @if (fencing is not null)
                    {
                        <p data-testid="node-fencing"><Icon Name="lock" /> @fencing</p>
                    }
                    @if (pending)
                    {
                        <p class="muted" data-testid="node-pending-note">
                            @(row.Record!.PendingCertSpkiSha256 is null
                                ? "Waiting for the agent to enroll with its join token. Nothing is sent to this node until it is approved."
                                : "The agent enrolled and waits for approval. Nothing is sent to this node until it is approved.")
                        </p>
                    }
                    @if (detailsError)
                    {
                        <p class="muted" data-testid="node-agent-details-error">@_agentStatusError</p>
                    }
                </div>
            }
        </section>

        @HardwareSection(row)
        </div></div>

    };

    /// <summary>The alert line with its detail where the list's short form needs one.</summary>
    private string AlertDetail(Nodes.NodeRow row, Nodes.NodeAlert alert) => alert.Key switch
    {
        "cert" => $"{alert.Text}: {Nodes.CertExpiryText(row.CertNotAfter, _now)}. The master renews it on its own; re-pair the node if it has expired.",
        "rotation" => $"{alert.Text}: {row.RotationError}",
        "agent" => $"{alert.Text}. It speaks {Nodes.ProtocolText(row)}; this master speaks protocol {MirbadLLM.Agent.Contracts.Protocol.CurrentVersion}.",
        "build" => $"{alert.Text}. The agent is {ProductVersion.Display(row.AgentVersion)}, MirbadLLM is {ProductVersion.Display(ProductVersion.Controller)}. " +
            "Use Update now in Agent update, or expand Update by hand for this node's commands.",
        _ => alert.Text,
    };

    private string? FencingText(string nodeId)
    {
        if (_fencing?.GetStatus().Nodes.FirstOrDefault(n => string.Equals(n.NodeId, nodeId, StringComparison.Ordinal)) is not { } node)
        {
            return null;
        }

        string epoch = node.AgentEpoch is { } e ? e.ToString(CultureInfo.InvariantCulture) : UiFormat.Missing;
        return node.State switch
        {
            NodeFencingState.Stale => $"Fencing: this agent follows another master with a higher epoch ({epoch}); it refuses this master's commands until a takeover.",
            NodeFencingState.Competing => $"Fencing: another master drives this agent at the same epoch ({epoch}); it refuses this master's commands.",
            NodeFencingState.PendingTakeover => "Fencing: unreachable during the last takeover; it accepts this master's epoch on its next command.",
            NodeFencingState.NeedsContinuation => $"Fencing: returned holding epoch {epoch}, not below this master's; continue the takeover for this node from the banner.",
            _ => null,
        };
    }

    // ---- GPUs ------------------------------------------------------------------------------------------------------

    private sealed record GpuRow(int Index, string Uuid, string? Name, double? TotalGiB, double? UsedGiB, double? FreeGiB,
        double? ReserveGiB, double? UtilizationPercent, string Details, bool SharesHostMemory);

    private List<GpuRow> GpuRows(Nodes.NodeRow row)
    {
        var caps = (row.Capabilities?.Gpus ?? []).ToDictionary(g => g.Uuid, StringComparer.Ordinal);
        var memory = (row.Memory?.Gpus ?? []).ToDictionary(g => g.Uuid, StringComparer.Ordinal);
        HostSample? latest = LatestSample(row.Id);
        var util = (latest?.Gpus ?? []).GroupBy(g => g.Uuid, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.Last(), StringComparer.Ordinal);
        var reserves = row.Record?.GpuReserveGiB ?? new Dictionary<string, double>();
        var result = new List<GpuRow>();
        foreach (string uuid in caps.Keys.Concat(memory.Keys).Distinct(StringComparer.Ordinal))
        {
            caps.TryGetValue(uuid, out var cap);
            memory.TryGetValue(uuid, out var mem);
            util.TryGetValue(uuid, out var sample);
            bool shares = cap?.SharesHostMemory ?? false;
            double? utilization = sample?.UtilizationPercent
                ?? (caps.Count == 1 && latest?.Gpus is null ? latest?.Gpu?.UtilizationPercent : null);
            double? total = mem?.TotalGiB ?? sample?.MemoryTotalGiB ?? cap?.MemoryTotalGiB;
            double? used = mem?.UsedGiB ?? sample?.MemoryUsedGiB;
            double? free = mem?.FreeGiB ?? (total is { } t && used is { } u ? t - u : null);
            result.Add(new GpuRow(
                cap?.Index ?? mem?.Index ?? sample?.Index ?? -1,
                uuid,
                cap?.Name,
                total,
                used,
                free,
                shares ? null : reserves.TryGetValue(uuid, out double reserve) ? reserve : 0,
                utilization,
                cap is null ? "" : GpuDetails(cap).TrimStart(' ', '·'),
                shares));
        }

        // An Apple Silicon Mac reports no GPU in its capabilities (Metal needs no GPU choice, so placement must not offer
        // one) but samples its GPU's utilisation from IOKit (Phase 4, M8): one row from the telemetry, sharing host memory.
        if (result.Count == 0 && latest?.Gpu is { } apple && IsMac(row))
        {
            string? chip = row.Capabilities?.Cpu?.Model;
            result.Add(new GpuRow(0, "", string.IsNullOrWhiteSpace(chip) ? "Apple GPU" : $"{chip} GPU", null, null, null, null,
                apple.UtilizationPercent, "Metal · utilisation from IOKit; power and temperature are not reported", SharesHostMemory: true));
        }

        return [.. result.OrderBy(g => g.Index)];
    }

    private static bool IsMac(Nodes.NodeRow row) =>
        string.Equals(row.Capabilities?.Os.Family, "macos", StringComparison.Ordinal);

    private HostSample? LatestSample(string nodeId)
    {
        try
        {
            var samples = _history?.GetHost(nodeId, TimeSpan.FromMinutes(1));
            return samples is { Count: > 0 } ? samples[^1] : null;
        }
        catch (InvalidOperationException)
        {
            return null;
        }
    }

