        <div class="kv-groups">
            <div class="kv-group">
                <h3>Throughput</h3>
                <dl class="kv">
                    <dt>Generation</dt><dd><span data-testid="kpi-gen-tps-@modelId">@Fmt(kpis.Load.GenerationTokensPerSecond)</span> tok/s</dd>
                    <dt>Prompt</dt><dd>@Fmt(kpis.Load.PromptTokensPerSecond) tok/s</dd>
                    <dt>Requests</dt><dd>@Fmt(kpis.RequestsPerMinute) /min</dd>
                    <dt>Running / waiting</dt><dd data-testid="kpi-running-waiting-@modelId">@Fmt0(kpis.Load.RunningRequests) / @Fmt0(kpis.Load.WaitingRequests)</dd>
                    <dt>KV cache</dt><dd>@FormatPercentValue(kpis.Load.KvCacheUsage * 100)</dd>
                </dl>
            </div>
            <div class="kv-group">
                <h3>Latency, p50 / p95</h3>
                <dl class="kv">
                    <dt>Time to first token</dt><dd data-testid="kpi-ttft-@modelId">@Latency(kpis.TimeToFirstToken)</dd>
                    <dt>Inter-token</dt><dd>@Latency(kpis.InterTokenLatency)</dd>
                    <dt>End-to-end</dt><dd>@Latency(kpis.EndToEndLatency)</dd>
                    <dt>Queue</dt><dd>@Latency(kpis.QueueTime)</dd>
                </dl>
            </div>
            <div class="kv-group">
                <h3>Cache and decoding</h3>
                <dl class="kv">
                    <dt>Prefix cache hits</dt><dd>@FormatPercentValue(Times100(kpis.PrefixCacheHitRate))</dd>
                    @if (kpis.SpecDecodeAcceptanceRate is not null)
                    {
                        <dt>Spec-decode accepted</dt><dd data-testid="kpi-spec-decode-@modelId">@FormatPercentValue(Times100(kpis.SpecDecodeAcceptanceRate))</dd>
                    }
                    <dt>Preemptions</dt><dd>@Fmt(kpis.PreemptionsPerMinute) /min</dd>
                    <dt>Tool calls</dt><dd>@Fmt(kpis.ToolCallsPerMinute) /min</dd>
                    <dt class="kv-full">Finished by reason, per minute</dt>
                    <dd class="kv-full" data-testid="kpi-finish-@modelId">
                        @if (kpis.FinishedByReasonPerMinute.Count == 0)
                        {
                            @UiFormat.Missing
                        }
                        else
                        {
                            <ul class="reason-list">
                                @foreach (var reason in kpis.FinishedByReasonPerMinute)
                                {
                                    <li><span class="reason-name">@reason.Key</span> <span class="num">@Fmt(reason.Value)</span></li>
                                }
                            </ul>
                        }
                    </dd>
                </dl>
            </div>
            <div class="kv-group" data-testid="kpi-router-@modelId">
                <h3>Router, since controller start</h3>
                <dl class="kv">
                    <dt>Requests</dt><dd>@(routerStats is null ? UiFormat.Missing : UiFormat.Whole(routerStats.TotalRequests))</dd>
                    <dt>Failed</dt><dd>@(routerStats is null ? UiFormat.Missing : UiFormat.Whole(routerStats.FailedRequests))</dd>
                    <dt>Error rate</dt><dd>@UiFormat.Percent(ErrorPercent(routerStats is null ? [] : [routerStats]))</dd>
                    <dt>In flight</dt><dd>@(routerStats is null ? UiFormat.Missing : UiFormat.Whole(routerStats.InFlight))</dd>
                </dl>
            </div>
        </div>
