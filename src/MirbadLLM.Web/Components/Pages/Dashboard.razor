    /// <summary>A discrete node's history (design §8.3): tiles, per-GPU utilization, host RAM and one memory chart per GPU.</summary>
    private RenderFragment DiscreteHost(IReadOnlyList<MonitoringSeries.GpuInWindow> gpus) => __builder =>
    {
        var latestHost = _hostSamples[^1];
        var used = latestHost.Memory.TotalGiB - latestHost.Memory.AvailableGiB;
        var latestGpus = latestHost.Gpus ?? [];
        var utilizations = latestGpus.Where(g => g.UtilizationPercent is not null).Select(g => g.UtilizationPercent!.Value).ToList();
        double? averageUtil = utilizations.Count == 0 ? null : utilizations.Average();
        string? firstGpu = latestGpus.Count > 1 ? $"GPU {latestGpus.Min(g => g.Index)}" : null;
        <div class="tiles tiles--4" data-testid="host-tiles-discrete">
            <StatTile Label="Host RAM used" TestId="host-memory" ShowTrend="false" Value="@UiFormat.Decimal1(used)" Unit="@($"of {UiFormat.GiB(latestHost.Memory.TotalGiB)}")"
                      Detail="@($"{UiFormat.GiB(latestHost.Memory.AvailableGiB)} free")" />
            <StatTile Label="GPU utilization" TestId="host-gpu-util" ShowTrend="false" Value="@UiFormat.Number(averageUtil)" Unit="%"
                      Detail="@(NotReported(averageUtil) ?? (latestGpus.Count > 1 ? $"average of {latestGpus.Count} GPUs" : null))" />
            <StatTile Label="Power" TestId="host-power" ShowTrend="false" Value="@UiFormat.Number(latestHost.Gpu?.PowerWatts)" Unit="W"
                      Detail="@(NotReported(latestHost.Gpu?.PowerWatts) ?? firstGpu)" />
            <StatTile Label="Temperature" TestId="host-temp" ShowTrend="false" Value="@UiFormat.Number(latestHost.Gpu?.TemperatureC)" Unit="°C"
                      Detail="@(NotReported(latestHost.Gpu?.TemperatureC) ?? firstGpu)" />
        </div>

        <div class="chart-grid" data-testid="host-charts">
            <LineChart Title="GPU utilization" Unit="%" Height="120" Series="MonitoringSeries.GpuUtilization(_hostSamples, gpus)" Help="@GpuDiscreteHelp"
                       EmptyText="@NoGpuText(SelectedOrOnlyName, MonitoringSeries.GpuUtilization(_hostSamples, gpus))" />
            <LineChart Title="Host RAM" Unit="GiB" Height="120" Stacked="true" Series="MonitoringSeries.HostRam(_hostSamples)" Help="@HostRamHelp" />
            @foreach (var gpu in gpus)
            {
                <LineChart Title="@($"{gpu.Label} memory by model")" Unit="GiB" Height="120" Stacked="true"
                           Series="MonitoringSeries.GpuMemory(_hostSamples, gpu.Uuid, _modelColors, ServedNameFor)" Help="@GpuMemoryHelp"
                           Note="@MonitoringSeries.MemorySourceNote(_hostSamples)" />
            }
        </div>
    };

    /// <summary>The tile detail for a reading this node does not report (no GPU readout, e.g. no nvidia-smi).</summary>
    private static string? NotReported(double? value) => UiFormat.HasValue(value) ? null : "Not reported by this node";

    /// <summary>The empty text of a GPU utilization chart: which node reports no utilization at all, or no samples yet.</summary>
    private string NoGpuText(string nodeName, IReadOnlyList<LineChartSeries> series) =>
        series.Any(s => s.Points.Count > 0)
            ? $"{nodeName} reports no GPU utilization (no GPU readout on this node)"
            : $"No samples in the last {FormatWindow(_window)}";

    private List<LineChartSeries> GpuUtilSeries() =>
    [
        new LineChartSeries("GPU %", "var(--ss-series-1)", _hostSamples.Select(s => new LineChartPoint(s.At, s.Gpu?.UtilizationPercent)).ToList()),
    ];

    public async ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        _cts?.Cancel();
        if (_ownsLive && _live is not null)
        {
            await _live.DisposeAsync();
        }

        _cts?.Dispose();
        _statsStore?.Flush();
    }
}
