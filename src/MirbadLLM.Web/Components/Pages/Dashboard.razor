    private string DownloadText(string nodeId)
    {
        if (!_downloads.TryGetValue(nodeId, out var list) || list is null)
        {
            return $"Downloads {UiFormat.Missing}";
        }

        var active = list.Where(d => d.State is DownloadState.Queued or DownloadState.Downloading).ToList();
        if (active.Count == 0)
        {
            return "No downloads in progress";
        }

        var first = active[0];
        string percent = first.TotalBytes > 0 ? $" · {UiFormat.Whole(100.0 * first.BytesDownloaded / first.TotalBytes)}%" : "";
        string speed = first.BytesPerSecond is double bps ? $" · {UiFormat.Bytes((long)bps)}/s" : "";
        string more = active.Count > 1 ? $" (+{active.Count - 1} more)" : "";
        return $"{(first.State == DownloadState.Queued ? "Queued" : "Downloading")} {first.RepoId}{percent}{speed}{more}";
    }

