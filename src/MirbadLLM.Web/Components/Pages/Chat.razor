@page "/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Diagnostics
@inject IModelEndpointResolver EndpointResolver
@inject IChatClient ChatClient
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider ServiceProvider

<PageTitle>Playground · MirbadLLM</PageTitle>

<PageHeader Title="Playground">
    <Subtitle>Try a model through the router, the same path API clients take. Every reply shows its time to first token and tokens per second.</Subtitle>
    <Actions>
        <button type="button" class="btn btn-outline-secondary" data-testid="chat-new" data-shortcut="new-chat" @onclick="NewChat"><Icon Name="plus" /> New chat</button>
    </Actions>
</PageHeader>

<div class="chat">
    <aside class="panel chat-settings" aria-labelledby="chat-settings-heading">
        <button type="button" class="chat-settings-toggle" aria-expanded="@(_settingsOpen ? "true" : "false")" aria-controls="chat-settings-body"
                data-testid="chat-settings-toggle" @onclick="() => _settingsOpen = !_settingsOpen">
            <Icon Name="sliders" />
            <span>Settings</span>
            <span class="chat-settings-summary num" data-testid="chat-settings-summary">
                <span class="chat-settings-model">@(string.IsNullOrEmpty(_selectedModel) ? "no model" : _selectedModel)</span>
                <span class="chat-settings-rest">@SettingsRest</span>
            </span>
            <Icon Name="chevron-down" Class="icon--chevron" />
        </button>
        <div id="chat-settings-body" class="chat-settings-body @(_settingsOpen ? "is-open" : null)">
            <h2 id="chat-settings-heading" class="chat-settings-heading">Settings</h2>
            <div class="field">
                <div class="field-head field-head--split">
                    <label class="field-label" for="chat-temperature">Temperature</label>
                    <output for="chat-temperature" class="num">@_temperature.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</output>
                </div>
                <input id="chat-temperature" type="range" class="form-range" min="0" max="2" step="0.05" data-testid="chat-temperature"
                       @bind="_temperature" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field-label" for="chat-max-tokens">Max tokens</label>
                <input id="chat-max-tokens" type="number" class="form-control num" min="1" inputmode="numeric" data-testid="chat-max-tokens" @bind="_maxTokens" />
            </div>
            <div class="form-check form-switch switch-row">
                <input class="form-check-input" type="checkbox" role="switch" id="thinking-switch" data-testid="chat-thinking" @bind="_thinkingEnabled" />
                <label class="form-check-label" for="thinking-switch">Thinking</label>
            </div>
            <div class="field">
                <label class="field-label" for="chat-system-prompt">System prompt</label>
                <textarea id="chat-system-prompt" class="form-control" rows="4" data-testid="chat-system-prompt" @bind="_systemPrompt"
                          placeholder="Optional instructions sent before every message"></textarea>
            </div>
        </div>
    </aside>

    <section class="panel chat-main" aria-label="Conversation">
        <div class="chat-picker" data-testid="chat-picker">
            <div class="field" data-tour="playground-model">
                <label class="field-label" for="chat-model">Model</label>
                <select id="chat-model" class="form-select" aria-describedby="chat-model-hint" data-testid="chat-model-select" @bind="_selectedModel" @onfocus="RefreshModelsAsync">
                    <option value="">@(_models.Count == 0 ? "No Ready models" : "Choose a model")</option>
                    <optgroup label="Ready" data-testid="chat-ready-models">
                        @foreach (var model in _ready)
                        {
                            <option value="@model.ServedName" data-testid="@($"chat-pick-{model.ModelId}")">@model.ServedName — @model.Where</option>
                        }
                    </optgroup>
                    @if (_notReady.Count > 0)
                    {
                        <optgroup label="Not Ready, can't be chosen">
                            @foreach (var model in _notReady)
                            {
                                <option value="@model.ServedName" disabled>@model.ServedName — @model.Where · @ModelPlaces.StateWord(model.State)</option>
                            }
                        </optgroup>
                    }
                </select>
                <span id="chat-model-hint" class="field-hint" data-testid="chat-model-hint">
                    @if (SelectedPlace is { } place)
                    {
                        <span data-testid="chat-model-where">Served on <strong>@place.NodeName</strong>@(place.RuntimeName is { } runtime ? $" by {runtime}" : "").</span>
                        @(" ")
                    }
                    @if (_notReady.Count > 0)
                    {
                        <span>
                            Only Ready models can be chosen; @(_notReady.Count == 1 ? "1 other model is" : $"{_notReady.Count} other models are") not Ready.
                            <a href="models">Start @(_notReady.Count == 1 ? "it" : "them") on Models</a>.
                        </span>
                    }
                    else if (_ready.Count > 0)
                    {
                        <span>Only Ready models can be chosen.</span>
                    }
                </span>
            </div>
            <span class="chat-live-rate num" data-testid="chat-live-rate"><b>@UiFormat.Number(SelectedPlace is { } ratePlace ? _live?.Current?.LatestKpis.GetValueOrDefault(ratePlace.ModelId)?.Load.GenerationTokensPerSecond : null)</b> tok/s</span>
        </div>
        @* role=log announces what is added to it, politely. A reply is added while it streams, so the in-flight
           message opts out (aria-live=off) and the finished reply is announced once, in full, through the
           separate status region below the log. *@
        <div id="chat-conversation" class="chat-conversation" role="log" aria-live="polite" aria-relevant="additions"
             aria-label="Conversation" tabindex="0" data-testid="chat-conversation">
            @for (var i = 0; i < _messages.Count; i++)
            {
                var message = _messages[i];
                var isUser = message.Role == "user";
                <div class="msg @(isUser ? "msg--user" : "msg--assistant")" data-testid="chat-message-@message.Role"
                     aria-live="@(isUser ? null : "off")" aria-busy="@(message.IsStreaming ? "true" : null)">
                    <span class="msg-role">@(isUser ? "You" : message.Model ?? "Assistant")</span>
                    @if (message.Images.Count > 0)
                    {
                        <div class="chat-thumbs" data-testid="chat-message-images">
                            @foreach (var image in message.Images)
                            {
                                <img class="chat-thumb" src="@image" alt="Attached image" />
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(message.Reasoning))
                    {
                        <details class="msg-reasoning" open="@(!message.ReasoningCollapsed)" data-testid="chat-reasoning">
                            <summary>Reasoning</summary>
                            <div>@message.Reasoning</div>
                        </details>
                    }
                    <div class="msg-text">
                        @foreach (var segment in ChatContentSplitter.Split(message.Content))
                        {
                            if (segment.IsCode)
                            {
                                <pre class="chat-code"><code>@segment.Text</code></pre>
                            }
                            else
                            {
                                <span>@segment.Text</span>
                            }
                        }
                    </div>
                    @if (message.Role == "assistant")
                    {
                        <div class="msg-stats num" data-testid="chat-stats-@i">@StatsLine(message)</div>
                    }
                    @if (message.Error is not null)
                    {
                        <div class="msg-error" data-testid="chat-message-error"><Icon Name="state-failed" /> <span>@message.Error</span></div>
                    }
                </div>
            }
            @if (_messages.Count == 0)
            {
                @if (_models.Count == 0)
                {
                    <EmptyState Title="No model is Ready" HeadingLevel="3" Inline="true" TestId="chat-empty">
                        <ChildContent>
                            <p>The Playground sends messages to a Ready model through the router. Start a model on Models; loading takes a few minutes, and it appears in the model picker once it is Ready.</p>
                        </ChildContent>
                        <Actions><a class="btn btn-outline-secondary" href="models">Go to Models</a></Actions>
                    </EmptyState>
                }
                else
                {
                    <div class="chat-intro" data-testid="chat-empty">
                        <h3 class="chat-intro-title">Check a model before you hand it out</h3>
                        <p class="chat-intro-text">
                            Messages go to the chosen model through the router, exactly as an API client's would. Use it to see that a model answers,
                            to compare speed (time to first token and tokens per second under each reply) or to try a system prompt.
                        </p>
                        <div class="chat-intro-block">
                            <span class="panel-label">A first prompt</span>
                            <button type="button" class="btn btn-outline-secondary chat-suggestion" data-testid="chat-suggestion" @onclick="UseSuggestion">
                                <Icon Name="edit" /> <span>@SuggestedPrompt</span>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-testid="chat-announcer">@_announcement</div>

        <div class="chat-composer-wrap">
            @if (_error is not null)
            {
                <div class="callout callout--failed" role="alert" data-testid="chat-error"><Icon Name="state-failed" /><div class="callout-body">@_error</div></div>
            }
            @if (_attachments.Count > 0)
            {
                <ul class="chat-attachments" aria-label="Images to send" data-testid="chat-attachments">
                    @foreach (var attachment in _attachments)
                    {
                        <li>
                            <img class="chat-thumb" src="@attachment.DataUrl" alt="@attachment.Name" />
                            <button type="button" class="icon-btn chat-attachment-remove" aria-label="@($"Remove {attachment.Name}")"
                                    data-testid="chat-attachment-remove" @onclick="() => _attachments.Remove(attachment)"><Icon Name="close" /></button>
                        </li>
                    }
                </ul>
            }
            <div class="chat-composer">
                @if (SelectedPlace?.AcceptsImages == true)
                {
                    <label class="btn btn-outline-secondary chat-attach" title="Attach images (up to @MaxImages, @(MaxImageBytes / 1024 / 1024) MB each)">
                        <Icon Name="upload" /> <span>Image</span>
                        <InputFile class="visually-hidden" accept="image/png,image/jpeg,image/webp,image/gif" multiple
                                   OnChange="AttachAsync" data-testid="chat-attach" />
                    </label>
                }
                <label for="chat-input" class="visually-hidden">Message</label>
                <textarea id="chat-input" class="form-control" rows="2" placeholder="@(string.IsNullOrEmpty(_selectedModel) ? "Message" : $"Message {_selectedModel}")"
                          aria-describedby="chat-hint" data-testid="chat-input" @bind="_input" @bind:event="oninput"></textarea>
                @if (_sending)
                {
                    <button type="button" class="btn btn-danger-fill" data-testid="chat-stop" @onclick="Stop"><Icon Name="stop" /> Stop</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" data-testid="chat-send" disabled="@(!CanSend)"
                            aria-describedby="@(SendBlockedReason is null ? null : "chat-send-reason")" @onclick="SendAsync"><Icon Name="send" /> Send</button>
                }
            </div>
            <p class="chat-hint" id="chat-hint">
                @if (!_sending && SendBlockedReason is { } reason)
                {
                    <span class="chat-send-reason" id="chat-send-reason" data-testid="chat-send-reason">@reason</span>
                }
                <span>Enter sends. Shift+Enter adds a new line.@(SelectedPlace?.AcceptsImages == true ? $" This model reads images: attach up to {MaxImages}." : "")</span>
            </p>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private sealed class ChatMessageVm
    {
        public required string Role { get; init; }

        public string? Model { get; init; }

        public string Content { get; set; } = "";

        public string? Reasoning { get; set; }

        public bool ReasoningCollapsed { get; set; }

        public bool IsStreaming { get; set; }

        public string? Error { get; set; }

        public string? FinishReason { get; set; }

        public int? PromptTokens { get; set; }

        public int? CompletionTokens { get; set; }

        public TimeSpan? TimeToFirstToken { get; set; }

        public double? OutputTokensPerSecond { get; set; }

        public IReadOnlyList<string> Images { get; init; } = [];
    }

    private sealed record Attachment(string Name, string DataUrl);

    private const int MaxImages = 4;
    private const long MaxImageBytes = 8 * 1024 * 1024;
    private readonly List<Attachment> _attachments = [];

    private LiveDataService? _live;
    private IDisposable? _liveSubscription;
    private List<string> _models = [];
    private List<ModelPlace> _ready = [];
    private List<ModelPlace> _notReady = [];

    /// <summary>The prompt the empty conversation suggests: short, answerable by any chat model, and it shows the speed.</summary>
    public const string SuggestedPrompt = "In three sentences, say which model you are and what you are good at.";

    private ModelPlace? SelectedPlace => _ready.FirstOrDefault(p => string.Equals(p.ServedName, _selectedModel, StringComparison.OrdinalIgnoreCase));

    /// <summary>Why Send is disabled at rest, in words; null when a message can be sent.</summary>
    private string? SendBlockedReason =>
        _sending ? null
        : _models.Count == 0 ? "Send needs a Ready model; none is Ready."
        : string.IsNullOrEmpty(_selectedModel) ? "Choose a model to send."
        : _attachments.Count > 0 && SelectedPlace?.AcceptsImages != true ? "This model doesn't read images. Remove them, or choose a model tagged Vision."
        : string.IsNullOrWhiteSpace(_input) && _attachments.Count == 0 ? "Type a message to send."
        : null;

    private void UseSuggestion() => _input = SuggestedPrompt;
    private string? _selectedModel;
    private double _temperature = 0.7;
    private int _maxTokens = 1024;
    private bool _thinkingEnabled;
    private bool _settingsOpen;
    private string _systemPrompt = "";
    private string _input = "";
    private bool _sending;
    private string? _error;
    private readonly List<ChatMessageVm> _messages = [];
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Chat>? _selfRef;

    private string? _announcement;

    /// <summary>The settings after the model name; kept whole on phones while only the model name truncates.</summary>
    private string SettingsRest =>
        $"· temp {_temperature.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)} · {_maxTokens} tokens{(_thinkingEnabled ? " · thinking" : "")}";

    private bool CanSend => SendBlockedReason is null && !_sending;

    private async Task AttachAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (_attachments.Count >= MaxImages)
            {
                _error = $"A message takes up to {MaxImages} images.";
                break;
            }

            if (!file.ContentType.StartsWith("image/", StringComparison.Ordinal) || file.Size > MaxImageBytes)
            {
                _error = $"{file.Name} wasn't attached: only images up to {MaxImageBytes / 1024 / 1024} MB can be sent.";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxImageBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            _attachments.Add(new Attachment(file.Name, $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}"));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshModelsAsync();
        _live = ServiceProvider.GetService<LiveDataService>();
        _liveSubscription = _live?.Subscribe(LiveNeeds.None, _ => InvokeAsync(StateHasChanged));

        // Prerender has the HttpContext; the interactive render reads the same query from the URL.
        var queryModel = HttpContext?.Request.Query["model"].FirstOrDefault()
            ?? Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).GetValueOrDefault("model").FirstOrDefault();
        if (!string.IsNullOrEmpty(queryModel))
        {
            var match = _models.FirstOrDefault(m => string.Equals(m, queryModel, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                _selectedModel = match;
            }
        }

        _selectedModel ??= _models.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./interop.js");
            _selfRef = DotNetObjectReference.Create(this);
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("bindEnterToSend", "chat-input", _selfRef, nameof(SendFromJsAsync));
            }
        }
    }

    /// <summary>Enter in the message field. <paramref name="text"/> is the field's current value, which the
    /// server may not have seen yet when Enter beats the last input event.</summary>
    [JSInvokable]
    public Task SendFromJsAsync(string? text)
    {
        if (text is not null)
        {
            _input = text;
        }

        return SendAsync();
    }

    private async Task RefreshModelsAsync()
    {
        var places = await ModelPlaces.LoadAsync(ServiceProvider, EndpointResolver);
        _ready = places.Where(p => p.IsReady).ToList();
        _notReady = places.Where(p => !p.IsReady).ToList();
        _models = _ready.Select(p => p.ServedName).ToList();

        if (_selectedModel is not null && !_models.Contains(_selectedModel, StringComparer.OrdinalIgnoreCase))
        {
            _selectedModel = _models.FirstOrDefault();
        }
    }

    private void NewChat()
    {
        _cts?.Cancel();
        _messages.Clear();
        _attachments.Clear();
        _error = null;
        _announcement = null;
    }

    private void Stop() => _cts?.Cancel();

    private async Task SendAsync()
    {
        if (!CanSend || _selectedModel is null)
        {
            return;
        }

        _error = null;
        _announcement = null;
        var userMessage = new ChatMessageVm { Role = "user", Content = _input.Trim(), Images = [.. _attachments.Select(a => a.DataUrl)] };
        _messages.Add(userMessage);
        _input = "";
        _attachments.Clear();

        // At this point _messages ends with userMessage and the assistant reply has not been added yet.
        var history = _messages.Select(m => new ChatMessage(m.Role, m.Content, m.Images.Count == 0 ? null : m.Images)).ToList();
        if (!string.IsNullOrWhiteSpace(_systemPrompt))
        {
            history.Insert(0, new ChatMessage("system", _systemPrompt));
        }

        var assistantMessage = new ChatMessageVm { Role = "assistant", Model = _selectedModel, IsStreaming = true };
        _messages.Add(assistantMessage);

        _cts = new CancellationTokenSource();
        _sending = true;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();

        var request = new ChatRequest(_selectedModel, history, _temperature, _maxTokens, _thinkingEnabled);
        var stopwatch = Stopwatch.StartNew();
        var lastRender = Stopwatch.StartNew();
        TimeSpan? firstTokenAt = null;

        try
        {
            await foreach (var chunk in ChatClient.StreamAsync(request, _cts.Token))
            {
                if (chunk.Content is not null)
                {
                    firstTokenAt ??= stopwatch.Elapsed;
                    assistantMessage.TimeToFirstToken ??= firstTokenAt;
                    assistantMessage.ReasoningCollapsed = true;
                    assistantMessage.Content += chunk.Content;
                }

                if (chunk.Reasoning is not null)
                {
                    assistantMessage.Reasoning = (assistantMessage.Reasoning ?? "") + chunk.Reasoning;
                }

                if (chunk.FinishReason is not null)
                {
                    assistantMessage.FinishReason = chunk.FinishReason;
                }

                if (chunk.Usage is not null)
                {
                    assistantMessage.PromptTokens = chunk.Usage.PromptTokens;
                    assistantMessage.CompletionTokens = chunk.Usage.CompletionTokens;
                }

                if (lastRender.ElapsedMilliseconds >= 50)
                {
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottomAsync();
                    lastRender.Restart();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped by the user.
        }
        catch (Exception ex)
        {
            assistantMessage.Error = ex.Message;
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            if (assistantMessage.CompletionTokens is int completion && firstTokenAt is TimeSpan ft)
            {
                var generationSeconds = (stopwatch.Elapsed - ft).TotalSeconds;
                if (generationSeconds > 0)
                {
                    assistantMessage.OutputTokensPerSecond = completion / generationSeconds;
                }
            }

            _sending = false;
            _cts?.Dispose();
            _cts = null;
            _announcement = Announcement(assistantMessage);
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("scrollToBottom", "chat-conversation");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone (navigated away / disposed); nothing to scroll.
        }
    }

    /// <summary>What screen readers hear once a reply is complete: the model and the whole reply, or the error.</summary>
    private static string Announcement(ChatMessageVm message) =>
        message.Error is not null
            ? $"{message.Model ?? "The model"} failed: {message.Error}"
            : message.Content.Length == 0
                ? $"{message.Model ?? "The model"} stopped without a reply."
                : $"{message.Model ?? "Assistant"} replied: {message.Content}";

    private static string StatsLine(ChatMessageVm message)
    {
        if (message.IsStreaming && message.Content.Length == 0 && string.IsNullOrEmpty(message.Reasoning) && message.Error is null)
        {
            return "…";
        }

        var ttft = message.TimeToFirstToken is TimeSpan t ? $"TTFT {t.TotalMilliseconds:0} ms" : "TTFT —";
        var tps = message.OutputTokensPerSecond is double d ? $"{d:0.#} tok/s" : "— tok/s";
        var prompt = message.PromptTokens?.ToString() ?? "—";
        var completion = message.CompletionTokens?.ToString() ?? "—";
        var finish = message.FinishReason ?? (message.IsStreaming ? "…" : "—");
        return $"{ttft} · {tps} · prompt {prompt} / completion {completion} tok · finish: {finish}";
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _selfRef?.Dispose();
        _liveSubscription?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected when the circuit is already gone.
            }
        }
    }
}
