@namespace MirbadLLM.Web.Components.Widgets
@using MirbadLLM.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@* The Overview's node scope rail: "All nodes", then one card per node (memory ring, state as icon + word, the GPU line
   and a bead per placed model). Cards are toggle buttons: pressing one scopes the page to that node, pressing the
   pressed one goes back to every node. The rail scrolls sideways with scroll snap at any fleet size; the dots under it
   (one per screenful, built and kept in step by js/overview.js in the browser) show where you are and jump on click. *@
<nav class="scope" aria-label="Node scope" data-testid="monitoring-node-selector">
    <div class="scope-cap">
        <span>Scope</span>
        <span class="num" data-testid="node-rail-online">@Online</span>
    </div>
    <div class="scope-track" @ref="_track" data-testid="scope-track">
        <button type="button" class="nd-all" aria-pressed="@(AllSelected ? "true" : "false")" data-testid="node-option-all"
                @onclick="() => Selected.InvokeAsync(AllScope)">
            <RingGauge Percent="AllMemoryPercent" Label="Fleet memory" ShowValue="true" Size="52" Stroke="4.2" TestId="node-option-all-memory" />
            <span class="nd-all-text">
                <span class="nd-all-name">All nodes</span>
                <span class="muted num">@Nodes.Count nodes · @RunningCount running</span>
                @if (AllMemoryText is { } memory)
                {
                    <span class="muted num">@memory</span>
                }
            </span>
        </button>
        @foreach (var (node, summary) in Nodes.Zip(Summaries))
        {
            <NodeCard @key="node.Id" Name="@node.Name" State="node.State" Draining="node.Draining" MemoryPercent="MemoryPercent(summary)"
                      MemoryTitle="@MemoryTitle(summary)" Meta="@NodeMeta(node, summary)" Beads="@(Beads.GetValueOrDefault(node.Id) ?? [])"
                      Pressed="@(!AllSelected && node.Id == SelectedId)" OnClick="() => Selected.InvokeAsync(node.Id)" TestId="@($"node-option-{node.Id}")" />
        }
    </div>
    <div class="scope-dots" @ref="_dots" role="group" aria-label="Node pages" data-testid="scope-dots"></div>
</nav>

@code {
    /// <summary>The scope value for every node at once.</summary>
    public const string AllScope = "all";

    [Parameter, EditorRequired]
    public IReadOnlyList<NodeSelector.Option> Nodes { get; set; } = [];

    /// <summary>Each node's readings in the window, in <see cref="Nodes"/> order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<NodeSummary> Summaries { get; set; } = [];

    /// <summary>The placed models per node id.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, List<NodeCard.Bead>> Beads { get; set; } = new Dictionary<string, List<NodeCard.Bead>>();

    [Parameter]
    public bool AllSelected { get; set; } = true;

    [Parameter]
    public string SelectedId { get; set; } = "";

    /// <summary>Models Ready on any node.</summary>
    [Parameter]
    public int RunningCount { get; set; }

    /// <summary>"5 min": the window the node lines describe.</summary>
    [Parameter]
    public string WindowLabel { get; set; } = "";

    /// <summary>Raised with a node id, or <see cref="AllScope"/>.</summary>
    [Parameter]
    public EventCallback<string> Selected { get; set; }

    private ElementReference _track;
    private ElementReference _dots;
    private IJSObjectReference? _module;
    private IJSObjectReference? _rail;
    private string? _revealed;
    private bool _disposed;

    private string Online
    {
        get
        {
            int online = Nodes.Count(n => n.State == NodeState.Online);
            int draining = Nodes.Count(n => n.Draining);
            return $"{online}/{Nodes.Count} online{(draining > 0 ? $" · {draining} draining" : "")}";
        }
    }

    private double? AllMemoryPercent
    {
        get
        {
            var known = Summaries.Where(s => s.UsedGiB is not null && s.TotalGiB is > 0).ToList();
            return known.Count == 0 ? null : known.Sum(s => s.UsedGiB!.Value) / known.Sum(s => s.TotalGiB!.Value) * 100;
        }
    }

    private string? AllMemoryText
    {
        get
        {
            var known = Summaries.Where(s => s.UsedGiB is not null && s.TotalGiB is > 0).ToList();
            return known.Count == 0 ? null : $"{UiFormat.Decimal1(known.Sum(s => s.UsedGiB!.Value))} of {UiFormat.GiB(known.Sum(s => s.TotalGiB!.Value))} used";
        }
    }

    public static double? MemoryPercent(NodeSummary summary) =>
        summary is { UsedGiB: double used, TotalGiB: double total } && total > 0 ? used / total * 100 : null;

    public static string? MemoryTitle(NodeSummary summary) =>
        summary.Samples == 0 ? null : $"{summary.MemoryLabel}: {UiFormat.Decimal1(summary.UsedGiB)} of {UiFormat.GiB(summary.TotalGiB)} used";

    private string NodeMeta(NodeSelector.Option node, NodeSummary summary)
    {
        if (node.Draining && node.State == NodeState.Online)
        {
            return "Draining · takes no new models";
        }

        if (summary.Samples == 0)
        {
            return $"No samples in the last {WindowLabel}";
        }

        string gpus = summary.Discrete && summary.GpuCount > 1 ? $"{summary.GpuCount} GPUs · " : "GPU ";
        return $"{gpus}{Reading(summary.GpuUtilization, "%")} · {Reading(summary.TemperatureC, "°C")} · {Reading(summary.PowerWatts, " W")}";
    }

    private static string Reading(double? value, string unit) => UiFormat.HasValue(value) ? UiFormat.Whole(value) + unit : UiFormat.Missing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (_rail is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/overview.js");
                _rail = _module is null ? null : await _module.InvokeAsync<IJSObjectReference>("rail", _track, _dots);
            }

            // Bring the pressed card into view once per selection (a deep link to a node far down the rail).
            string selection = AllSelected ? AllScope : SelectedId;
            if (_rail is not null && selection != _revealed)
            {
                _revealed = selection;
                await _rail.InvokeVoidAsync("reveal");
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Prerendering or a dropped circuit: the rail still scrolls; only the dots wait for the script.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_rail is not null)
            {
                await _rail.InvokeVoidAsync("dispose");
                await _rail.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // The circuit is gone.
        }
    }
}
