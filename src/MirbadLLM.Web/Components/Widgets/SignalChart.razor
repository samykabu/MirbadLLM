@namespace MirbadLLM.Web.Components.Widgets
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS
@* The Overview's Signal chart: generation tok/s per model stacked over the window, and under it a GPU-utilization heat
   strip, one row per node (per GPU on a discrete node). Drawn by js/overview.js in WebGL (a Canvas2D fallback draws the
   same picture); the page pushes the series on every refresh, never per frame. The canvas is decoration for sighted
   readers: the legend, the axis labels and the visually hidden table carry the same numbers as text. *@
<div class="signal" data-testid="signal">
    @if (!HasData)
    {
        <p class="signal-empty muted" role="status" data-testid="signal-empty">@EmptyText</p>
    }
    else
    {
        <ul class="signal-legend" data-testid="signal-legend" aria-label="Models in the chart">
            @foreach (var series in Data.Models)
            {
                <li><span class="signal-swatch" style="@($"background:{series.Color}")" aria-hidden="true"></span>@series.Name</li>
            }
            @if (Data.Heat.Count > 0)
            {
                <li class="signal-legend-heat"><span class="signal-heat-key" aria-hidden="true"></span>GPU use, 0–100%</li>
            }
        </ul>
        <div class="signal-plot" style="@($"height:{F(Height)}px")">
            <canvas @ref="_canvas" class="signal-canvas" aria-hidden="true" data-testid="signal-canvas"></canvas>
            @if (Data.Models.Count > 0)
            {
                <span class="signal-axis signal-axis--max num" style="top:4px" data-testid="signal-max">@UiFormat.Number(Data.Max) tok/s</span>
                <span class="signal-axis num" style="@($"top:calc({F(Data.Area * 100)}% - 18px)")">0</span>
            }
            @if (Data.Heat.Count > 0)
            {
                <div class="signal-rows" style="@($"top:{F((Data.Area + Data.Gap) * 100)}%")" aria-hidden="true">
                    @foreach (var row in Data.Heat)
                    {
                        <span class="signal-row-label">@row.Label</span>
                    }
                </div>
            }
        </div>
        <div class="signal-time muted num" aria-hidden="true"><span>−@WindowLabel</span><span>@EndLabel</span></div>
        <table class="visually-hidden" data-testid="signal-table">
            <caption>@Caption</caption>
            <thead><tr><th scope="col">Series</th><th scope="col">Now</th><th scope="col">Average</th><th scope="col">Peak</th></tr></thead>
            <tbody>
                @foreach (var series in Data.Models)
                {
                    <tr><th scope="row">@series.Name, tok/s</th><td>@Last(series.Values)</td><td>@Average(series.Values)</td><td>@Peak(series.Values)</td></tr>
                }
                @foreach (var row in Data.Heat)
                {
                    <tr><th scope="row">@row.Label, GPU %</th><td>@Last(row.Values)</td><td>@Average(row.Values)</td><td>@Peak(row.Values)</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>The chart's data, as the script reads it (camelCase through JS interop).</summary>
    /// <param name="Columns">Time buckets across the window, oldest first.</param>
    /// <param name="Max">The stacked area's top, tok/s (a round number above the highest total).</param>
    /// <param name="Area">Share of the height the stacked area takes (from the top).</param>
    /// <param name="Gap">Share of the height between the area and the heat strip.</param>
    public sealed record Payload(int Columns, double Max, double Area, double Gap, IReadOnlyList<Series> Models, IReadOnlyList<HeatRow> Heat);

    /// <summary>One model's generation tok/s per column; null is a gap (not Ready, or the first sample after a start).</summary>
    public sealed record Series(string Name, string Color, IReadOnlyList<double?> Values);

    /// <summary>One node's (or GPU's) utilization in percent per column; null is no reading.</summary>
    public sealed record HeatRow(string Label, IReadOnlyList<double?> Values);

    /// <summary>Pixels for the stacked area; each heat row adds <see cref="RowHeight"/>.</summary>
    public const double AreaHeight = 220;

    public const double GapHeight = 12;

    public const double RowHeight = 22;

    [Parameter, EditorRequired]
    public Payload Data { get; set; } = Empty(2);

    /// <summary>"15 min".</summary>
    [Parameter]
    public string WindowLabel { get; set; } = "";

    [Parameter]
    public string EmptyText { get; set; } = "No samples in the window yet";

    /// <summary>What the right edge is: "now", or the time of the newest sample when the sampler fell behind.</summary>
    [Parameter]
    public string EndLabel { get; set; } = "now";

    /// <summary>Builds the payload's layout from the series (heights, the round top).</summary>
    public static Payload Build(int columns, IReadOnlyList<Series> models, IReadOnlyList<HeatRow> heat)
    {
        ArgumentNullException.ThrowIfNull(models);
        ArgumentNullException.ThrowIfNull(heat);
        double total = 0;
        for (int c = 0; c < columns; c++)
        {
            total = Math.Max(total, models.Sum(m => c < m.Values.Count && m.Values[c] is double v && double.IsFinite(v) ? Math.Max(0, v) : 0));
        }

        double height = AreaHeight + (heat.Count > 0 ? GapHeight + (heat.Count * RowHeight) : 0);
        return new Payload(Math.Max(2, columns), NiceCeiling(total), AreaHeight / height, heat.Count > 0 ? GapHeight / height : 0, models, heat);
    }

    /// <summary>The smallest 1, 2 or 5 × 10ⁿ at or above <paramref name="value"/> (10 for nothing), so the axis reads cleanly.</summary>
    public static double NiceCeiling(double value)
    {
        if (!(value > 0) || !double.IsFinite(value))
        {
            return 10;
        }

        double power = Math.Pow(10, Math.Floor(Math.Log10(value)));
        foreach (double step in new[] { 1, 2, 5, 10 })
        {
            if (step * power >= value)
            {
                return step * power;
            }
        }

        return 10 * power;
    }

    public static Payload Empty(int columns) => new(Math.Max(2, columns), 10, 1, 0, [], []);

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _chart;
    private Payload? _pushed;
    private bool _disposed;

    private bool HasData => Data.Models.Count > 0 || Data.Heat.Count > 0;

    private double Height => AreaHeight + (Data.Heat.Count > 0 ? GapHeight + (Data.Heat.Count * RowHeight) : 0);

    private string Caption => $"Generation by model and GPU use, last {WindowLabel}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !HasData || ReferenceEquals(_pushed, Data))
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/overview.js");
            if (_module is null)
            {
                return;
            }

            _chart ??= await _module.InvokeAsync<IJSObjectReference>("signal", _canvas);
            if (_chart is not null)
            {
                await _chart.InvokeVoidAsync("update", _canvas, Data);
                _pushed = Data;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Prerendering, a dropped circuit or a browser without the module: the text table still has the numbers.
        }
    }

    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Last(IReadOnlyList<double?> values) => UiFormat.Number(values.LastOrDefault(v => UiFormat.HasValue(v)));

    private static string Average(IReadOnlyList<double?> values)
    {
        var known = values.Where(UiFormat.HasValue).Select(v => v!.Value).ToList();
        return UiFormat.Number(known.Count == 0 ? null : known.Average());
    }

    private static string Peak(IReadOnlyList<double?> values)
    {
        var known = values.Where(UiFormat.HasValue).Select(v => v!.Value).ToList();
        return UiFormat.Number(known.Count == 0 ? null : known.Max());
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_chart is not null)
            {
                await _chart.InvokeVoidAsync("dispose");
                await _chart.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // The circuit is gone; the browser releases the context with the page.
        }
    }
}
