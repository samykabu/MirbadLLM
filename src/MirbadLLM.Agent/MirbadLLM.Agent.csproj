<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- mirbadllm-agent (design §2.5, §4): the node agent host. Composition comes in MN-026. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mirbadllm-agent</AssemblyName>
    <RootNamespace>MirbadLLM.Agent</RootNamespace>
    <!-- LibraryImport (directory fsync after renames, Operations/DirectorySync.cs) generates unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MirbadLLM.Core\MirbadLLM.Core.csproj" />
    <ProjectReference Include="..\MirbadLLM.Agent.Contracts\MirbadLLM.Agent.Contracts.csproj" />
    <ProjectReference Include="..\MirbadLLM.Pki\MirbadLLM.Pki.csproj" />
    <ProjectReference Include="..\MirbadLLM.NodeRuntime\MirbadLLM.NodeRuntime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SCM hosting and the Event Log (owner decision O1, D107; MN-215): a no-op outside the Service Control Manager. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MirbadLLM.UnitTests" />
  </ItemGroup>
</Project>
