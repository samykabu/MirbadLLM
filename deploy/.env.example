# Copy to deploy/.env on the host and adjust. docs/configuration.md describes every variable.
DOCKER_GID=988
MIRBADLLM_PORT=8080
MIRBADLLM_DATA=/srv/mirbadllm/data
MIRBADLLM_MODELS=/srv/mirbadllm/models
MIRBADLLM_CACHE=/srv/mirbadllm/cache
MIRBADLLM_MEMORY_RESERVE_GIB=8
# Leave empty for no auth on /v1/*.
MIRBADLLM_API_KEY=
# Admin password for the UI and /api. Empty disables login.
MIRBADLLM_ADMIN_PASSWORD=
# true = /v1 requires an API key even before the first key is created.
MIRBADLLM_REQUIRE_API_KEY=false
# Scheduled backups land here (mounted at /backups; owned by uid 1654). Point it at a NAS mount to survive a reinstall.
MIRBADLLM_BACKUPS=/srv/mirbadllm/backups
# Encrypts the API keys inside scheduled backups (AES-256-GCM). Empty = scheduled backups carry no API keys.
# Keep a copy somewhere other than the DGX: a restore needs it.
MIRBADLLM_BACKUP_PASSPHRASE=
# Name used in backup file names (the container's own hostname is a random id).
MIRBADLLM_BACKUP_HOSTNAME=dgx-spark

# ---- Master + agent (deploy/compose.multinode.yaml) ----
# The cache bind source the DGX agent mounts at /cache (today's CacheHostPath).
MIRBADLLM_CACHE=/srv/mirbadllm/cache
# vLLM image of models without their own image; the agent's Hugging Face download helper uses the same image.
# Set it to a vLLM image this machine has: the built-in default is a locally built image name that exists only on the
# machine it was built on.
#MIRBADLLM_VLLM_IMAGE=
# Image tags are set by deploy/ci-deploy-multinode.sh (mirbadllm/controller:<sha12>, mirbadllm/agent:<sha12>).
#MIRBADLLM_IMAGE=
#MIRBADLLM_AGENT_IMAGE=

# The id of this machine's own node, shown on the Nodes page: lower-case letters, digits and "-". Set it before the
# first start; changing it later makes a different node. Unset = dgx.
#MIRBADLLM_NODE_ID=
# How the bundled agent counts memory. Unset = it looks at the GPUs: per-GPU budgets when a card has its own VRAM, one
# pool otherwise. Unified pins one pool whatever nvidia-smi reports (a DGX Spark); Discrete pins per-GPU budgets.
#MIRBADLLM_MEMORY_MODEL=

# ---- Published images (deploy/compose.release.yaml) ----
# The release to run, the tag without its "v": 1.2.0, or 1.2 for the newest 1.2.x. Unset = latest, the newest release.
#MIRBADLLM_VERSION=
